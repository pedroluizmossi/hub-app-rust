// Janela do hub. A moldura é neutra (cores e controles do sistema, claro ou escuro);
// cada mini-app aparece num painel com o próprio tema.
import { ScrollView, Switch, SpinBox, ComboBox, Palette } from "std-widgets.slint";
import { Theme, Anim } from "theme.slint";
import { DockerView, DockerApp, ContainerRow } from "../miniapps/docker/view.slint";
import { VitalsView, VitalsApp, VitalCard } from "../miniapps/vitals/view.slint";

export { Theme, Anim, DockerApp, ContainerRow, VitalsApp, VitalCard }

// Uma configuração declarada no manifesto de um app.
export struct SettingRow {
    app: string,
    key: string,
    label: string,
    kind: string,        // "bool" | "int" | "choice"
    bool-value: bool,
    int-value: int,
    minimum: int,
    maximum: int,
    step: int,
    options: [string],   // rótulos de um choice
    index: int,          // opção escolhida
}

export struct AppInfo {
    id: string,
    name: string,
    description: string,
    icon: image,
    enabled: bool,
    mood: string,
    settings: [SettingRow],
}

// Cores fixas de estado na moldura (o tema de cada app só vale dentro do painel dele).
global Status {
    out property <color> alarm: #e5484d;
    out property <color> busy: #f5a524;
}

component ShellButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: label.preferred-width + 18px;
    height: 26px;
    border-radius: 5px;
    background: touch.pressed ? Palette.selection-background : touch.has-hover ? Palette.alternate-background : transparent;
    label := Text {
        text: root.text;
        color: Palette.foreground;
        font-size: 12px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> mood;
    in property <bool> selected;
    callback clicked;
    height: 34px;
    min-width: row.preferred-width + 16px;
    border-radius: 6px;
    background: selected ? Palette.alternate-background : touch.has-hover ? Palette.alternate-background.with-alpha(0.5) : transparent;

    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: center;
        if icon.width > 0: Image {
            source: icon;
            image-rendering: pixelated;
            width: 22px;
            height: 19px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: label;
            color: Palette.foreground;
            opacity: selected ? 1 : 0.7;
            font-size: 13px;
            font-weight: selected ? 600 : 400;
            vertical-alignment: center;
        }
        if mood == "alarm" || mood == "busy": Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: mood == "alarm" ? Status.alarm : Status.busy;
        }
    }
    // marca da aba ativa
    if selected: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: parent.width - 16px;
        x: 8px;
        border-radius: 1px;
        background: Palette.accent-background;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingLine inherits HorizontalLayout {
    in property <SettingRow> s;
    callback toggled;
    callback int-edited(int);
    callback chosen(int);
    spacing: 10px;
    min-height: 32px;

    Text {
        text: s.label;
        color: Palette.foreground;
        font-size: 12px;
        horizontal-stretch: 1;
        vertical-alignment: center;
        overflow: elide;
    }
    if s.kind == "bool": Switch {
        checked: s.bool-value;
        toggled => { root.toggled(); }
    }
    if s.kind == "int": SpinBox {
        width: 120px;
        minimum: s.minimum;
        maximum: s.maximum;
        step-size: s.step;
        value: s.int-value;
        edited(v) => { root.int-edited(v); }
    }
    if s.kind == "choice": ComboBox {
        width: 220px;
        model: s.options;
        current-index: s.index;
        selected => { root.chosen(self.current-index); }
    }
}

component AppsView inherits ScrollView {
    in property <[AppInfo]> apps;
    callback toggle-app(string);
    callback setting-toggled(string, string);
    callback setting-int(string, string, int);
    callback setting-chosen(string, string, int);

    VerticalLayout {
        spacing: 10px;
        padding-right: 12px;

        for app in apps: Rectangle {
            border-radius: 8px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 12px;
                    Image {
                        source: app.icon;
                        image-rendering: pixelated;
                        width: 40px;
                        height: 35px;
                        opacity: app.enabled ? 1 : 0.45;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: app.name; color: Palette.foreground; font-size: 14px; font-weight: 600; }
                        Text { text: app.description; color: Palette.foreground; opacity: 0.7; font-size: 11px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked: app.enabled;
                            toggled => { root.toggle-app(app.id); }
                        }
                    }
                }
                if app.enabled: VerticalLayout {
                    padding-left: 52px;
                    spacing: 2px;
                    for s in app.settings: SettingLine {
                        s: s;
                        toggled => { root.setting-toggled(s.app, s.key); }
                        int-edited(v) => { root.setting-int(s.app, s.key, v); }
                        chosen(i) => { root.setting-chosen(s.app, s.key, i); }
                    }
                }
            }
        }

        Text {
            text: "Mascotes e temas do CyberDock · Interface feita com Slint (slint.dev)";
            color: Palette.foreground;
            opacity: 0.5;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
}

// Painel com o tema do mini-app.
component ThemedPanel inherits Rectangle {
    border-radius: 10px;
    clip: true;
    background: @linear-gradient(180deg, Theme.bg0 0%, Theme.bg1 100%);
    VerticalLayout {
        padding: 12px;
        @children
    }
}

export component HubWindow inherits Window {
    title: "CyberHub";
    preferred-width: 820px;
    preferred-height: 600px;
    min-width: 640px;
    min-height: 460px;
    // popup de bandeja: sem moldura e por cima das outras janelas
    no-frame: true;
    always-on-top: true;
    background: Palette.background;
    default-font-size: 13px;

    in property <[AppInfo]> tabs;          // apps ligados, na ordem das abas
    in property <[AppInfo]> apps;          // todos os apps (aba Apps)
    in-out property <string> current: "apps";
    in property <string> summary;

    callback select-tab(string);
    callback toggle-app(string);
    callback setting-toggled(string, string);
    callback setting-int(string, string, int);
    callback setting-chosen(string, string, int);
    callback hide-window();
    // vindo do ícone da bandeja: mostra/esconde a janela junto do ponto clicado (x, y)
    callback toggle-requested(int, int);
    callback quit();

    // borda (a janela não tem moldura)
    Rectangle {
        border-width: 1px;
        border-color: Palette.border;
    }

    // Esc fecha o popup
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.hide-window();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            // cabeçalho
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "CyberHub";
                        color: Palette.foreground;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: summary;
                        color: Palette.foreground;
                        opacity: 0.65;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 4px;
                        ShellButton { text: "Esconder"; clicked => { root.hide-window(); } }
                        ShellButton { text: "Sair"; clicked => { root.quit(); } }
                    }
                }
            }

            // abas
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                for t in tabs: Tab {
                    label: t.name;
                    icon: t.icon;
                    mood: t.mood;
                    selected: current == t.id;
                    clicked => { root.select-tab(t.id); }
                }
                Tab {
                    label: "⚙ Apps";
                    selected: current == "apps";
                    clicked => { root.select-tab("apps"); }
                }
            }

            // conteúdo: só o app da aba atual existe na árvore
            Rectangle {
                vertical-stretch: 1;
                if current == "cyber.docker": ThemedPanel { DockerView { } }
                if current == "cyber.vitals": ThemedPanel { VitalsView { } }
                if current == "apps": AppsView {
                    apps: apps;
                    toggle-app(id) => { root.toggle-app(id); }
                    setting-toggled(a, k) => { root.setting-toggled(a, k); }
                    setting-int(a, k, v) => { root.setting-int(a, k, v); }
                    setting-chosen(a, k, i) => { root.setting-chosen(a, k, i); }
                }
            }
        }
    }
}
