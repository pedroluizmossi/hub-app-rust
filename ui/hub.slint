// Janela do hub: moldura e cabeçalho no visual escolhido (ver Skin) e o painel com os
// mini-apps numa grade, cada um com o próprio tema. O botão de layout liga o modo de
// edição (arrastar pelo topo, puxar as bordas); a engrenagem abre as configurações.
import { ScrollView } from "std-widgets.slint";
import { Colors, Anim, Skin, Icons, Moods } from "theme.slint";
import { Icon, IconButton, TextButton, SqSwitch, Stepper, Select, HeaderButton } from "widgets.slint";
import { DockerView, DockerApp, ContainerRow } from "../miniapps/docker/view.slint";
import { VitalsView, VitalsApp, VitalCard } from "../miniapps/vitals/view.slint";
import { CdPlayerView, CdPlayerApp } from "../miniapps/cdplayer/view.slint";
import { AiUsageView, AiUsageApp, UsageCard, UsageLine } from "../miniapps/ai_usage/view.slint";
import { PortsView, PortsApp, PortRow } from "../miniapps/ports/view.slint";
import { TodoView, TodoApp, TodoRow } from "../miniapps/todo/view.slint";
import { Chatter, SpeechBox } from "chatter.slint";

import "fonts/ChakraPetch-Regular.ttf";
import "fonts/ChakraPetch-Medium.ttf";
import "fonts/ChakraPetch-SemiBold.ttf";
import "fonts/ChakraPetch-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/PixelifySans-Regular.ttf";
import "fonts/PixelifySans-Bold.ttf";

export { Colors, Anim, Skin, DockerApp, ContainerRow, VitalsApp, VitalCard, CdPlayerApp, AiUsageApp, UsageCard, UsageLine, PortsApp, PortRow, TodoApp, TodoRow, Chatter }

// Posição de um app na grade do painel (em células).
export struct GridCell {
    id: string,
    name: string,
    col: int,
    row: int,
    w: int,
    h: int,
    theme: Colors,   // tema do app (preenchido pelo Rust)
}

// Prévia de onde o app vai parar durante um arrasto no modo de edição.
export struct Ghost {
    visible: bool,
    id: string,
    col: int,
    row: int,
    w: int,
    h: int,
    ok: bool,        // cabe (os outros acham lugar)
}

// Uma configuração declarada no manifesto de um app.
export struct SettingRow {
    app: string,
    key: string,
    label: string,
    unit: string,        // "%", "°C" ou vazio (tirado do fim do rótulo)
    kind: string,        // "bool" | "int" | "choice"
    bool-value: bool,
    int-value: int,
    minimum: int,
    maximum: int,
    step: int,
    options: [string],   // rótulos de um choice
    index: int,          // opção escolhida
}

export struct AppInfo {
    id: string,
    name: string,
    description: string,
    icon: image,
    enabled: bool,
    mood: string,
    theme: Colors,
    settings: [SettingRow],
    page: int,           // página onde o app está
}

// Uma página do painel (item da barra lateral).
export struct PageInfo {
    name: string,
    icon: image,         // mascote da página, no humor do pior app dela
    icon-index: int,     // mascote escolhida (índice na lista de mascotes)
    mood: string,        // pior humor dos apps ligados da página
    theme: Colors,       // tema usado no ícone (o do visual)
    apps: int,           // apps ligados na página
}

// ---- configurações ------------------------------------------------------------

component SettingLine inherits Rectangle {
    in property <SettingRow> s;
    in property <color> accent;
    callback toggled;
    callback int-edited(int);
    callback chosen(int);
    min-height: 44px;

    HorizontalLayout {
        spacing: 16px;
        Text {
            text: s.label;
            color: Skin.ink;
            font-size: 14px;
            horizontal-stretch: 1;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        VerticalLayout {
            alignment: center;
            if s.kind == "bool": SqSwitch {
                checked: s.bool-value;
                accent: accent;
                label: s.label;
                toggled => { root.toggled(); }
            }
            if s.kind == "int": Stepper {
                value: s.int-value;
                minimum: s.minimum;
                maximum: s.maximum;
                step: s.step;
                unit: s.unit;
                accent: accent;
                edited(v) => { root.int-edited(v); }
            }
            if s.kind == "choice": Select {
                width: 220px;
                options: s.options;
                index: s.index;
                accent: accent;
                label: s.label;
                chosen(i) => { root.chosen(i); }
            }
        }
    }
}

/// Uma preferência com título, explicação e um seletor à direita.
component ChoiceRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> hint;
    in property <[string]> options;
    in property <int> index;
    callback chosen(int);
    spacing: 16px;
    min-height: 44px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.title; color: Skin.ink; font-size: 14px; }
        Text { text: root.hint; color: Skin.sub; font-size: 12px; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        Select {
            width: 220px;
            options: root.options;
            index: root.index;
            accent: Skin.accent;
            label: root.title;
            chosen(i) => { root.chosen(i); }
        }
    }
}

component AppsView inherits ScrollView {
    in property <[AppInfo]> apps;
    in property <[string]> skins;          // visuais da janela (rótulos)
    in property <int> skin-index;
    callback skin-chosen(int);
    // ícone da bandeja: mascote e tema (índice 0 = automático)
    in property <[string]> tray-icons;
    in property <int> tray-icon-index;
    in property <[string]> tray-themes;
    in property <int> tray-theme-index;
    callback tray-icon-chosen(int);
    callback tray-theme-chosen(int);
    // onde ficam as páginas (0 = barra lateral, 1 = abas em cima)
    in property <int> nav-index;
    callback nav-chosen(int);
    // reduzir movimento (mascotes paradas, sem reações)
    in property <bool> reduce-motion;
    callback reduce-motion-toggled();
    // quanto as mascotes conversam (0 nunca, 1 às vezes, 2 bastante)
    in property <int> chatter-index;
    callback chatter-chosen(int);
    // páginas: lista, nomes (para o seletor de cada app) e mascotes disponíveis
    in property <[PageInfo]> pages;
    in property <[string]> page-names;
    in property <[string]> mascots;
    callback page-added();
    callback page-removed(int);
    callback page-renamed(int, string);
    callback page-icon-chosen(int, int);
    callback page-moved(int, int /* -1 sobe, +1 desce */);
    callback app-page-chosen(string, int);
    callback edit-layout();
    callback toggle-app(string);
    // app com as opções abertas (um por vez; fica aqui porque a lista é refeita pelo Rust)
    in-out property <string> open-app;
    callback setting-toggled(string, string);
    callback setting-int(string, string, int);
    callback setting-chosen(string, string, int);

    VerticalLayout {
        alignment: start;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 16px;
        spacing: 12px;

        // como arrumar o painel
        Rectangle {
            background: Skin.edit-bg;
            border-width: 1px;
            border-color: Skin.edit-line;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    Icon { icon: Icons.grid; ink: Skin.accent; size: 28px; weight: 1.8; }
                }
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text { text: "Painel"; color: Skin.ink; font-size: 17px; font-weight: 700; }
                    Text {
                        text: "A grade se arruma direto no painel: em Mudar layout, arraste os apps pelo topo e puxe as bordas para mudar o tamanho.";
                        color: Skin.edit-sub;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: "Mudar layout";
                        icon: Icons.grid;
                        ink: Skin.accent;
                        edge: Skin.edit-line;
                        font-size: 13px;
                        clicked => { root.edit-layout(); }
                    }
                }
            }
        }

        // visual da janela
        Rectangle {
            background: Skin.surface;
            border-width: 1px;
            border-color: Skin.surface-edge;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "Aparência"; color: Skin.ink; font-size: 17px; font-weight: 700; }
                ChoiceRow {
                    title: "Visual da janela";
                    hint: "Fundo, moldura, fontes e cores. Apps com o tema “Acompanha a janela” mudam junto.";
                    options: skins;
                    index: skin-index;
                    chosen(i) => { root.skin-chosen(i); }
                }
                ChoiceRow {
                    title: "Páginas";
                    hint: "Onde as páginas aparecem: numa barra à esquerda ou como abas no cabeçalho.";
                    options: ["Barra lateral", "Abas em cima"];
                    index: nav-index;
                    chosen(i) => { root.nav-chosen(i); }
                }
                HorizontalLayout {
                    spacing: 16px;
                    min-height: 44px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "Reduzir movimento"; color: Skin.ink; font-size: 14px; }
                        Text {
                            text: "Mascotes sem pulos nem tremores, e sem comemorações nem surpresas.";
                            color: Skin.sub;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        SqSwitch {
                            checked: reduce-motion;
                            label: "Reduzir movimento";
                            toggled => { root.reduce-motion-toggled(); }
                        }
                    }
                }
                ChoiceRow {
                    title: "Mascotes conversam";
                    hint: "As mascotes comentam o que acontece nos apps e, com tudo calmo, puxam papo. Clique numa mascote para ela falar.";
                    options: ["Nunca", "Às vezes", "Bastante"];
                    index: chatter-index;
                    chosen(i) => { root.chatter-chosen(i); }
                }
                ChoiceRow {
                    title: "Ícone da bandeja";
                    hint: "Mascote mostrada na bandeja. No automático, é a do app em pior estado.";
                    options: tray-icons;
                    index: tray-icon-index;
                    chosen(i) => { root.tray-icon-chosen(i); }
                }
                ChoiceRow {
                    title: "Cores do ícone";
                    hint: "Tema da mascote na bandeja. No automático, segue o tema do app mostrado.";
                    options: tray-themes;
                    index: tray-theme-index;
                    chosen(i) => { root.tray-theme-chosen(i); }
                }
            }
        }

        // páginas da barra lateral
        Rectangle {
            background: Skin.surface;
            border-width: 1px;
            border-color: Skin.surface-edge;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "Páginas"; color: Skin.ink; font-size: 17px; font-weight: 700; }
                        Text {
                            text: "Cada página tem a sua grade e aparece na barra de páginas. Para mudar um app de página, abra as opções dele abaixo.";
                            color: Skin.sub;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: "Nova página";
                            font-size: 13px;
                            clicked => { root.page-added(); }
                        }
                    }
                }
                for p[i] in pages: HorizontalLayout {
                    spacing: 10px;
                    min-height: 44px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 40px;
                            height: 35px;
                            background: p.theme.bg1;
                            Image { source: p.icon; image-rendering: pixelated; width: 32px; height: 28px; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Rectangle {
                            height: 34px;
                            border-width: 1px;
                            border-color: name.has-focus ? Skin.accent : Skin.field-edge;
                            background: Skin.field;
                            name := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                text: p.name;
                                color: Skin.ink;
                                font-size: 14px;
                                vertical-alignment: center;
                                single-line: true;
                                accessible-label: "Nome da página " + (i + 1);
                                accepted => { root.page-renamed(i, self.text); }
                                changed has-focus => {
                                    if !self.has-focus && self.text != p.name { root.page-renamed(i, self.text); }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Select {
                            width: 150px;
                            options: mascots;
                            index: p.icon-index;
                            accent: Skin.accent;
                            label: "Ícone da página " + p.name;
                            chosen(k) => { root.page-icon-chosen(i, k); }
                        }
                    }
                    IconButton {
                        width: 34px;
                        height: 34px;
                        icon: Icons.chevron-up;
                        enabled: i > 0;
                        label: "Subir " + p.name;
                        clicked => { root.page-moved(i, -1); }
                    }
                    IconButton {
                        width: 34px;
                        height: 34px;
                        icon: Icons.chevron;
                        enabled: i < pages.length - 1;
                        label: "Descer " + p.name;
                        clicked => { root.page-moved(i, 1); }
                    }
                    IconButton {
                        width: 34px;
                        height: 34px;
                        icon: Icons.close;
                        ink: Skin.danger;
                        enabled: pages.length > 1;
                        label: "Apagar " + p.name + " (os apps vão para a página anterior)";
                        clicked => { root.page-removed(i); }
                    }
                }
            }
        }

        for app in apps: Rectangle {
            property <color> accent: app.theme.fur;
            background: accent.mix(Skin.surface, 0.06);
            border-width: 1px;
            border-color: accent.mix(Skin.surface-edge, 0.3);
            opacity: app.enabled ? 1 : 0.55;
            property <bool> open: root.open-app == app.id;

            VerticalLayout {
                padding: 16px;
                spacing: 14px;
                // cabeçalho do app: clicar abre/fecha as opções (o interruptor tem o próprio clique)
                head := Rectangle {
                    min-height: head-row.preferred-height;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-app = open ? "" : app.id; }
                    }
                    head-row := HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            icon: open ? Icons.chevron : Icons.chevron-right;
                            ink: open ? accent : Skin.dim;
                            size: 16px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 43px;
                            background: app.theme.bg1;
                            Image {
                                source: app.icon;
                                image-rendering: pixelated;
                                width: 40px;
                                height: 35px;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: app.name; color: Skin.ink; font-size: 17px; font-weight: 700; }
                        Text { text: app.description; color: Skin.sub; font-size: 13px; wrap: word-wrap; }
                        if !open: Text {
                            text: app.settings.length + (app.settings.length == 1 ? " opção" : " opções") + " · clique para abrir";
                            color: Skin.dim;
                            font-family: Skin.font-mono;
                            font-size: 11px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        SqSwitch {
                            width: 48px;
                            height: 26px;
                            knob: 18px;
                            accent: accent;
                            checked: app.enabled;
                            label: "Ativar " + app.name;
                            toggled => { root.toggle-app(app.id); }
                        }
                    }
                    }
                }
                if open: Rectangle { height: 1px; background: Skin.surface-edge; }
                if open: VerticalLayout {
                    if page-names.length > 1: HorizontalLayout {
                        spacing: 16px;
                        min-height: 44px;
                        Text {
                            text: "Página";
                            color: Skin.ink;
                            font-size: 14px;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Select {
                                width: 220px;
                                options: page-names;
                                index: app.page;
                                accent: accent;
                                label: "Página de " + app.name;
                                chosen(k) => { root.app-page-chosen(app.id, k); }
                            }
                        }
                    }
                    for s in app.settings: SettingLine {
                        s: s;
                        accent: accent;
                        toggled => { root.setting-toggled(s.app, s.key); }
                        int-edited(v) => { root.setting-int(s.app, s.key, v); }
                        chosen(i) => { root.setting-chosen(s.app, s.key, i); }
                    }
                }
            }
        }

        Text {
            text: "Mascotes e temas do CyberDock · Interface feita com Slint (slint.dev)";
            color: Skin.dim;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}

// ---- barra lateral -----------------------------------------------------------------

// Um item da barra lateral: ícone em pixel e nome embaixo; marca de alerta no canto.
component RailItem inherits Rectangle {
    in property <image> icon;
    in property <string> icon-path;   // traço 24×24, quando não há imagem
    in property <string> text;
    in property <bool> selected;
    in property <color> badge: transparent;
    callback clicked;
    height: 58px;
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selected: selected;
    accessible-action-default => { root.clicked(); }
    background: selected ? Skin.panel-ink.with-alpha(0.16) : touch.has-hover ? Skin.panel-ink.with-alpha(0.08) : transparent;
    animate background { duration: 120ms; }

    if selected: Rectangle { x: 0; width: 3px; background: Skin.accent; }
    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 5px;
        spacing: 3px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            if icon-path == "": Image {
                source: icon;
                image-rendering: pixelated;
                width: 32px;
                height: 28px;
            }
            if icon-path != "": Rectangle {
                width: 32px;
                height: 28px;
                Icon { icon: icon-path; ink: selected ? Skin.panel-ink : Skin.panel-sub; size: 20px; }
            }
        }
        Text {
            text: root.text;
            color: selected ? Skin.panel-ink : Skin.panel-sub;
            font-size: 10px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    if badge != transparent: Rectangle {
        x: parent.width - 16px;
        y: 6px;
        width: 8px;
        height: 8px;
        background: badge;
        border-width: 1px;
        border-color: Skin.panel;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Barra lateral: as páginas do painel em cima; nova página e configurações embaixo.
component Rail inherits Rectangle {
    in property <[PageInfo]> pages;
    in property <int> current;          // página aberta
    in property <bool> settings;        // as configurações estão abertas
    callback selected(int);
    callback add();
    callback open-settings();
    width: 68px;
    background: Skin.panel;
    // linha à direita, como a do cabeçalho
    Rectangle { x: parent.width - 1px; width: 1px; background: Skin.line; }

    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        padding-right: 1px;
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 2px;
                for p[i] in pages: RailItem {
                    icon: p.icon;
                    text: p.name;
                    selected: !settings && i == current;
                    badge: p.mood == "alarm" ? Skin.bad : p.mood == "busy" ? Moods.color(p.theme, "busy") : transparent;
                    clicked => { root.selected(i); }
                }
                RailItem {
                    icon-path: Icons.plus;
                    text: "nova";
                    clicked => { root.add(); }
                }
            }
        }
        Rectangle { height: 1px; background: Skin.line; }
        RailItem {
            icon-path: Icons.gear;
            text: "config";
            selected: settings;
            clicked => { root.open-settings(); }
        }
    }
}

// Uma aba de página no cabeçalho: mascote pequena e nome; sublinhada quando aberta.
component TopTab inherits Rectangle {
    in property <image> icon;
    in property <string> icon-path;
    in property <string> text;
    in property <bool> selected;
    in property <color> badge: transparent;
    callback clicked;
    height: 36px;
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selected: selected;
    accessible-action-default => { root.clicked(); }
    background: selected ? Skin.panel-ink.with-alpha(0.16) : touch.has-hover ? Skin.panel-ink.with-alpha(0.08) : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            if icon-path == "": Image { source: icon; image-rendering: pixelated; width: 24px; height: 21px; }
            if icon-path != "": Icon { icon: icon-path; ink: Skin.panel-sub; size: 16px; }
        }
        if text != "": Text {
            text: root.text;
            color: selected ? Skin.panel-ink : Skin.panel-sub;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    if selected: Rectangle { y: parent.height - 2px; height: 2px; background: Skin.accent; }
    if badge != transparent: Rectangle {
        x: 4px;
        y: 4px;
        width: 7px;
        height: 7px;
        background: badge;
        border-width: 1px;
        border-color: Skin.panel;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Abas das páginas no cabeçalho (navegação "top"); rolam de lado se não couberem.
component TopTabs inherits Flickable {
    in property <[PageInfo]> pages;
    in property <int> current;
    callback selected(int);
    callback add();
    interactive: true;
    content-width: max(self.width, row.preferred-width);
    row := HorizontalLayout {
        height: root.height;
        spacing: 2px;
        alignment: start;
        for p[i] in pages: VerticalLayout {
            alignment: center;
            TopTab {
                icon: p.icon;
                text: p.name;
                selected: i == current;
                badge: p.mood == "alarm" ? Skin.bad : p.mood == "busy" ? Moods.color(p.theme, "busy") : transparent;
                clicked => { root.selected(i); }
            }
        }
        VerticalLayout {
            alignment: center;
            TopTab {
                icon-path: Icons.plus;
                accessible-label: "Nova página";
                clicked => { root.add(); }
            }
        }
    }
}

// ---- painel ---------------------------------------------------------------------

// Alça de redimensionar (barra ou canto) no modo de edição.
component Handle inherits TouchArea {
    in property <string> mode;      // "r" | "b" | "rb"
    callback begin(length, length);
    callback drag(length, length);
    callback end();
    mouse-cursor: mode == "r" ? ew-resize : mode == "b" ? ns-resize : nwse-resize;
    pointer-event(ev) => {
        if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
            root.begin(self.mouse-x, self.mouse-y);
        } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
            root.end();
        }
    }
    moved => { if self.pressed { root.drag(self.mouse-x, self.mouse-y); } }

    property <color> ink: self.has-hover || self.pressed ? Skin.ink : Skin.accent;
    if mode == "r": Rectangle { width: 4px; height: min(48px, parent.height); background: ink; }
    if mode == "b": Rectangle { width: min(48px, parent.width); height: 4px; background: ink; }
    if mode == "rb": Rectangle {
        x: parent.width - 18px;
        y: parent.height - 18px;
        width: 14px;
        height: 14px;
        Rectangle { x: parent.width - 4px; width: 4px; background: ink; }
        Rectangle { y: parent.height - 4px; height: 4px; background: ink; }
    }
}

// Grade com os apps ligados. A altura de uma linha é a altura visível dividida pelas
// linhas, com um mínimo; passando disso, o painel rola.
component Dashboard inherits ScrollView {
    in property <[GridCell]> cells;
    in property <int> columns;
    in property <int> rows;
    in property <bool> editing;
    in property <Ghost> ghost;
    // começo, meio e fim de um arrasto (célula sob o ponteiro)
    callback edit-begin(string /* id */, string /* "move" | "r" | "b" | "rb" */, int, int);
    callback edit-drag(int, int);
    callback edit-end();
    // setas no modo de edição: mover (ou redimensionar com Shift)
    callback edit-key(string, int, int, bool);

    property <length> pad: 12px;
    property <length> gap: 12px;
    property <length> cw: (self.visible-width - 2 * pad - (columns - 1) * gap) / max(columns, 1);
    property <length> rh: max(160px, (self.visible-height - 2 * pad - (rows - 1) * gap) / max(rows, 1));
    content-width: self.visible-width;
    content-height: 2 * pad + rows * rh + max(rows - 1, 0) * gap;

    // célula da grade sob um ponto do conteúdo
    pure function col-at(px: length) -> int {
        return clamp(floor((px - pad + gap / 2) / (cw + gap)), 0, columns - 1);
    }
    pure function row-at(py: length) -> int {
        return clamp(floor((py - pad + gap / 2) / (rh + gap)), 0, rows - 1);
    }

    if cells.length == 0 && !editing: Text {
        width: root.visible-width;
        height: root.visible-height;
        text: "Nenhum app ligado. Na engrenagem, abra as Configurações.";
        color: Skin.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // células vazias da grade, para mirar
    if editing: Rectangle {
        for i in columns * rows: Rectangle {
            x: pad + mod(i, columns) * (cw + gap);
            y: pad + floor(i / columns) * (rh + gap);
            width: cw;
            height: rh;
            border-width: 1px;
            border-color: Skin.slot;
            background: Skin.accent.with-alpha(0.03);
        }
    }

    // o app recebe o tamanho exato da célula e se adapta a ele
    for c in cells: cell := Rectangle {
        property <bool> active: ghost.visible && ghost.id == c.id;
        property <color> accent: active ? Skin.accent : c.theme.fur;
        x: pad + c.col * (cw + gap);
        y: pad + c.row * (rh + gap);
        width: c.w * cw + (c.w - 1) * gap;
        height: c.h * rh + (c.h - 1) * gap;
        clip: true;
        background: c.theme.bg0.mix(c.theme.bg1, 0.75).with-alpha(Skin.card-alpha);
        border-width: 1px;
        border-color: c.theme.muted.mix(c.theme.bg0, 0.55);

        if c.id == "cyber.docker": DockerView {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
        }
        if c.id == "cyber.vitals": VitalsView {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
        }
        if c.id == "cyber.cd": CdPlayerView {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
        }
        if c.id == "cyber.ports": PortsView {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
        }
        if c.id == "cyber.todo": TodoView {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
        }
        if c.id == "cyber.ai_usage": AiUsageView {
            span: c.w;
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
        }

        // conversa entre mascotes: a fala sai na caixa do app de quem fala
        if Chatter.app == c.id && !editing: SpeechBox {
            x: 10px;
            y: parent.height - self.height - 10px;
            width: parent.width - 20px;
        }

        // modo de edição: véu, contorno, barra de arrasto e alças
        if editing: Rectangle {
            background: c.theme.bg1.with-alpha(0.64);
            border-width: 2px;
            border-color: accent;

            // bloqueia cliques no app por baixo
            TouchArea { }

            fs := FocusScope {
                x: 0;
                y: 0;
                width: parent.width;
                height: 44px;
                key-pressed(e) => {
                    if e.text == Key.LeftArrow { root.edit-key(c.id, -1, 0, e.modifiers.shift); return accept; }
                    if e.text == Key.RightArrow { root.edit-key(c.id, 1, 0, e.modifiers.shift); return accept; }
                    if e.text == Key.UpArrow { root.edit-key(c.id, 0, -1, e.modifiers.shift); return accept; }
                    if e.text == Key.DownArrow { root.edit-key(c.id, 0, 1, e.modifiers.shift); return accept; }
                    reject
                }

                Rectangle {
                    background: accent;
                    border-width: fs.has-focus ? 2px : 0;
                    border-color: Skin.ink;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Icon { icon: Icons.grip; ink: c.theme.outline; filled: true; size: 16px; }
                        }
                        Text {
                            text: c.name.to-uppercase();
                            color: c.theme.outline;
                            font-size: 14px;
                            font-weight: 700;
                            letter-spacing: 1.7px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: c.w + "×" + c.h;
                            color: c.theme.outline;
                            font-family: Skin.font-mono;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }
                grip := TouchArea {
                    mouse-cursor: self.pressed ? grabbing : grab;
                    accessible-role: button;
                    accessible-label: "Mover " + c.name + ". Setas movem, Shift mais setas redimensiona";
                    pointer-event(ev) => {
                        if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                            fs.focus();
                            root.edit-begin(c.id, "move",
                                root.col-at(cell.x + self.mouse-x),
                                root.row-at(cell.y + self.mouse-y));
                        } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                            root.edit-end();
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.edit-drag(
                                root.col-at(cell.x + self.mouse-x),
                                root.row-at(cell.y + self.mouse-y));
                        }
                    }
                }
            }

            Handle {
                mode: "r";
                x: parent.width - 16px;
                y: 52px;
                width: 16px;
                height: max(0px, parent.height - 80px);
                begin(mx, my) => { root.edit-begin(c.id, "r", root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                drag(mx, my) => { root.edit-drag(root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                end => { root.edit-end(); }
            }
            Handle {
                mode: "b";
                x: 0;
                y: parent.height - 16px;
                width: max(0px, parent.width - 28px);
                height: 16px;
                begin(mx, my) => { root.edit-begin(c.id, "b", root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                drag(mx, my) => { root.edit-drag(root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                end => { root.edit-end(); }
            }
            Handle {
                mode: "rb";
                x: parent.width - 28px;
                y: parent.height - 28px;
                width: 28px;
                height: 28px;
                begin(mx, my) => { root.edit-begin(c.id, "rb", root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                drag(mx, my) => { root.edit-drag(root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                end => { root.edit-end(); }
            }
        }
    }

    // prévia do arrasto: ciano se cabe, vermelho se não
    if editing && ghost.visible: Rectangle {
        x: pad + ghost.col * (cw + gap);
        y: pad + ghost.row * (rh + gap);
        width: ghost.w * cw + (ghost.w - 1) * gap;
        height: ghost.h * rh + (ghost.h - 1) * gap;
        border-width: 2px;
        border-color: ghost.ok ? Skin.accent : Skin.bad;
        background: ghost.ok ? Skin.accent.with-alpha(0.1) : Skin.bad.with-alpha(0.12);
        Text {
            text: ghost.ok ? ghost.w + "×" + ghost.h : "sem espaço";
            color: ghost.ok ? Skin.accent : Skin.bad;
            font-family: Skin.font-mono;
            font-size: 16px;
            font-weight: 700;
        }
    }
}

// ---- moldura ----------------------------------------------------------------------

// Áreas invisíveis nas bordas e cantos para redimensionar a janela sem moldura.
component ResizeHandles inherits Rectangle {
    callback start(string);
    property <length> e: 6px;   // espessura da borda
    property <length> k: 14px;  // tamanho do canto

    // bordas
    TouchArea { y: 0; height: e; x: k; width: parent.width - 2 * k; mouse-cursor: ns-resize;
        pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.start("n"); } } }
    TouchArea { y: parent.height - e; height: e; x: k; width: parent.width - 2 * k; mouse-cursor: ns-resize;
        pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.start("s"); } } }
    TouchArea { x: 0; width: e; y: k; height: parent.height - 2 * k; mouse-cursor: ew-resize;
        pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.start("w"); } } }
    TouchArea { x: parent.width - e; width: e; y: k; height: parent.height - 2 * k; mouse-cursor: ew-resize;
        pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.start("e"); } } }
    // cantos
    TouchArea { x: 0; y: 0; width: k; height: k; mouse-cursor: nwse-resize;
        pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.start("nw"); } } }
    TouchArea { x: parent.width - k; y: parent.height - k; width: k; height: k; mouse-cursor: nwse-resize;
        pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.start("se"); } } }
    TouchArea { x: parent.width - k; y: 0; width: k; height: k; mouse-cursor: nesw-resize;
        pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.start("ne"); } } }
    TouchArea { x: 0; y: parent.height - k; width: k; height: k; mouse-cursor: nesw-resize;
        pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.start("sw"); } } }
}

// Fundo da janela: polígono com os cantos superior direito e inferior esquerdo cortados
// (ou retângulo, com chanfro 0). A borda tem a espessura do visual.
//
// Retângulo de verdade quando o chanfro é 0 (a maioria dos visuais): um `Path` do tamanho
// da janela é rasterizado inteiro, preenchimento e traço, em todo quadro, por menor que
// seja a área que mudou.
component Frame inherits Rectangle {
    if Skin.chamfer == 0: Rectangle {
        background: Skin.bg;
        border-width: Skin.border;
        border-color: Skin.edge;
    }
    if Skin.chamfer > 0: Path {
        property <float> w: self.width / 1px;
        property <float> h: self.height / 1px;
        property <float> c: Skin.chamfer / 1px;
        property <float> b: Skin.border / 2px;   // traço centrado: recua meia borda
        width: 100%;
        height: 100%;
        viewbox-width: w;
        viewbox-height: h;
        commands: "M " + b + " " + b + " L " + (w - c) + " " + b + " L " + (w - b) + " " + c
            + " L " + (w - b) + " " + (h - b) + " L " + c + " " + (h - b)
            + " L " + b + " " + (h - c) + " Z";
        fill: Skin.bg;
        stroke: Skin.edge;
        stroke-width: Skin.border;
    }
    // filete por dentro da borda (madeira do Aconchego)
    if Skin.edge-inner != transparent: Rectangle {
        x: Skin.border;
        y: Skin.border;
        width: parent.width - 2 * Skin.border;
        height: parent.height - 2 * Skin.border;
        border-width: 2px;
        border-color: Skin.edge-inner;
    }
}

// Barra de título de uma tela, com linha embaixo (e brilho em cima, se o visual tiver).
component Bar inherits Rectangle {
    in property <color> line: Skin.line;
    in property <length> line-width: Skin.header-line;
    height: Skin.header-h + Skin.panel-top-h + line-width;
    background: Skin.panel;
    Rectangle { y: 0; height: Skin.panel-top-h; background: Skin.panel-top; }
    Rectangle {
        y: Skin.panel-top-h;
        height: Skin.header-h;
        @children
    }
    Rectangle { y: parent.height - line-width; height: line-width; background: line; }
}

// Título da janela no estilo do visual: ícone em pixel, nome e cursor piscando.
component Title inherits HorizontalLayout {
    spacing: Skin.title-cursor ? 4px : 10px;
    horizontal-stretch: 0;
    if Skin.title-icon != "": VerticalLayout {
        alignment: center;
        Rectangle {
            width: 24px;
            height: 24px;
            Path {
                width: 100%;
                height: 100%;
                commands: Skin.title-icon;
                viewbox-width: 8;
                viewbox-height: 8;
                fill: Skin.panel-ink;
                anti-alias: false;
            }
            if Skin.title-icon-cut != "": Path {
                width: 100%;
                height: 100%;
                commands: Skin.title-icon-cut;
                viewbox-width: 8;
                viewbox-height: 8;
                fill: Skin.panel;
                anti-alias: false;
            }
        }
    }
    Text {
        text: Skin.title;
        color: Skin.title-cursor ? Skin.accent : Skin.panel-ink;
        font-family: Skin.font-title;
        font-size: Skin.title-size;
        font-weight: Skin.title-weight;
        letter-spacing: Skin.title-spacing;
        vertical-alignment: center;
        horizontal-stretch: 0;
    }
    if Skin.title-cursor: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 9px;
            height: 15px;
            background: Skin.accent;
            opacity: mod(Anim.frame, 8) < 4 ? 1 : 0;
        }
    }
}

export component HubWindow inherits Window {
    title: app-name;
    preferred-width: 980px;
    preferred-height: 640px;
    min-width: 400px;
    min-height: 300px;
    // popup de bandeja: sem moldura e por cima das outras janelas
    no-frame: true;
    always-on-top: true;
    // transparente: os cantos cortados mostram o que há atrás
    background: transparent;
    default-font-family: Skin.font-ui;
    default-font-size: 13px;

    in property <[AppInfo]> apps;          // todos os apps (configurações)
    in property <[GridCell]> cells;        // apps ligados, posicionados na grade
    in property <int> columns: 2;
    in property <int> rows: 1;
    // limites da grade (`layout::MAX_COLS` / `MAX_ROWS`)
    in property <int> max-columns: 6;
    in property <int> max-rows: 6;
    in property <string> grid-tag;         // "// 2 APPS · 3 × 2"
    in-out property <string> current: "panel";   // "panel" | "apps" (configurações)
    in-out property <bool> editing: false;
    in property <Ghost> ghost;
    // a grade comporta mais ou menos colunas/linhas sem tirar ninguém
    in property <bool> cols-down-ok;
    in property <bool> cols-up-ok;
    in property <bool> rows-down-ok;
    in property <bool> rows-up-ok;
    // nome exibido (`name` na config)
    in property <string> app-name: "MiniUtils";
    // visual da janela: opções (rótulos) e a escolhida
    in property <[string]> skins;
    in property <int> skin-index;
    // ícone da bandeja: mascote e tema (índice 0 = automático)
    in property <[string]> tray-icons;
    in property <int> tray-icon-index;
    in property <[string]> tray-themes;
    in property <int> tray-theme-index;
    // páginas do painel (barra lateral) e a aberta
    in property <[PageInfo]> pages;
    in property <int> page;
    in property <[string]> page-names;
    in property <[string]> mascots;          // rótulos das mascotes (ícone das páginas)
    // páginas como abas no cabeçalho em vez da barra lateral (`nav = "top"`)
    in property <bool> nav-top: false;
    in property <bool> reduce-motion: false;
    in property <int> chatter-index: 1;
    // fundo desenhado pelo Rust para o tamanho da área do painel
    in property <image> backdrop;
    // relógio e saudação ("boa noite · 21:57"), para os visuais que mostram
    in property <string> clock;
    in property <string> greeting;

    // modo fixar (ligado pelo alfinete ou pela bandeja)
    in-out property <bool> pinned: false;

    callback select-tab(string);
    callback toggle-pin();
    callback grid-size(int /* colunas */, int /* linhas */);
    callback edit-begin(string, string, int, int);
    callback edit-drag(int, int);
    callback edit-end();
    callback edit-key(string, int, int, bool);
    callback toggle-app(string);
    callback setting-toggled(string, string);
    callback setting-int(string, string, int);
    callback setting-chosen(string, string, int);
    callback hide-window();
    // começou a arrastar uma borda/canto ("n", "se", …)
    callback start-resize(string);
    // vindo do ícone da bandeja: mostra/esconde a janela junto do ponto clicado (x, y)
    callback toggle-requested(int, int);
    // outra instância pediu para abrir: aba ("apps", "panel" ou vazio = manter a atual)
    callback show-requested(string);
    callback quit();
    callback skin-chosen(int);
    callback tray-icon-chosen(int);
    callback tray-theme-chosen(int);
    callback nav-chosen(int);
    callback reduce-motion-toggled();
    callback chatter-chosen(int);
    callback page-selected(int);
    callback page-added();
    callback page-removed(int);
    callback page-renamed(int, string);
    callback page-icon-chosen(int, int);
    callback page-moved(int, int);
    callback app-page-chosen(string, int);
    // a área do painel mudou de tamanho (pixels lógicos): o Rust redesenha o fundo
    callback backdrop-resized(float, float);

    // Esc: nas configurações volta ao painel; na edição, conclui; no painel fecha o popup
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                if current == "apps" {
                    root.select-tab("panel");
                } else if editing {
                    root.edit-end();
                    root.editing = false;
                } else {
                    root.hide-window();
                }
                return accept;
            }
            reject
        }

        Frame { }

        VerticalLayout {
            padding: Skin.border;

            // cabeçalho do painel
            if current == "panel" && !editing: Bar {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    Title { }
                    if nav-top: TopTabs {
                        horizontal-stretch: 1;
                        pages: pages;
                        current: page;
                        selected(i) => { root.page-selected(i); }
                        add => { root.page-added(); }
                    }
                    if !nav-top: Text {
                        text: Skin.tag == "grid" ? grid-tag : Skin.tag == "greeting" ? greeting : "";
                        color: Skin.tag-ink;
                        font-family: Skin.tag == "grid" ? Skin.font-mono : Skin.font-ui;
                        font-size: Skin.tag == "grid" ? 11px : 13px;
                        letter-spacing: Skin.tag == "grid" ? 1.5px : 0;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: Skin.buttons == "chunky" ? 6px : Skin.buttons == "bracket" ? 2px : 6px;
                        padding-right: Skin.chamfer > 0 ? 4px : 0;
                        VerticalLayout {
                            alignment: center;
                            HeaderButton {
                                text: "Manter aberto";
                                short: pinned ? "fixado" : "fixar";
                                icon: Icons.pin;
                                px-icon: Icons.px-pin;
                                active: pinned;
                                clicked => { root.toggle-pin(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            HeaderButton {
                                text: "Mudar layout";
                                short: "layout";
                                icon: Icons.grid;
                                px-icon: Icons.px-grid;
                                clicked => { root.editing = true; }
                            }
                        }
                        if nav-top: VerticalLayout {
                            alignment: center;
                            HeaderButton {
                                text: "Configurações";
                                short: "config";
                                icon: Icons.gear;
                                px-icon: Icons.px-gear;
                                clicked => { root.select-tab("apps"); }
                            }
                        }
                    }
                }
            }

            // cabeçalho do modo de edição
            if current == "panel" && editing: Bar {
                background: Skin.edit-bg;
                line: Skin.accent;
                line-width: 1px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 14px;
                    Text {
                        text: "MODO DE EDIÇÃO";
                        color: Skin.accent;
                        font-family: Skin.font-title;
                        font-size: 16px;
                        font-weight: 700;
                        letter-spacing: 2.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "arraste pelo topo · puxe as bordas";
                        color: Skin.edit-sub;
                        font-family: Skin.font-mono;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Text { text: "Colunas"; color: Skin.edit-ink; font-size: 13px; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                height: 32px;
                                value: columns;
                                minimum: 1;
                                maximum: max-columns;
                                value-width: 24px;
                                font-size: 14px;
                                accent: Skin.accent;
                                edge: Skin.edit-line;
                                down-enabled: cols-down-ok;
                                up-enabled: cols-up-ok;
                                edited(v) => { root.grid-size(v, rows); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Text { text: "Linhas"; color: Skin.edit-ink; font-size: 13px; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                height: 32px;
                                value: rows;
                                minimum: 1;
                                maximum: max-rows;
                                value-width: 24px;
                                font-size: 14px;
                                accent: Skin.accent;
                                edge: Skin.edit-line;
                                down-enabled: rows-down-ok;
                                up-enabled: rows-up-ok;
                                edited(v) => { root.grid-size(columns, v); }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            height: 34px;
                            text: "Configurações";
                            icon: Icons.gear;
                            ink: Skin.edit-ink;
                            edge: Skin.edit-line;
                            font-size: 13px;
                            font-weight: 400;
                            clicked => { root.select-tab("apps"); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            height: 34px;
                            text: "Concluir";
                            ink: Skin.accent-ink;
                            fill: Skin.accent;
                            font-weight: 700;
                            letter-spacing: 1.1px;
                            clicked => {
                                root.edit-end();
                                root.editing = false;
                            }
                        }
                    }
                }
            }

            // cabeçalho das configurações
            if current == "apps": Bar {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: "Configurações";
                        color: Skin.panel-ink;
                        font-family: Skin.font-title;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            text: "Encerrar " + app-name;
                            short: "sair";
                            px-icon: Icons.px-close;
                            show-text: true;
                            danger: true;
                            clicked => { root.quit(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            text: "Fechar";
                            short: "fechar";
                            icon: Icons.close;
                            show-text: true;
                            clicked => { root.select-tab("panel"); }
                        }
                    }
                }
            }

            // barra lateral (páginas) e, ao lado, o painel ou as configurações
            HorizontalLayout {
            vertical-stretch: 1;
            if !nav-top: Rail {
                pages: pages;
                current: page;
                settings: current == "apps";
                selected(i) => { root.page-selected(i); }
                add => { root.page-added(); }
                open-settings => { root.select-tab(current == "apps" ? "panel" : "apps"); }
            }

            // painel, sobre o fundo do visual
            if current == "panel": area := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                changed width => { root.backdrop-resized(self.width / 1px, self.height / 1px); }
                changed height => { root.backdrop-resized(self.width / 1px, self.height / 1px); }
                Image {
                    width: 100%;
                    height: 100%;
                    source: backdrop;
                    image-fit: fill;
                }
                Dashboard {
                    width: 100%;
                    height: 100%;
                    cells: cells;
                    columns: columns;
                    rows: rows;
                    editing: editing;
                    ghost: ghost;
                    edit-begin(id, mode, col, row) => { root.edit-begin(id, mode, col, row); }
                    edit-drag(col, row) => { root.edit-drag(col, row); }
                    edit-end => { root.edit-end(); }
                    edit-key(id, dx, dy, resize) => { root.edit-key(id, dx, dy, resize); }
                }
            }

            if current == "apps": AppsView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                apps: apps;
                pages: pages;
                page-names: page-names;
                mascots: mascots;
                nav-index: nav-top ? 1 : 0;
                nav-chosen(i) => { root.nav-chosen(i); }
                reduce-motion: reduce-motion;
                reduce-motion-toggled => { root.reduce-motion-toggled(); }
                chatter-index: chatter-index;
                chatter-chosen(i) => { root.chatter-chosen(i); }
                page-added => { root.page-added(); }
                page-removed(i) => { root.page-removed(i); }
                page-renamed(i, n) => { root.page-renamed(i, n); }
                page-icon-chosen(i, k) => { root.page-icon-chosen(i, k); }
                page-moved(i, d) => { root.page-moved(i, d); }
                app-page-chosen(id, k) => { root.app-page-chosen(id, k); }
                skins: skins;
                skin-index: skin-index;
                skin-chosen(i) => { root.skin-chosen(i); }
                tray-icons: tray-icons;
                tray-icon-index: tray-icon-index;
                tray-themes: tray-themes;
                tray-theme-index: tray-theme-index;
                tray-icon-chosen(i) => { root.tray-icon-chosen(i); }
                tray-theme-chosen(i) => { root.tray-theme-chosen(i); }
                edit-layout => {
                    root.editing = true;
                    root.select-tab("panel");
                }
                toggle-app(id) => { root.toggle-app(id); }
                setting-toggled(a, k) => { root.setting-toggled(a, k); }
                setting-int(a, k, v) => { root.setting-int(a, k, v); }
                setting-chosen(a, k, i) => { root.setting-chosen(a, k, i); }
            }
            }

            // rodapé: barra de status (Terminal) ou faixa de madeira (Aconchego)
            if Skin.footer-h > 0: Rectangle {
                height: Skin.footer-h;
                background: Skin.panel;
                Rectangle { y: 0; height: max(1px, Skin.header-line - 1px); background: Skin.footer-h >= 20px ? Skin.line : Skin.edge; }
                if Skin.footer-h >= 20px: HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: "-- " + (current == "apps" ? "CONFIG" : editing ? "EDITAR" : "NORMAL") + " -- · "
                            + cells.length + (cells.length == 1 ? " app" : " apps") + " · grade " + columns + "×" + rows;
                        color: Skin.sub;
                        font-family: Skin.font-mono;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: clock;
                        color: Skin.sub;
                        font-family: Skin.font-mono;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        ResizeHandles {
            start(dir) => { root.start-resize(dir); }
        }
    }
}
