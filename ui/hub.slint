// Janela do hub: moldura e cabeçalho no visual escolhido (ver Skin) e o painel com os
// mini-apps numa grade, cada um com o próprio tema. O botão de layout liga o modo de
// edição (arrastar pelo topo, puxar as bordas); a engrenagem abre as configurações.
import { Colors, Anim, Skin, Icons } from "theme.slint";
import { TextButton, Stepper, HeaderButton } from "widgets.slint";
import { DockerApp, ContainerRow } from "../miniapps/docker/view.slint";
import { VitalsApp, VitalCard } from "../miniapps/vitals/view.slint";
import { CdPlayerApp } from "../miniapps/cdplayer/view.slint";
import { AiUsageApp, UsageCard, UsageLine } from "../miniapps/ai_usage/view.slint";
import { PortsApp, PortRow } from "../miniapps/ports/view.slint";
import { TodoApp, TodoRow } from "../miniapps/todo/view.slint";
import { AgentsApp, AgentRow, AgentSub } from "../miniapps/agents/view.slint";
import { AgentDetailWindow, AgentDetail, AgentStep } from "../miniapps/agents/detail.slint";
import { Chatter } from "chatter.slint";
import { PluginApps, PluginCard } from "plugin.slint";
import { StoreView, StoreApp, StoreRow } from "store.slint";
import { GridCell, Ghost, SettingRow, AppInfo, PageInfo, AmbientItem, DataRow } from "models.slint";
import { Ambient } from "ambient.slint";
import { AppsView } from "settings.slint";
import { Rail, PageBar, TopTabs } from "nav.slint";
import { Dashboard } from "dashboard.slint";
import { ResizeHandles, Frame, Bar, Title } from "frame.slint";

import "fonts/ChakraPetch-Regular.ttf";
import "fonts/ChakraPetch-Medium.ttf";
import "fonts/ChakraPetch-SemiBold.ttf";
import "fonts/ChakraPetch-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/PixelifySans-Regular.ttf";
import "fonts/PixelifySans-Bold.ttf";

export { Colors, Anim, Skin, DockerApp, ContainerRow, VitalsApp, VitalCard, CdPlayerApp, AiUsageApp, UsageCard, UsageLine, PortsApp, PortRow, TodoApp, TodoRow, AgentsApp, AgentRow, AgentSub, AgentDetail, AgentStep, Chatter, PluginApps, PluginCard, StoreApp, StoreRow }
// janelas além do hub: cada uma tem os próprios globais (o Rust aplica o visual a elas)
export { AgentDetailWindow }
// structs que o Rust preenche (definidas em models.slint)
export { GridCell, Ghost, SettingRow, AppInfo, PageInfo, AmbientItem, DataRow }

export component HubWindow inherits Window {
    title: app-name;
    preferred-width: 980px;
    preferred-height: 640px;
    min-width: 400px;
    min-height: 300px;
    // popup de bandeja: sem moldura e por cima das outras janelas
    no-frame: true;
    always-on-top: true;
    // transparente: os cantos cortados mostram o que há atrás
    background: transparent;
    default-font-family: Skin.font-ui;
    default-font-size: 13px * Skin.text-scale;

    in property <[AppInfo]> apps;          // todos os apps (configurações)
    in property <[GridCell]> cells;        // apps ligados, posicionados na grade
    in property <int> columns: 2;
    in property <int> rows: 1;
    // limites da grade (`layout::MAX_COLS` / `MAX_ROWS`)
    in property <int> max-columns: 6;
    in property <int> max-rows: 6;
    in property <string> grid-tag;         // "// 2 APPS · 3 × 2"
    in-out property <string> current: "panel";   // "panel" | "apps" (configurações)
    in-out property <bool> editing: false;
    in property <Ghost> ghost;
    // a grade comporta mais ou menos colunas/linhas sem tirar ninguém
    in property <bool> cols-down-ok;
    in property <bool> cols-up-ok;
    in property <bool> rows-down-ok;
    in property <bool> rows-up-ok;
    // nome exibido (`name` na config)
    in property <string> app-name: "MiniUtils";
    // visual da janela: opções (rótulos) e a escolhida
    in property <[string]> skins;
    in property <int> skin-index;
    // ícone da bandeja: mascote e tema (índice 0 = automático)
    in property <[string]> tray-icons;
    in property <[image]> tray-icon-images;  // desenhos das opções (a primeira, "Automático", sem)
    in property <int> tray-icon-index;
    in property <[string]> tray-themes;
    in property <int> tray-theme-index;
    // páginas do painel (barra lateral) e a aberta
    in property <[PageInfo]> pages;
    in property <int> page;
    in property <[string]> page-names;
    in property <[string]> mascots;          // rótulos das mascotes (ícone das páginas)
    in property <[image]> mascot-images;     // o desenho de cada uma, na mesma ordem
    // onde ficam as páginas (`nav` da config): "side" (barra à esquerda), "right",
    // "bottom" ou "top" (abas no cabeçalho); `nav-index` é a mesma escolha na Aparência
    in property <string> nav: "side";
    in property <int> nav-index: 0;
    property <bool> nav-top: nav == "top";
    in property <bool> reduce-motion: false;
    in property <int> chatter-index: 1;
    in property <bool> autostart: false;
    in property <string> version;
    in property <string> log-dir;
    // dados dos apps (src/hub/data.rs): os de apps removidos e o aviso do último pedido
    in property <[DataRow]> orphan-data;
    in property <string> data-note-app;
    in property <string> data-note;
    in property <bool> data-note-bad;
    callback export-data(string);
    callback delete-data(string);
    // apps locais: a pasta, o resumo ("2 apps locais · 1 da loja") e as pastas recusadas
    in property <string> apps-dir;
    in property <string> apps-summary;
    in property <string> apps-skipped;
    // fundo desenhado pelo Rust para o tamanho da área do painel, e o que anima por cima
    in property <image> backdrop;
    in property <[AmbientItem]> ambient;
    in property <bool> ambient-on: true;
    // aparência: cor de destaque, tamanho do texto e a pasta de temas/visuais/fundos
    in property <[string]> accents;
    in property <int> accent-index;
    in property <[string]> text-sizes;
    in property <int> text-size-index: 1;
    in property <string> looks-dir;
    in property <string> looks-summary;
    in property <string> looks-skipped;
    // relógio e saudação ("boa noite · 21:57"), para os visuais que mostram
    in property <string> clock;
    in property <string> greeting;

    // modo fixar (ligado pelo alfinete ou pela bandeja)
    in-out property <bool> pinned: false;

    callback select-tab(string);
    callback toggle-pin();
    callback grid-size(int /* colunas */, int /* linhas */);
    callback edit-begin(string, string, int, int);
    callback edit-drag(int, int);
    callback edit-end();
    callback edit-key(string, int, int, bool);
    callback toggle-app(string);
    callback setting-toggled(string, string);
    callback setting-int(string, string, int);
    callback setting-chosen(string, string, int);
    callback hide-window();
    // começou a arrastar uma borda/canto ("n", "se", …)
    callback start-resize(string);
    // vindo do ícone da bandeja: mostra/esconde a janela junto do ponto clicado (x, y)
    callback toggle-requested(int, int);
    // outra instância pediu para abrir: aba ("apps", "panel" ou vazio = manter a atual)
    callback show-requested(string);
    callback quit();
    callback skin-chosen(int);
    callback tray-icon-chosen(int);
    callback tray-theme-chosen(int);
    callback nav-chosen(int);
    callback reduce-motion-toggled();
    callback chatter-chosen(int);
    callback autostart-toggled();
    callback open-logs();
    callback open-apps-dir();
    callback reload-apps();
    callback accent-chosen(int);
    callback text-size-chosen(int);
    callback ambient-toggled();
    callback open-looks-dir();
    callback reload-looks();
    callback page-selected(int);
    callback page-added();
    callback page-removed(int);
    callback page-renamed(int, string);
    callback page-icon-chosen(int, int);
    callback page-moved(int, int);
    callback app-page-chosen(string, int);
    // a área do painel mudou de tamanho (pixels lógicos): o Rust redesenha o fundo
    callback backdrop-resized(float, float);

    // Esc: nas configurações volta ao painel; na edição, conclui; no painel fecha o popup
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                if current == "apps" {
                    root.select-tab("panel");
                } else if current == "store" {
                    root.select-tab("apps");
                } else if editing {
                    root.edit-end();
                    root.editing = false;
                } else {
                    root.hide-window();
                }
                return accept;
            }
            reject
        }

        Frame { }

        VerticalLayout {
            padding: Skin.border;

            // cabeçalho do painel
            if current == "panel" && !editing: Bar {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    Title { }
                    if nav-top: TopTabs {
                        horizontal-stretch: 1;
                        pages: pages;
                        current: page;
                        selected(i) => { root.page-selected(i); }
                        add => { root.page-added(); }
                    }
                    if !nav-top: Text {
                        text: Skin.tag == "grid" ? grid-tag : Skin.tag == "greeting" ? greeting : "";
                        color: Skin.tag-ink;
                        font-family: Skin.tag == "grid" ? Skin.font-mono : Skin.font-ui;
                        font-size: (Skin.tag == "grid" ? 11px : 13px) * Skin.text-scale;
                        letter-spacing: Skin.tag == "grid" ? 1.5px : 0;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: Skin.buttons == "chunky" ? 6px : Skin.buttons == "bracket" ? 2px : 6px;
                        padding-right: Skin.chamfer > 0 ? 4px : 0;
                        VerticalLayout {
                            alignment: center;
                            HeaderButton {
                                text: "Manter aberto";
                                short: pinned ? "fixado" : "fixar";
                                icon: Icons.pin;
                                px-icon: Icons.px-pin;
                                active: pinned;
                                clicked => { root.toggle-pin(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            HeaderButton {
                                text: "Mudar layout";
                                short: "layout";
                                icon: Icons.grid;
                                px-icon: Icons.px-grid;
                                clicked => { root.editing = true; }
                            }
                        }
                        if nav-top: VerticalLayout {
                            alignment: center;
                            HeaderButton {
                                text: "Configurações";
                                short: "config";
                                icon: Icons.gear;
                                px-icon: Icons.px-gear;
                                clicked => { root.select-tab("apps"); }
                            }
                        }
                    }
                }
            }

            // cabeçalho do modo de edição
            if current == "panel" && editing: Bar {
                background: Skin.edit-bg;
                line: Skin.accent;
                line-width: 1px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 14px;
                    Text {
                        text: "MODO DE EDIÇÃO";
                        color: Skin.accent;
                        font-family: Skin.font-title;
                        font-size: 16px * Skin.text-scale;
                        font-weight: 700;
                        letter-spacing: 2.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "arraste pelo topo · puxe as bordas";
                        color: Skin.edit-sub;
                        font-family: Skin.font-mono;
                        font-size: 11px * Skin.text-scale;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Text { text: "Colunas"; color: Skin.edit-ink; font-size: 13px * Skin.text-scale; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                height: 32px;
                                value: columns;
                                minimum: 1;
                                maximum: max-columns;
                                value-width: 24px;
                                font-size: 14px * Skin.text-scale;
                                accent: Skin.accent;
                                edge: Skin.edit-line;
                                down-enabled: cols-down-ok;
                                up-enabled: cols-up-ok;
                                edited(v) => { root.grid-size(v, rows); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Text { text: "Linhas"; color: Skin.edit-ink; font-size: 13px * Skin.text-scale; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                height: 32px;
                                value: rows;
                                minimum: 1;
                                maximum: max-rows;
                                value-width: 24px;
                                font-size: 14px * Skin.text-scale;
                                accent: Skin.accent;
                                edge: Skin.edit-line;
                                down-enabled: rows-down-ok;
                                up-enabled: rows-up-ok;
                                edited(v) => { root.grid-size(columns, v); }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            height: 34px;
                            text: "Configurações";
                            icon: Icons.gear;
                            ink: Skin.edit-ink;
                            edge: Skin.edit-line;
                            font-size: 13px * Skin.text-scale;
                            font-weight: 400;
                            clicked => { root.select-tab("apps"); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            height: 34px;
                            text: "Concluir";
                            ink: Skin.accent-ink;
                            fill: Skin.accent;
                            font-weight: 700;
                            letter-spacing: 1.1px;
                            clicked => {
                                root.edit-end();
                                root.editing = false;
                            }
                        }
                    }
                }
            }

            // cabeçalho das configurações
            if current == "apps": Bar {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: "Configurações";
                        color: Skin.panel-ink;
                        font-family: Skin.font-title;
                        font-size: 20px * Skin.text-scale;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            text: "Loja de plugins";
                            short: "loja";
                            icon: Icons.plus;
                            show-text: true;
                            clicked => { root.select-tab("store"); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            text: "Encerrar " + app-name;
                            short: "sair";
                            px-icon: Icons.px-close;
                            show-text: true;
                            danger: true;
                            clicked => { root.quit(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            text: "Fechar";
                            short: "fechar";
                            icon: Icons.close;
                            show-text: true;
                            clicked => { root.select-tab("panel"); }
                        }
                    }
                }
            }

            // cabeçalho da loja
            if current == "store": Bar {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: "Loja de plugins";
                        color: Skin.panel-ink;
                        font-family: Skin.font-title;
                        font-size: 20px * Skin.text-scale;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            text: "Voltar";
                            short: "voltar";
                            icon: Icons.close;
                            show-text: true;
                            clicked => { root.select-tab("apps"); }
                        }
                    }
                }
            }

            // barra de páginas (à esquerda ou à direita) e, ao lado, o painel ou as configurações
            HorizontalLayout {
            vertical-stretch: 1;
            if nav == "side": Rail {
                edge: "left";
                pages: pages;
                current: page;
                settings: current != "panel";
                selected(i) => { root.page-selected(i); }
                add => { root.page-added(); }
                open-settings => { root.select-tab(current == "panel" ? "apps" : "panel"); }
            }

            // painel, sobre o fundo do visual
            if current == "panel": area := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                changed width => { root.backdrop-resized(self.width / 1px, self.height / 1px); }
                changed height => { root.backdrop-resized(self.width / 1px, self.height / 1px); }
                Image {
                    width: 100%;
                    height: 100%;
                    source: backdrop;
                    image-fit: fill;
                }
                Ambient {
                    width: 100%;
                    height: 100%;
                    items: ambient;
                    live: ambient-on && !Anim.calm;
                }
                Dashboard {
                    width: 100%;
                    height: 100%;
                    cells: cells;
                    columns: columns;
                    rows: rows;
                    editing: editing;
                    ghost: ghost;
                    edit-begin(id, mode, col, row) => { root.edit-begin(id, mode, col, row); }
                    edit-drag(col, row) => { root.edit-drag(col, row); }
                    edit-end => { root.edit-end(); }
                    edit-key(id, dx, dy, resize) => { root.edit-key(id, dx, dy, resize); }
                }
            }

            if current == "store": StoreView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
            }

            if current == "apps": AppsView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                apps: apps;
                pages: pages;
                page-names: page-names;
                mascots: mascots;
                mascot-images: mascot-images;
                nav-index: nav-index;
                nav-chosen(i) => { root.nav-chosen(i); }
                reduce-motion: reduce-motion;
                reduce-motion-toggled => { root.reduce-motion-toggled(); }
                chatter-index: chatter-index;
                chatter-chosen(i) => { root.chatter-chosen(i); }
                autostart: autostart;
                autostart-toggled => { root.autostart-toggled(); }
                version: version;
                log-dir: log-dir;
                open-logs => { root.open-logs(); }
                apps-dir: apps-dir;
                apps-summary: apps-summary;
                apps-skipped: apps-skipped;
                open-apps-dir => { root.open-apps-dir(); }
                reload-apps => { root.reload-apps(); }
                orphan-data: orphan-data;
                data-note-app: data-note-app;
                data-note: data-note;
                data-note-bad: data-note-bad;
                export-data(id) => { root.export-data(id); }
                delete-data(id) => { root.delete-data(id); }
                accents: accents;
                accent-index: accent-index;
                accent-chosen(i) => { root.accent-chosen(i); }
                text-sizes: text-sizes;
                text-size-index: text-size-index;
                text-size-chosen(i) => { root.text-size-chosen(i); }
                ambient-on: ambient-on;
                ambient-toggled => { root.ambient-toggled(); }
                looks-dir: looks-dir;
                looks-summary: looks-summary;
                looks-skipped: looks-skipped;
                open-looks-dir => { root.open-looks-dir(); }
                reload-looks => { root.reload-looks(); }
                page-added => { root.page-added(); }
                page-removed(i) => { root.page-removed(i); }
                page-renamed(i, n) => { root.page-renamed(i, n); }
                page-icon-chosen(i, k) => { root.page-icon-chosen(i, k); }
                page-moved(i, d) => { root.page-moved(i, d); }
                app-page-chosen(id, k) => { root.app-page-chosen(id, k); }
                skins: skins;
                skin-index: skin-index;
                skin-chosen(i) => { root.skin-chosen(i); }
                tray-icons: tray-icons;
                tray-icon-images: tray-icon-images;
                tray-icon-index: tray-icon-index;
                tray-themes: tray-themes;
                tray-theme-index: tray-theme-index;
                tray-icon-chosen(i) => { root.tray-icon-chosen(i); }
                tray-theme-chosen(i) => { root.tray-theme-chosen(i); }
                edit-layout => {
                    root.editing = true;
                    root.select-tab("panel");
                }
                toggle-app(id) => { root.toggle-app(id); }
                setting-toggled(a, k) => { root.setting-toggled(a, k); }
                setting-int(a, k, v) => { root.setting-int(a, k, v); }
                setting-chosen(a, k, i) => { root.setting-chosen(a, k, i); }
            }

            if nav == "right": Rail {
                edge: "right";
                pages: pages;
                current: page;
                settings: current != "panel";
                selected(i) => { root.page-selected(i); }
                add => { root.page-added(); }
                open-settings => { root.select-tab(current == "panel" ? "apps" : "panel"); }
            }
            }

            // barra de páginas embaixo (acima do rodapé do visual, se houver)
            if nav == "bottom": PageBar {
                pages: pages;
                current: page;
                settings: current != "panel";
                selected(i) => { root.page-selected(i); }
                add => { root.page-added(); }
                open-settings => { root.select-tab(current == "panel" ? "apps" : "panel"); }
            }

            // rodapé: barra de status (Terminal) ou faixa de madeira (Aconchego)
            if Skin.footer-h > 0: Rectangle {
                height: Skin.footer-h;
                background: Skin.panel;
                Rectangle { y: 0; height: max(1px, Skin.header-line - 1px); background: Skin.footer-h >= 20px ? Skin.line : Skin.edge; }
                if Skin.footer-h >= 20px: HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: "-- " + (current == "apps" ? "CONFIG" : editing ? "EDITAR" : "NORMAL") + " -- · "
                            + cells.length + (cells.length == 1 ? " app" : " apps") + " · grade " + columns + "×" + rows;
                        color: Skin.sub;
                        font-family: Skin.font-mono;
                        font-size: 12px * Skin.text-scale;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: clock;
                        color: Skin.sub;
                        font-family: Skin.font-mono;
                        font-size: 12px * Skin.text-scale;
                        vertical-alignment: center;
                    }
                }
            }
        }

        ResizeHandles {
            start(dir) => { root.start-resize(dir); }
        }
    }
}
