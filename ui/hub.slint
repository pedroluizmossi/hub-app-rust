// Hub window: frame and header in the chosen skin (see Skin) and the dashboard with the
// mini-apps on a grid, each with its own theme. The layout button turns on edit mode
// (drag by the top, pull the edges); the gear opens the settings.
import { Colors, Anim, Skin, Icons } from "theme.slint";
import { TextButton, Stepper, HeaderButton } from "widgets.slint";
import { DockerApp, ContainerRow } from "../miniapps/docker/view.slint";
import { KubeApp, KubeRow } from "../miniapps/kube/view.slint";
import { VitalsApp, VitalCard } from "../miniapps/vitals/view.slint";
import { CdPlayerApp } from "../miniapps/cdplayer/view.slint";
import { AiUsageApp, UsageCard, UsageLine } from "../miniapps/ai_usage/view.slint";
import { PortsApp, PortRow } from "../miniapps/ports/view.slint";
import { TodoApp, TodoRow } from "../miniapps/todo/view.slint";
import { TerminalApp } from "../miniapps/terminal/view.slint";
import { TerminalWindow, TerminalScreen, TermLine, TermRun, TermTab } from "../miniapps/terminal/window.slint";
import { AgentsApp, AgentRow, AgentSub, AgentWalker } from "../miniapps/agents/view.slint";
import { AgentDetailWindow, AgentDetail, AgentStep } from "../miniapps/agents/detail.slint";
import { MascotsApp } from "../miniapps/mascots/view.slint";
import { MascotsManager, MascotItem, PaletteRow, StopRow } from "../miniapps/mascots/manager.slint";
import { LibraryWindow, LibraryUi, LibItem, LibParam, LibLink } from "library.slint";
import { Chatter } from "chatter.slint";
import { PluginApps, PluginCard } from "plugin.slint";
import { StoreView, StoreApp, StoreRow } from "store.slint";
import { GridCell, Ghost, SettingRow, AppInfo, PageInfo, AmbientItem, DataRow, ProcUsage } from "models.slint";
import { Ambient } from "ambient.slint";
import { AppsView } from "settings.slint";
import { Rail, PageBar, TopTabs } from "nav.slint";
import { Dashboard } from "dashboard.slint";
import { ResizeHandles, Frame, Bar, Title } from "frame.slint";

import "fonts/ChakraPetch-Regular.ttf";
import "fonts/ChakraPetch-Medium.ttf";
import "fonts/ChakraPetch-SemiBold.ttf";
import "fonts/ChakraPetch-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/PixelifySans-Regular.ttf";
import "fonts/PixelifySans-Bold.ttf";

export { Colors, Anim, Skin, DockerApp, ContainerRow, KubeApp, KubeRow, VitalsApp, VitalCard, CdPlayerApp, AiUsageApp, UsageCard, UsageLine, PortsApp, PortRow, TodoApp, TodoRow, TerminalApp, TerminalScreen, TermLine, TermRun, TermTab, AgentsApp, AgentRow, AgentSub, AgentWalker, AgentDetail, AgentStep, MascotsApp, MascotsManager, MascotItem, PaletteRow, StopRow, Chatter, PluginApps, PluginCard, StoreApp, StoreRow, LibraryUi, LibItem, LibParam, LibLink }
// windows besides the hub: each has its own globals (Rust applies the skin to them)
export { AgentDetailWindow, LibraryWindow, TerminalWindow }
// structs Rust fills in (defined in models.slint)
export { GridCell, Ghost, SettingRow, AppInfo, PageInfo, AmbientItem, DataRow, ProcUsage }

export component HubWindow inherits Window {
    title: app-name;
    preferred-width: 980px;
    preferred-height: 640px;
    min-width: 400px;
    min-height: 300px;
    // tray popup: no frame and above the other windows; a desktop app (`desktop-app`) is
    // a normal window, in the taskbar (its icon, the tray's mascot, is set through winit:
    // `popup::set_icon`)
    no-frame: true;
    always-on-top: !desktop-app;
    // transparent: the cut corners show what is behind
    background: transparent;
    default-font-family: Skin.font-ui;
    default-font-size: 13px * Skin.text-scale;

    in property <[AppInfo]> apps;          // all apps (settings)
    in property <[GridCell]> cells;        // enabled apps, positioned on the grid
    in property <int> columns: 2;
    in property <int> rows: 1;
    // grid limits (`layout::MAX_COLS` / `MAX_ROWS`)
    in property <int> max-columns: 6;
    in property <int> max-rows: 6;
    in property <string> grid-tag;         // "// 2 APPS · 3 × 2"
    in-out property <string> current: "panel";   // "panel" | "apps" (settings)
    in-out property <bool> editing: false;
    in property <Ghost> ghost;
    // the grid can take more or fewer columns/rows without removing anyone
    in property <bool> cols-down-ok;
    in property <bool> cols-up-ok;
    in property <bool> rows-down-ok;
    in property <bool> rows-up-ok;
    // displayed name (`name` in the config)
    in property <string> app-name: "MiniUtils";
    // window skin: options (labels) and the chosen one
    in property <[string]> skins;
    in property <int> skin-index;
    // tray icon: mascot and theme (index 0 = automatic)
    in property <[string]> tray-icons;
    in property <[image]> tray-icon-images;  // drawings of the options (the first, "Automatic", has none)
    in property <int> tray-icon-index;
    in property <[string]> tray-themes;
    in property <int> tray-theme-index;
    // dashboard pages (sidebar) and the open one
    in property <[PageInfo]> pages;
    // some app is enabled, on any page (the empty-page message depends on it)
    in property <bool> any-enabled;
    in property <int> page;
    in property <[string]> page-names;
    in property <[string]> mascots;          // mascot labels (page icons)
    in property <[image]> mascot-images;     // the drawing of each, in the same order
    // where the pages go (`nav` in the config): "side" (bar on the left), "right",
    // "bottom" or "top" (tabs in the header); `nav-index` is the same choice in Appearance
    in property <string> nav: "side";
    in property <int> nav-index: 0;
    property <bool> nav-top: nav == "top";
    // open blocks in Settings (closed at start; kept while the hub runs)
    property <bool> settings-appearance-open;
    property <bool> settings-system-open;
    property <bool> settings-pages-open;
    in property <bool> reduce-motion: false;
    in property <bool> still-on-hover: true;
    in property <int> chatter-index: 1;
    in property <int> language-index;
    in property <bool> autostart: false;
    // why the last change of "start with the system" failed ("" = it did not)
    in property <string> autostart-error;
    // where the window opens (index into `popup::Place::KEYS`) and the desktop app mode;
    // `can-place`: false on native Wayland, where the system decides both
    in property <int> place-index;
    in property <bool> desktop-app: false;
    in property <bool> can-place: true;
    // renderer: chosen in Settings and running (indexes into `popup::Renderer::KEYS`)
    in property <int> renderer-index;
    in property <int> renderer-running;
    in property <string> version;
    in property <string> log-dir;
    // CPU and memory of the hub and its external apps (src/hub/usage.rs)
    in property <[ProcUsage]> usage-rows;
    // app data (src/hub/data.rs): that of removed apps and the notice of the last request
    in property <[DataRow]> orphan-data;
    in property <string> data-note-app;
    in property <string> data-note;
    in property <bool> data-note-bad;
    callback export-data(string);
    callback delete-data(string);
    // local apps: the folder, the summary ("2 local apps · 1 from the store") and the rejected folders
    in property <string> apps-dir;
    in property <string> apps-summary;
    in property <string> apps-skipped;
    // background drawn by Rust for the size of the dashboard area, and what animates over it
    in property <image> backdrop;
    in property <[AmbientItem]> ambient;
    in property <bool> ambient-on: true;
    // appearance: accent color, text size and the themes/skins/backgrounds folder
    in property <[string]> accents;
    in property <int> accent-index;
    in property <[string]> text-sizes;
    in property <int> text-size-index: 1;
    in property <string> looks-dir;
    in property <string> looks-summary;
    in property <string> looks-skipped;
    // clock and greeting ("good evening · 21:57"), for the skins that show them
    in property <string> clock;
    in property <string> greeting;

    // pinned mode (turned on by the pin or the tray)
    in-out property <bool> pinned: false;

    callback select-tab(string);
    callback toggle-pin();
    callback grid-size(int /* columns */, int /* rows */);
    callback edit-begin(string, string, int, int);
    callback edit-drag(int, int);
    callback edit-end();
    callback edit-key(string, int, int, bool);
    callback toggle-app(string);
    callback setting-toggled(string, string);
    callback setting-int(string, string, int);
    callback setting-chosen(string, string, int);
    callback setting-text(string, string, string);
    callback setting-float(string, string, int);
    callback setting-reset(string, string);
    callback setting-pick(string, string);
    callback hide-window();
    // started dragging an edge/corner ("n", "se", …)
    callback start-resize(string);
    // from the tray icon: shows/hides the window next to the clicked point (x, y)
    callback toggle-requested(int, int);
    // another instance asked to open: tab ("apps", "panel" or empty = keep the current one)
    callback show-requested(string);
    // another instance asked to hide the window if it is open, or to show it as above
    callback toggle-window-requested(string);
    callback quit();
    callback skin-chosen(int);
    callback tray-icon-chosen(int);
    callback tray-theme-chosen(int);
    callback nav-chosen(int);
    callback reduce-motion-toggled();
    callback still-on-hover-toggled();
    callback chatter-chosen(int);
    callback language-chosen(int);
    callback autostart-toggled();
    callback place-chosen(int);
    callback desktop-app-toggled();
    callback renderer-chosen(int);
    callback open-logs();
    callback open-apps-dir();
    callback reload-apps();
    callback accent-chosen(int);
    callback text-size-chosen(int);
    callback ambient-toggled();
    callback open-looks-dir();
    callback reload-looks();
    callback open-library();
    callback page-selected(int);
    callback page-added();
    callback page-removed(int);
    callback page-renamed(int, string);
    callback page-icon-chosen(int, int);
    callback page-moved(int, int);
    callback app-page-chosen(string, int);
    // the dashboard area changed size (logical pixels): Rust redraws the background
    callback backdrop-resized(float, float);

    // Esc: in settings goes back to the dashboard; in edit mode, finishes; on the dashboard closes the popup
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                if current == "apps" {
                    root.select-tab("panel");
                } else if current == "store" {
                    root.select-tab("apps");
                } else if editing {
                    root.edit-end();
                    root.editing = false;
                } else {
                    root.hide-window();
                }
                return accept;
            }
            // dashboard shortcuts (Ctrl only, so text fields keep their keys)
            if e.modifiers.control && !e.modifiers.alt && current == "panel" && !editing && pages.length > 0 {
                if e.text == Key.PageDown || (e.text == Key.Tab && !e.modifiers.shift) {
                    root.page-selected(Math.mod(page + 1, pages.length));
                    return accept;
                }
                if e.text == Key.PageUp || e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift) {
                    root.page-selected(Math.mod(page - 1 + pages.length, pages.length));
                    return accept;
                }
                if e.text.is-float() && e.text.to-float() >= 1 && e.text.to-float() <= 9 {
                    if e.text.to-float() <= pages.length {
                        root.page-selected(e.text.to-float() - 1);
                    }
                    return accept;
                }
            }
            if e.modifiers.control && e.text == "," && current != "apps" {
                root.select-tab("apps");
                return accept;
            }
            reject
        }

        Frame { }

        VerticalLayout {
            padding: Skin.border;

            // dashboard header
            if current == "panel" && !editing: Bar {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    Title { }
                    if nav-top: TopTabs {
                        horizontal-stretch: 1;
                        pages: pages;
                        current: page;
                        selected(i) => { root.page-selected(i); }
                        add => { root.page-added(); }
                    }
                    if !nav-top: Text {
                        text: Skin.tag == "grid" ? grid-tag : Skin.tag == "greeting" ? greeting : "";
                        color: Skin.tag-ink;
                        font-family: Skin.tag == "grid" ? Skin.font-mono : Skin.font-ui;
                        font-size: (Skin.tag == "grid" ? 11px : 13px) * Skin.text-scale;
                        letter-spacing: Skin.tag == "grid" ? 1.5px : 0;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: Skin.buttons == "chunky" ? 6px : Skin.buttons == "bracket" ? 2px : 6px;
                        padding-right: Skin.chamfer > 0 ? 4px : 0;
                        // pinning keeps the popup open; a desktop app does not hide by itself
                        if !desktop-app: VerticalLayout {
                            alignment: center;
                            HeaderButton {
                                text: @tr("Keep open");
                                short: pinned ? @tr("pinned") : @tr("pin");
                                icon: Icons.pin;
                                px-icon: Icons.px-pin;
                                active: pinned;
                                clicked => { root.toggle-pin(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            HeaderButton {
                                text: @tr("Change layout");
                                short: @tr("layout");
                                icon: Icons.grid;
                                px-icon: Icons.px-grid;
                                clicked => { root.editing = true; }
                            }
                        }
                        if nav-top: VerticalLayout {
                            alignment: center;
                            HeaderButton {
                                text: @tr("Settings");
                                short: @tr("config");
                                icon: Icons.gear;
                                px-icon: Icons.px-gear;
                                clicked => { root.select-tab("apps"); }
                            }
                        }
                    }
                }
            }

            // edit mode header
            if current == "panel" && editing: Bar {
                background: Skin.edit-bg;
                line: Skin.accent;
                line-width: 1px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 14px;
                    Text {
                        text: @tr("EDIT MODE");
                        color: Skin.accent;
                        font-family: Skin.font-title;
                        font-size: 16px * Skin.text-scale;
                        font-weight: 700;
                        letter-spacing: 2.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: @tr("drag by the top · pull the edges");
                        color: Skin.edit-sub;
                        font-family: Skin.font-mono;
                        font-size: 11px * Skin.text-scale;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Text { text: @tr("Columns"); color: Skin.edit-ink; font-size: 13px * Skin.text-scale; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                height: 32px;
                                value: columns;
                                minimum: 1;
                                maximum: max-columns;
                                value-width: 24px;
                                font-size: 14px * Skin.text-scale;
                                accent: Skin.accent;
                                edge: Skin.edit-line;
                                down-enabled: cols-down-ok;
                                up-enabled: cols-up-ok;
                                edited(v) => { root.grid-size(v, rows); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Text { text: @tr("Rows"); color: Skin.edit-ink; font-size: 13px * Skin.text-scale; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                height: 32px;
                                value: rows;
                                minimum: 1;
                                maximum: max-rows;
                                value-width: 24px;
                                font-size: 14px * Skin.text-scale;
                                accent: Skin.accent;
                                edge: Skin.edit-line;
                                down-enabled: rows-down-ok;
                                up-enabled: rows-up-ok;
                                edited(v) => { root.grid-size(columns, v); }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            height: 34px;
                            text: @tr("Settings");
                            icon: Icons.gear;
                            ink: Skin.edit-ink;
                            edge: Skin.edit-line;
                            font-size: 13px * Skin.text-scale;
                            font-weight: 400;
                            clicked => { root.select-tab("apps"); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            height: 34px;
                            text: @tr("Done");
                            ink: Skin.accent-ink;
                            fill: Skin.accent;
                            font-weight: 700;
                            letter-spacing: 1.1px;
                            clicked => {
                                root.edit-end();
                                root.editing = false;
                            }
                        }
                    }
                }
            }

            // settings header
            if current == "apps": Bar {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: @tr("Settings");
                        color: Skin.panel-ink;
                        font-family: Skin.font-title;
                        font-size: 20px * Skin.text-scale;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            text: @tr("Plugin store");
                            short: @tr("store");
                            icon: Icons.plus;
                            show-text: true;
                            clicked => { root.select-tab("store"); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            text: @tr("Quit {}", app-name);
                            short: @tr("quit");
                            px-icon: Icons.px-close;
                            show-text: true;
                            danger: true;
                            clicked => { root.quit(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            text: @tr("Close");
                            short: @tr("close");
                            icon: Icons.close;
                            show-text: true;
                            clicked => { root.select-tab("panel"); }
                        }
                    }
                }
            }

            // store header
            if current == "store": Bar {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: @tr("Plugin store");
                        color: Skin.panel-ink;
                        font-family: Skin.font-title;
                        font-size: 20px * Skin.text-scale;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            text: @tr("Back");
                            short: @tr("back");
                            icon: Icons.close;
                            show-text: true;
                            clicked => { root.select-tab("apps"); }
                        }
                    }
                }
            }

            // page bar (left or right) and, next to it, the dashboard or the settings
            HorizontalLayout {
            vertical-stretch: 1;
            if nav == "side": Rail {
                edge: "left";
                pages: pages;
                current: page;
                settings: current != "panel";
                selected(i) => { root.page-selected(i); }
                add => { root.page-added(); }
                open-settings => { root.select-tab(current == "panel" ? "apps" : "panel"); }
            }

            // dashboard, over the skin's background
            if current == "panel": area := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                changed width => { root.backdrop-resized(self.width / 1px, self.height / 1px); }
                changed height => { root.backdrop-resized(self.width / 1px, self.height / 1px); }
                Image {
                    width: 100%;
                    height: 100%;
                    source: backdrop;
                    image-fit: fill;
                }
                Ambient {
                    width: 100%;
                    height: 100%;
                    items: ambient;
                    live: ambient-on && !Anim.calm;
                }
                Dashboard {
                    width: 100%;
                    height: 100%;
                    cells: cells;
                    columns: columns;
                    rows: rows;
                    editing: editing;
                    ghost: ghost;
                    any-enabled: any-enabled;
                    open-settings => { root.select-tab("apps"); }
                    edit-begin(id, mode, col, row) => { root.edit-begin(id, mode, col, row); }
                    edit-drag(col, row) => { root.edit-drag(col, row); }
                    edit-end => { root.edit-end(); }
                    edit-key(id, dx, dy, resize) => { root.edit-key(id, dx, dy, resize); }
                }
            }

            if current == "store": StoreView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
            }

            if current == "apps": AppsView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                appearance-open <=> root.settings-appearance-open;
                system-open <=> root.settings-system-open;
                pages-open <=> root.settings-pages-open;
                apps: apps;
                pages: pages;
                page-names: page-names;
                mascots: mascots;
                mascot-images: mascot-images;
                nav-index: nav-index;
                nav-chosen(i) => { root.nav-chosen(i); }
                reduce-motion: reduce-motion;
                reduce-motion-toggled => { root.reduce-motion-toggled(); }
                still-on-hover: still-on-hover;
                still-on-hover-toggled => { root.still-on-hover-toggled(); }
                chatter-index: chatter-index;
                chatter-chosen(i) => { root.chatter-chosen(i); }
                language-index: language-index;
                language-chosen(i) => { root.language-chosen(i); }
                autostart: autostart;
                autostart-error: autostart-error;
                autostart-toggled => { root.autostart-toggled(); }
                place-index: place-index;
                place-chosen(i) => { root.place-chosen(i); }
                desktop-app: desktop-app;
                desktop-app-toggled => { root.desktop-app-toggled(); }
                can-place: can-place;
                renderer-index: renderer-index;
                renderer-running: renderer-running;
                renderer-chosen(i) => { root.renderer-chosen(i); }
                version: version;
                log-dir: log-dir;
                usage-rows: usage-rows;
                open-logs => { root.open-logs(); }
                apps-dir: apps-dir;
                apps-summary: apps-summary;
                apps-skipped: apps-skipped;
                open-apps-dir => { root.open-apps-dir(); }
                reload-apps => { root.reload-apps(); }
                orphan-data: orphan-data;
                data-note-app: data-note-app;
                data-note: data-note;
                data-note-bad: data-note-bad;
                export-data(id) => { root.export-data(id); }
                delete-data(id) => { root.delete-data(id); }
                accents: accents;
                accent-index: accent-index;
                accent-chosen(i) => { root.accent-chosen(i); }
                text-sizes: text-sizes;
                text-size-index: text-size-index;
                text-size-chosen(i) => { root.text-size-chosen(i); }
                ambient-on: ambient-on;
                ambient-toggled => { root.ambient-toggled(); }
                looks-dir: looks-dir;
                looks-summary: looks-summary;
                looks-skipped: looks-skipped;
                open-looks-dir => { root.open-looks-dir(); }
                reload-looks => { root.reload-looks(); }
                open-library => { root.open-library(); }
                page-added => { root.page-added(); }
                page-removed(i) => { root.page-removed(i); }
                page-renamed(i, n) => { root.page-renamed(i, n); }
                page-icon-chosen(i, k) => { root.page-icon-chosen(i, k); }
                page-moved(i, d) => { root.page-moved(i, d); }
                app-page-chosen(id, k) => { root.app-page-chosen(id, k); }
                skins: skins;
                skin-index: skin-index;
                skin-chosen(i) => { root.skin-chosen(i); }
                tray-icons: tray-icons;
                tray-icon-images: tray-icon-images;
                tray-icon-index: tray-icon-index;
                tray-themes: tray-themes;
                tray-theme-index: tray-theme-index;
                tray-icon-chosen(i) => { root.tray-icon-chosen(i); }
                tray-theme-chosen(i) => { root.tray-theme-chosen(i); }
                edit-layout => {
                    root.editing = true;
                    root.select-tab("panel");
                }
                toggle-app(id) => { root.toggle-app(id); }
                setting-toggled(a, k) => { root.setting-toggled(a, k); }
                setting-int(a, k, v) => { root.setting-int(a, k, v); }
                setting-chosen(a, k, i) => { root.setting-chosen(a, k, i); }
                setting-text(a, k, t) => { root.setting-text(a, k, t); }
                setting-float(a, k, i) => { root.setting-float(a, k, i); }
                setting-reset(a, k) => { root.setting-reset(a, k); }
                setting-pick(a, k) => { root.setting-pick(a, k); }
            }

            if nav == "right": Rail {
                edge: "right";
                pages: pages;
                current: page;
                settings: current != "panel";
                selected(i) => { root.page-selected(i); }
                add => { root.page-added(); }
                open-settings => { root.select-tab(current == "panel" ? "apps" : "panel"); }
            }
            }

            // page bar at the bottom (above the skin's footer, if any)
            if nav == "bottom": PageBar {
                pages: pages;
                current: page;
                settings: current != "panel";
                selected(i) => { root.page-selected(i); }
                add => { root.page-added(); }
                open-settings => { root.select-tab(current == "panel" ? "apps" : "panel"); }
            }

            // footer: status bar (Terminal) or wood strip (Cozy)
            if Skin.footer-h > 0: Rectangle {
                height: Skin.footer-h;
                background: Skin.panel;
                Rectangle { y: 0; height: max(1px, Skin.header-line - 1px); background: Skin.footer-h >= 20px ? Skin.line : Skin.edge; }
                if Skin.footer-h >= 20px: HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: "-- " + (current == "apps" ? @tr("CONFIG") : editing ? @tr("EDIT") : @tr("NORMAL")) + " -- · "
                            + (cells.length == 1 ? @tr("1 app") : @tr("{} apps", cells.length)) + " · " + @tr("grid {}×{}", columns, rows);
                        color: Skin.sub;
                        font-family: Skin.font-mono;
                        font-size: 12px * Skin.text-scale;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: clock;
                        color: Skin.sub;
                        font-family: Skin.font-mono;
                        font-size: 12px * Skin.text-scale;
                        vertical-alignment: center;
                    }
                }
            }
        }

        ResizeHandles {
            start(dir) => { root.start-resize(dir); }
        }
    }
}
