// Store (src/hub/store.rs): where the index comes from, the list with each plugin's and
// mascot pack's state, and the actions. Install, update and remove ask for a second click,
// which shows what the plugin will run.
import { ScrollView } from "std-widgets.slint";
import { Skin, Icons } from "theme.slint";
import { Icon, TextButton } from "widgets.slint";

export struct StoreRow {
    id: string,
    // what the actions name: the id, or "mascot:<id>" for a mascot pack
    target: string,
    // "plugin" | "mascot" (a pack of drawings, no code)
    kind: string,
    name: string,
    version: string,
    // "author · license"
    byline: string,
    description: string,
    // "runs: ps · network: api.x.com · reads: sys" (or "runs no programs and uses no network")
    permissions: string,
    // "not installed", "installed 0.1.0", "update: 0.1.0 → 0.2.0"
    state: string,
    installed: bool,
    update: bool,
    // "WARNING, new permission: who" on an update
    warning: string,
    // action waiting for the second click: "" | "install" | "update" | "remove"
    armed: string,
    // text of the second click ("Confirm: install and allow uptime")
    confirm: string,
    busy: bool,
    // the plugin's stored data ("1.2 MB"; "" = none): on removal, choose whether to delete it
    data: string,
}

export global StoreApp {
    // index (registry.json: path or https://) and the public key that signs it
    in-out property <string> index;
    in-out property <string> key;
    in property <[StoreRow]> rows;
    // status: "signature verified · 2 plugins", or the error
    in property <string> status;
    in property <bool> failed;
    in property <bool> loading;
    callback reload();
    callback save-source(string /* index */, string /* key */);
    callback act(string /* target (the row's) */, string /* install | update | remove | remove-purge */);
}

// Single-line text field, in the window's colors.
component Field inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    callback accepted();
    height: 34px;
    background: Skin.field;
    border-width: 1px;
    border-color: input.has-focus ? Skin.accent : Skin.field-edge;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Rectangle {
            if text == "": Text {
                text: placeholder;
                color: Skin.dim;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
                height: 100%;
            }
            input := TextInput {
                text <=> root.text;
                color: Skin.ink;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                vertical-alignment: center;
                single-line: true;
                accessible-label: label;
                accepted => { root.accepted(); }
            }
        }
    }
}

component PluginRow inherits Rectangle {
    in property <StoreRow> item;
    background: Skin.surface;
    border-width: 1px;
    border-color: item.armed != "" ? Skin.accent : Skin.surface-edge;

    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: item.name + "  " + item.version;
                color: Skin.ink;
                font-size: 16px * Skin.text-scale;
                font-weight: 700;
                horizontal-stretch: 1;
                overflow: elide;
            }
            // a mascot pack, not an app
            if item.kind == "mascot": VerticalLayout {
                alignment: center;
                Rectangle {
                    border-width: 1px;
                    border-color: Skin.accent;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: @tr("mascots");
                            color: Skin.accent;
                            font-family: Skin.font-mono;
                            font-size: 11px * Skin.text-scale;
                        }
                    }
                }
            }
            Text {
                text: item.state;
                color: item.update ? Skin.accent2 : item.installed ? Skin.accent : Skin.dim;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                vertical-alignment: center;
            }
        }
        Text { text: item.byline + " · " + item.id; color: Skin.dim; font-family: Skin.font-mono; font-size: 11px * Skin.text-scale; overflow: elide; }
        if item.description != "": Text { text: item.description; color: Skin.sub; font-size: 13px * Skin.text-scale; wrap: word-wrap; }
        Text { text: item.permissions; color: Skin.sub; font-family: Skin.font-mono; font-size: 12px * Skin.text-scale; wrap: word-wrap; }
        if item.warning != "": Text { text: item.warning; color: Skin.danger; font-size: 13px * Skin.text-scale; font-weight: 700; wrap: word-wrap; }
        if item.armed != "": Text { text: item.confirm; color: Skin.accent; font-size: 13px * Skin.text-scale; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if item.busy: Text { text: @tr("working…"); color: Skin.dim; font-size: 12px * Skin.text-scale; vertical-alignment: center; }
            // with stored data, the second click chooses: keep or delete the data
            if !item.busy && item.installed && item.armed == "remove" && item.data != "": TextButton {
                text: @tr("Remove and delete the data");
                icon: Icons.close;
                ink: Skin.danger;
                edge: Skin.danger-edge;
                font-size: 13px * Skin.text-scale;
                clicked => { StoreApp.act(item.target, "remove-purge"); }
            }
            if !item.busy && item.installed: TextButton {
                text: item.armed != "remove" ? @tr("Remove") : item.data != "" ? @tr("Remove and keep the data") : @tr("Confirm removal");
                icon: Icons.close;
                ink: Skin.danger;
                edge: Skin.danger-edge;
                font-size: 13px * Skin.text-scale;
                clicked => { StoreApp.act(item.target, "remove"); }
            }
            if !item.busy && item.update: TextButton {
                text: item.armed == "update" ? @tr("Confirm update") : @tr("Update");
                icon: Icons.refresh;
                ink: Skin.accent;
                font-size: 13px * Skin.text-scale;
                clicked => { StoreApp.act(item.target, "update"); }
            }
            if !item.busy && !item.installed: TextButton {
                text: item.armed == "install" ? @tr("Confirm install") : @tr("Install");
                icon: Icons.plus;
                ink: Skin.accent;
                font-size: 13px * Skin.text-scale;
                clicked => { StoreApp.act(item.target, "install"); }
            }
        }
    }
}

export component StoreView inherits ScrollView {
    VerticalLayout {
        alignment: start;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 16px;
        spacing: 12px;

        // where the store comes from
        Rectangle {
            background: Skin.surface;
            border-width: 1px;
            border-color: Skin.surface-edge;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text { text: @tr("Store index"); color: Skin.ink; font-size: 17px * Skin.text-scale; font-weight: 700; }
                Text {
                    text: @tr("A registry.json (https:// address or path) and the public key of whoever signs it. Clear both fields and save to go back to the official MiniUtils store.");
                    color: Skin.sub;
                    font-size: 13px * Skin.text-scale;
                    wrap: word-wrap;
                }
                index := Field {
                    label: @tr("Index");
                    placeholder: "https://…/registry.json";
                    text: StoreApp.index;
                    accepted => { StoreApp.save-source(index.text, key.text); }
                }
                key := Field {
                    label: @tr("Public key");
                    placeholder: @tr("public key (64 hex characters)");
                    text: StoreApp.key;
                    accepted => { StoreApp.save-source(index.text, key.text); }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: StoreApp.loading ? @tr("loading…") : StoreApp.status;
                        color: StoreApp.failed ? Skin.danger : Skin.sub;
                        font-family: Skin.font-mono;
                        font-size: 12px * Skin.text-scale;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    TextButton {
                        text: @tr("Save and load");
                        icon: Icons.refresh;
                        ink: Skin.accent;
                        font-size: 13px * Skin.text-scale;
                        clicked => { StoreApp.save-source(index.text, key.text); }
                    }
                }
            }
        }

        for r in StoreApp.rows: PluginRow { item: r; }

        if StoreApp.rows.length == 0 && !StoreApp.loading: Text {
            text: @tr("Nothing to show.");
            color: Skin.dim;
            font-size: 13px * Skin.text-scale;
            horizontal-alignment: center;
        }
    }
}
