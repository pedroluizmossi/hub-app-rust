// Animated background: light elements (drops, stars, a scan band) over the background
// image, positioned every frame by the `Anim.time` clock. They are generated by
// `src/skin/backdrop.rs › ambient`. Each element is a small rectangle: the software
// renderer repaints only the region that changed (redrawing the whole image would cost
// 20 to 100 ms per frame). Colors carry alpha in `background`, never `opacity` (which
// paints into a separate layer).
import { Anim } from "theme.slint";
import { AmbientItem } from "models.slint";

export component Ambient inherits Rectangle {
    in property <[AmbientItem]> items;
    // enabled in the config and "Reduce motion" off
    in property <bool> live;
    property <float> t: Anim.time;
    clip: true;

    if root.live: Rectangle {
        for a in root.items: Rectangle {
            // fall/scan: how far it has descended, wrapping to the top after leaving the bottom
            property <float> fall: mod(a.y + (root.t + a.phase) / 1000 * a.speed, root.height / 1px + a.h);
            property <bool> lit: mod(root.t + a.phase, a.period) < a.on;
            x: (a.kind == "fall" ? a.x - fall * a.slant : a.x) * 1px;
            y: (a.kind == "blink" ? a.y : fall - a.h) * 1px;
            width: a.w * 1px;
            height: a.h * 1px;
            background: a.kind != "blink" || lit ? a.color.with-alpha(a.alpha) : transparent;
        }
    }
}
