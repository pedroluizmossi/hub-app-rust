// Painel: a grade de mini-apps, com o modo de edição (arrastar e redimensionar).
import { ScrollView } from "std-widgets.slint";
import { Skin, Icons } from "theme.slint";
import { Icon } from "widgets.slint";
import { DockerView } from "../miniapps/docker/view.slint";
import { VitalsView } from "../miniapps/vitals/view.slint";
import { CdPlayerView } from "../miniapps/cdplayer/view.slint";
import { AiUsageView } from "../miniapps/ai_usage/view.slint";
import { PortsView } from "../miniapps/ports/view.slint";
import { TodoView } from "../miniapps/todo/view.slint";
import { AgentsView } from "../miniapps/agents/view.slint";
import { Chatter, SpeechBox } from "chatter.slint";
import { PluginView, PluginApps } from "plugin.slint";
import { GridCell, Ghost } from "models.slint";

// Alça de redimensionar (barra ou canto) no modo de edição.
component Handle inherits TouchArea {
    in property <string> mode;      // "r" | "b" | "rb"
    callback begin(length, length);
    callback drag(length, length);
    callback end();
    mouse-cursor: mode == "r" ? ew-resize : mode == "b" ? ns-resize : nwse-resize;
    pointer-event(ev) => {
        if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
            root.begin(self.mouse-x, self.mouse-y);
        } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
            root.end();
        }
    }
    moved => { if self.pressed { root.drag(self.mouse-x, self.mouse-y); } }

    property <color> ink: self.has-hover || self.pressed ? Skin.ink : Skin.accent;
    if mode == "r": Rectangle { width: 4px; height: min(48px, parent.height); background: ink; }
    if mode == "b": Rectangle { width: min(48px, parent.width); height: 4px; background: ink; }
    if mode == "rb": Rectangle {
        x: parent.width - 18px;
        y: parent.height - 18px;
        width: 14px;
        height: 14px;
        Rectangle { x: parent.width - 4px; width: 4px; background: ink; }
        Rectangle { y: parent.height - 4px; height: 4px; background: ink; }
    }
}

// Grade com os apps ligados. A altura de uma linha é a altura visível dividida pelas
// linhas, com um mínimo; passando disso, o painel rola.
export component Dashboard inherits ScrollView {
    in property <[GridCell]> cells;
    in property <int> columns;
    in property <int> rows;
    in property <bool> editing;
    in property <Ghost> ghost;
    // começo, meio e fim de um arrasto (célula sob o ponteiro)
    callback edit-begin(string /* id */, string /* "move" | "r" | "b" | "rb" */, int, int);
    callback edit-drag(int, int);
    callback edit-end();
    // setas no modo de edição: mover (ou redimensionar com Shift)
    callback edit-key(string, int, int, bool);

    property <length> pad: 12px;
    property <length> gap: 12px;
    property <length> cw: (self.visible-width - 2 * pad - (columns - 1) * gap) / max(columns, 1);
    property <length> rh: max(160px, (self.visible-height - 2 * pad - (rows - 1) * gap) / max(rows, 1));
    content-width: self.visible-width;
    content-height: 2 * pad + rows * rh + max(rows - 1, 0) * gap;

    // célula da grade sob um ponto do conteúdo
    pure function col-at(px: length) -> int {
        return clamp(floor((px - pad + gap / 2) / (cw + gap)), 0, columns - 1);
    }
    pure function row-at(py: length) -> int {
        return clamp(floor((py - pad + gap / 2) / (rh + gap)), 0, rows - 1);
    }

    if cells.length == 0 && !editing: Text {
        width: root.visible-width;
        height: root.visible-height;
        text: "Nenhum app ligado. Na engrenagem, abra as Configurações.";
        color: Skin.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // células vazias da grade, para mirar
    if editing: Rectangle {
        for i in columns * rows: Rectangle {
            x: pad + mod(i, columns) * (cw + gap);
            y: pad + floor(i / columns) * (rh + gap);
            width: cw;
            height: rh;
            border-width: 1px;
            border-color: Skin.slot;
            background: Skin.accent.with-alpha(0.03);
        }
    }

    // o app recebe o tamanho exato da célula e se adapta a ele
    for c in cells: cell := Rectangle {
        property <bool> active: ghost.visible && ghost.id == c.id;
        property <color> accent: active ? Skin.accent : c.theme.fur;
        x: pad + c.col * (cw + gap);
        y: pad + c.row * (rh + gap);
        width: c.w * cw + (c.w - 1) * gap;
        height: c.h * rh + (c.h - 1) * gap;
        clip: true;
        background: c.theme.bg0.mix(c.theme.bg1, 0.75).with-alpha(Skin.card-alpha);
        border-width: 1px;
        border-color: c.theme.muted.mix(c.theme.bg0, 0.55);

        if c.id == "cyber.docker": DockerView {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
        }
        if c.id == "cyber.vitals": VitalsView {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
        }
        if c.id == "cyber.cd": CdPlayerView {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
        }
        if c.id == "cyber.ports": PortsView {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
        }
        if c.id == "cyber.agents": AgentsView {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
        }
        if c.id == "cyber.todo": TodoView {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
        }
        // plugins da comunidade: todos na mesma tela genérica (ui/plugin.slint)
        for p in PluginApps.cards: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            if p.id == c.id: PluginView {
                card: p;
                theme: c.theme;
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                height: parent.height - 28px;
            }
        }
        if c.id == "cyber.ai_usage": AiUsageView {
            span: c.w;
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
        }

        // conversa entre mascotes: a fala sai na caixa do app de quem fala
        if Chatter.app == c.id && !editing: SpeechBox {
            x: 10px;
            y: parent.height - self.height - 10px;
            width: parent.width - 20px;
        }

        // modo de edição: véu, contorno, barra de arrasto e alças
        if editing: Rectangle {
            background: c.theme.bg1.with-alpha(0.64);
            border-width: 2px;
            border-color: accent;

            // bloqueia cliques no app por baixo
            TouchArea { }

            fs := FocusScope {
                x: 0;
                y: 0;
                width: parent.width;
                height: 44px;
                key-pressed(e) => {
                    if e.text == Key.LeftArrow { root.edit-key(c.id, -1, 0, e.modifiers.shift); return accept; }
                    if e.text == Key.RightArrow { root.edit-key(c.id, 1, 0, e.modifiers.shift); return accept; }
                    if e.text == Key.UpArrow { root.edit-key(c.id, 0, -1, e.modifiers.shift); return accept; }
                    if e.text == Key.DownArrow { root.edit-key(c.id, 0, 1, e.modifiers.shift); return accept; }
                    reject
                }

                Rectangle {
                    background: accent;
                    border-width: fs.has-focus ? 2px : 0;
                    border-color: Skin.ink;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Icon { icon: Icons.grip; ink: c.theme.outline; filled: true; size: 16px; }
                        }
                        Text {
                            text: c.name.to-uppercase();
                            color: c.theme.outline;
                            font-size: 14px * Skin.text-scale;
                            font-weight: 700;
                            letter-spacing: 1.7px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: c.w + "×" + c.h;
                            color: c.theme.outline;
                            font-family: Skin.font-mono;
                            font-size: 13px * Skin.text-scale;
                            vertical-alignment: center;
                        }
                    }
                }
                grip := TouchArea {
                    mouse-cursor: self.pressed ? grabbing : grab;
                    accessible-role: button;
                    accessible-label: "Mover " + c.name + ". Setas movem, Shift mais setas redimensiona";
                    pointer-event(ev) => {
                        if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                            fs.focus();
                            root.edit-begin(c.id, "move",
                                root.col-at(cell.x + self.mouse-x),
                                root.row-at(cell.y + self.mouse-y));
                        } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                            root.edit-end();
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.edit-drag(
                                root.col-at(cell.x + self.mouse-x),
                                root.row-at(cell.y + self.mouse-y));
                        }
                    }
                }
            }

            Handle {
                mode: "r";
                x: parent.width - 16px;
                y: 52px;
                width: 16px;
                height: max(0px, parent.height - 80px);
                begin(mx, my) => { root.edit-begin(c.id, "r", root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                drag(mx, my) => { root.edit-drag(root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                end => { root.edit-end(); }
            }
            Handle {
                mode: "b";
                x: 0;
                y: parent.height - 16px;
                width: max(0px, parent.width - 28px);
                height: 16px;
                begin(mx, my) => { root.edit-begin(c.id, "b", root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                drag(mx, my) => { root.edit-drag(root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                end => { root.edit-end(); }
            }
            Handle {
                mode: "rb";
                x: parent.width - 28px;
                y: parent.height - 28px;
                width: 28px;
                height: 28px;
                begin(mx, my) => { root.edit-begin(c.id, "rb", root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                drag(mx, my) => { root.edit-drag(root.col-at(cell.x + self.x + mx), root.row-at(cell.y + self.y + my)); }
                end => { root.edit-end(); }
            }
        }
    }

    // prévia do arrasto: ciano se cabe, vermelho se não
    if editing && ghost.visible: Rectangle {
        x: pad + ghost.col * (cw + gap);
        y: pad + ghost.row * (rh + gap);
        width: ghost.w * cw + (ghost.w - 1) * gap;
        height: ghost.h * rh + (ghost.h - 1) * gap;
        border-width: 2px;
        border-color: ghost.ok ? Skin.accent : Skin.bad;
        background: ghost.ok ? Skin.accent.with-alpha(0.1) : Skin.bad.with-alpha(0.12);
        Text {
            text: ghost.ok ? ghost.w + "×" + ghost.h : "sem espaço";
            color: ghost.ok ? Skin.accent : Skin.bad;
            font-family: Skin.font-mono;
            font-size: 16px * Skin.text-scale;
            font-weight: 700;
        }
    }
}
