// Components reused by the mini-apps and the frame. Square corners, thin lines
// and stroke icons, as in the Toca design.
import { Colors, Moods, Anim, Skin, Icons } from "theme.slint";
import { Chatter } from "chatter.slint";

// Pixel-art mascot. The frame (blink, LED, glitch) comes drawn from Rust;
// floating and bouncing are offsets here, without redrawing the image. `reaction` is a short
// reaction on top of the mood ("celebrate", "surprised"; see src/mascot/anim.rs). Clicks on the
// mascot call `poked` (Rust decides whether it becomes an easter egg). `voice` is the mascot's id
// in the chatter between mascots ("app:name", the same as in Rust): when talking it hops; when
// listening it shows "..." above its head. Without `voice`, it stays out of the chatter.
export component Mascot inherits Rectangle {
    in property <Colors> theme;
    in property <image> frame;
    in property <string> mood: "idle";
    in property <string> reaction;
    in property <bool> moving: !Anim.calm;
    in property <string> voice;
    // the pointer is over the mascot's card: it perks up (a sleeping one keeps sleeping),
    // unless "Still mascots on hover" is on (`Anim.still-on-hover`)
    in property <bool> noticed;
    callback poked;
    property <bool> talking: voice != "" && voice == Chatter.speaker;
    property <bool> listening: voice != "" && voice == Chatter.listener;
    property <int> f: Anim.frame;
    property <bool> party: reaction == "celebrate";
    property <bool> startled: reaction == "surprised";
    property <color> accent: Moods.color(theme, mood);
    // reference size (Skin.mascot-size); whoever uses the mascot may give another box
    preferred-width: Skin.mascot-size;
    preferred-height: Skin.mascot-size * 14 / 16;
    property <float> glow: mood == "alarm" && mod(f, 4) < 2 ? 1.6 : 1;
    // frame width / height: 16×14 for the drawn ones; for imported ones (PNG), the drawing's
    property <float> ratio: frame.height > 0 ? frame.width / frame.height : 16 / 14;

    // the frame takes the largest size that fits the box, without distorting (automatic scale)
    stage := Rectangle {
        width: min(root.width, root.height * ratio);
        height: self.width / ratio;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        // neon aura: concentric rings (the software renderer has no blur)
        if mood != "sleep": Rectangle {
            for k in 3: Rectangle {
                property <float> s: 1.1 - k * 0.2;
                width: stage.width * s;
                height: stage.height * s;
                x: (stage.width - self.width) / 2;
                y: (stage.height - self.height) / 2 + stage.height * 0.05;
                border-radius: min(self.width, self.height) / 2;
                background: accent.with-alpha(0.07 * glow);
            }
        }

        Image {
            source: frame;
            image-rendering: pixelated;
            width: parent.width;
            height: parent.height;
            x: !moving ? 0
                : startled ? (mod(f, 2) == 0 ? -2px : 2px)
                : mood == "alarm" ? (mod(f, 2) == 0 ? -1px : 1px) : 0;
            y: !moving ? 0
                : talking ? (mod(f, 2) == 0 ? -parent.height * 0.08 : 0)
                : party ? (mod(f, 4) < 2 ? -parent.height * 0.24 : 0)
                : startled ? -parent.height * 0.12
                : noticed && !Anim.still-on-hover && mood != "sleep" && mood != "alarm" ? -parent.height * 0.14
                : mood == "busy" || mood == "happy" ? (mod(f, 4) < 2 ? -parent.height * 0.1 : 0)
                : mood == "idle" ? (mod(f, 16) < 8 ? -parent.height * 0.04 : 0)
                : 0;
            animate y { duration: 110ms; easing: ease-out; }
        }

        // "z" for sleep / "!" for alarm
        if moving && mood == "sleep": Text {
            text: "z";
            x: parent.width * 0.8;
            y: parent.height * 0.05 - mod(f, 16) * 1px;
            opacity: 1 - mod(f, 16) / 16;
            color: theme.sleep;
            font-size: parent.height * 0.22;
            font-weight: 700;
        }
        if moving && mood == "alarm": Text {
            text: "!";
            x: parent.width * 0.86;
            y: 0;
            color: theme.alarm;
            font-size: parent.height * 0.3;
            font-weight: 900;
            opacity: mod(f, 4) < 2 ? 1 : 0.3;
        }

        // celebration: square sparks that rise and fade, around the head
        if party: Rectangle {
            for k in 4: Rectangle {
                property <int> step: mod(f + k * 3, 8);
                property <length> s: max(2px, stage.height * 0.07);
                width: s;
                height: s;
                x: stage.width * (k == 0 ? 0.04 : k == 1 ? 0.84 : k == 2 ? 0.18 : 0.7);
                y: stage.height * (k < 2 ? 0.3 : 0.05) - step * stage.height * 0.035;
                background: mod(k, 2) == 0 ? theme.ok : theme.visor;
                opacity: 1 - step / 8;
            }
        }
        // listening to the speaker: pixel "..." above the head (the dots light up in sequence)
        if listening: Rectangle {
            for k in 3: Rectangle {
                property <length> s: max(2px, stage.height * 0.08);
                x: stage.width * 0.62 + k * s * 1.6;
                y: -s * 0.5;
                width: s;
                height: s;
                background: theme.visor;
                opacity: !moving || mod(f, 4) >= k ? 1 : 0.25;
            }
        }
        // startled (easter egg): "?" above the head
        if startled: Text {
            text: "?";
            x: parent.width * 0.8;
            y: -parent.height * 0.08;
            color: theme.visor;
            font-size: parent.height * 0.32;
            font-weight: 900;
        }
    }

    TouchArea {
        clicked => { root.poked(); }
    }
}

// Stroke icon in a 24×24 frame.
export component Icon inherits Path {
    in property <string> icon;
    in property <color> ink: Skin.sub;
    in property <bool> filled: false;
    in property <length> size: 16px;
    in property <float> weight: 2.2;
    width: size;
    height: size;
    commands: icon;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: filled ? transparent : ink;
    stroke-width: size * weight / 24;
    stroke-line-cap: square;
    fill: filled ? ink : transparent;
}

// Outline of the control that has the keyboard focus (reached with Tab). Fills its parent
// unless placed (controls with a border put it 3px outside, to stand apart from it).
export component FocusRing inherits Rectangle {
    in property <color> ink: Skin.accent;
    border-width: 2px;
    border-color: ink;
}

// Square icon-only button (container actions, pin, gear).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> ink: Skin.accent;
    in property <color> edge: Skin.edge;
    in property <bool> enabled: true;
    in property <length> icon-size: 16px;
    in property <string> label;   // name for screen readers
    callback clicked;
    width: 44px;
    height: 44px;
    border-width: 1px;
    border-color: edge;
    background: !enabled ? transparent : touch.pressed ? ink.with-alpha(0.22) : touch.has-hover ? ink.with-alpha(0.12) : transparent;
    opacity: enabled ? 1 : 0.35;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }

    Icon {
        icon: root.icon;
        ink: root.ink;
        size: root.icon-size;
    }
    // keyboard: Tab reaches it, Enter or Space clicks (a mouse click does not take the focus)
    keys := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == Key.Space {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    // outside the button, so it does not blend with its border
    if keys.has-focus: FocusRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Button with text (and an optional icon) and a thin border.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <color> ink: Skin.accent;
    in property <color> edge: ink;
    in property <color> fill: transparent;   // solid fill (primary button)
    in property <length> font-size: 14px * Skin.text-scale;
    in property <int> font-weight: 600;
    in property <length> letter-spacing: 0;
    in property <bool> compact: false;        // icon only
    // off: faded, no hover and no click (and screen readers know it)
    in property <bool> enabled: true;
    callback clicked;
    height: 36px;
    min-width: row.preferred-width + 24px;
    horizontal-stretch: 0;
    opacity: enabled ? 1 : 0.35;
    border-width: fill == transparent ? 1px : 0;
    border-color: edge;
    background: fill != transparent ? (touch.pressed ? fill.darker(0.2) : touch.has-hover ? fill.brighter(0.15) : fill)
        : touch.pressed ? ink.with-alpha(0.22) : touch.has-hover ? ink.with-alpha(0.12) : transparent;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }

    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if icon != "": VerticalLayout {
            alignment: center;
            Icon { icon: root.icon; ink: root.ink; size: 14px; weight: 2.4; }
        }
        if !compact: Text {
            text: root.text;
            color: root.ink;
            font-size: root.font-size;
            font-weight: root.font-weight;
            letter-spacing: root.letter-spacing;
            vertical-alignment: center;
        }
    }
    keys := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == Key.Space {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    if keys.has-focus: FocusRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; ink: root.ink; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Square switch: track in the accent color when on.
export component SqSwitch inherits Rectangle {
    in property <bool> checked;
    in property <color> accent: Skin.accent;
    in property <length> knob: 14px;
    in property <string> label;
    // off colors and knob colors (inside an app, they come from the app's theme)
    in property <color> off-track: Skin.field;
    in property <color> off-edge: Skin.field-edge;
    in property <color> off-knob: Skin.dim;
    in property <color> on-knob: Skin.bg;
    callback toggled;
    width: 40px;
    height: 22px;
    border-width: 1px;
    border-color: checked ? accent : off-edge;
    background: checked ? accent : off-track;
    animate background, border-color { duration: 150ms; }
    accessible-role: switch;
    accessible-checked: checked;
    accessible-label: label;
    accessible-action-default => { root.toggled(); }

    Rectangle {
        width: knob;
        height: knob;
        y: (parent.height - self.height) / 2;
        x: checked ? parent.width - self.width - (parent.height - self.height) / 2 : (parent.height - self.height) / 2;
        background: checked ? on-knob : off-knob;
        animate x { duration: 150ms; easing: ease-in-out; }
    }
    keys := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == Key.Space {
                root.toggled();
                return accept;
            }
            reject
        }
    }
    // outside the track, so it shows in either state
    if keys.has-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        ink: accent;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// − / + button of a stepper.
component StepKey inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    in property <bool> enabled: true;
    callback clicked;
    width: 34px;
    background: enabled && touch.has-hover ? Skin.hover : transparent;
    opacity: enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: text == "+" ? @tr("Increase") : @tr("Decrease");
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    Text {
        text: root.text;
        color: root.ink;
        font-family: Skin.font-mono;
        font-size: 16px * Skin.text-scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    keys := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == Key.Space {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    if keys.has-focus: FocusRing { ink: root.ink; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Number with − and + on the sides.
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> unit;
    // what is written between − and + (a float setting steps positions and shows its value)
    in property <string> text: value + unit;
    // the widest `text` (sizes the box); with no real maximum, the current one
    in property <string> widest-text: (maximum < 1000000 ? max(maximum, value) : value) + unit;
    in property <color> accent: Skin.accent;
    in property <color> edge: Skin.field-edge;
    // at least this wide; wider when the largest value (or, with no real maximum, the
    // current one) needs it at the text size in use, so it does not jump while stepping
    in property <length> value-width: 52px;
    in property <length> font-size: 15px * Skin.text-scale;
    // − and + disabled from outside (e.g. the grid can't fit it)
    in property <bool> down-enabled: value > minimum;
    in property <bool> up-enabled: value < maximum;
    callback edited(int);
    height: 34px;
    border-width: 1px;
    border-color: edge;
    background: Skin.field;
    // measures the widest value; not drawn
    widest := Text {
        visible: false;
        text: root.widest-text;
        font-family: Skin.font-mono;
        font-size: root.font-size;
    }
    HorizontalLayout {
        padding: 1px;
        StepKey {
            text: "−";
            ink: accent;
            enabled: down-enabled;
            clicked => { root.edited(max(minimum, value - step)); }
        }
        Text {
            width: max(value-width, widest.preferred-width + 10px);
            text: root.text;
            color: Skin.ink;
            font-family: Skin.font-mono;
            font-size: root.font-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        StepKey {
            text: "+";
            ink: accent;
            enabled: up-enabled;
            clicked => { root.edited(min(maximum, value + step)); }
        }
    }
}

// One line of text for a setting (a URL, a token). Saves with Enter or when the field loses
// focus, only if it changed; Esc goes back to the saved value. `secret` hides what is typed.
export component TextField inherits Rectangle {
    in property <string> value;
    in property <bool> secret;
    // monospaced (URLs, tokens); off for names
    in property <bool> mono: true;
    in property <string> label;
    in property <color> accent: Skin.accent;
    in property <color> edge: Skin.field-edge;
    callback committed(string);
    height: 34px;
    border-width: 1px;
    border-color: input.has-focus ? accent : edge;
    background: Skin.field;
    clip: true;

    // the saved value came back (or changed elsewhere): show it, unless the user is typing
    changed value => {
        if !input.has-focus { input.text = value; }
    }

    function commit() {
        if input.text != value { root.committed(input.text); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        input := TextInput {
            text: root.value;
            input-type: root.secret ? InputType.password : InputType.text;
            single-line: true;
            color: Skin.ink;
            font-family: root.mono ? Skin.font-mono : Skin.font-ui;
            font-size: (root.mono ? 13px : 14px) * Skin.text-scale;
            vertical-alignment: center;
            accessible-label: root.label;
            accepted => { root.commit(); }
            changed has-focus => {
                if !self.has-focus { root.commit(); }
            }
            key-pressed(e) => {
                if e.text == Key.Escape {
                    self.text = root.value;
                    return accept;
                }
                reject
            }
        }
    }
}

// Choice list: a button with the current option and a list that opens below.
export component Select inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    in property <color> accent: Skin.accent;
    in property <string> label;
    callback chosen(int);
    width: 240px;
    height: 36px;
    border-width: 1px;
    border-color: touch.has-hover ? accent : Skin.field-edge;
    background: Skin.field;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: options[index];
    accessible-action-default => { popup.show(); }

    // keyboard: Enter or Space opens the list; the arrows change the option in place
    keys := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == Key.Space {
                popup.show();
                return accept;
            }
            if e.text == Key.UpArrow && index > 0 {
                root.picked = index - 1;
                return accept;
            }
            if e.text == Key.DownArrow && index < options.length - 1 {
                root.picked = index + 1;
                return accept;
            }
            reject
        }
    }
    if keys.has-focus: FocusRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; ink: accent; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: options[index];
            color: Skin.ink;
            font-size: 14px * Skin.text-scale;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Icon { icon: Icons.chevron; ink: accent; size: 14px; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    // Clicked option, waiting to be reported. `chosen` can't be called straight from the click:
    // after `popup.close()` the list is already destroyed and the call vanishes silently; and
    // before it, Rust may rebuild the settings list and destroy this Select with the list
    // still open. `changed` runs after the click, with the list already closed.
    property <int> picked: -1;
    changed picked => {
        if picked >= 0 {
            root.chosen(picked);
            picked = -1;
        }
    }

    property <length> item-h: 32px;
    // The list is drawn inside the window: if too long (32 mascots), it would go past the edge
    // and the last options would be unreachable. It shows at most 8 and a half (the half hints
    // there is more) and the rest scrolls.
    property <length> full-h: options.length * item-h;
    property <length> list-h: min(full-h, 8.5 * item-h);
    // Explicit height: without it Slint computes a clickable area smaller than the list, and a
    // click at the bottom counts as "outside" and closes the list without choosing.
    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        height: list-h + 2px;
        // dragging to scroll ends in a click inside the list: close only on a choice or a click outside
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            background: Skin.field;
            border-width: 1px;
            border-color: accent;
            flick := Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: list-h;
                content-width: self.width;
                content-height: full-h;
                // opens with the current option in view (a few above it, for context)
                content-y: -max(0px, min((index - 3) * item-h, full-h - list-h));
                for o[i] in options: Rectangle {
                    y: i * item-h;
                    width: flick.width;
                    height: item-h;
                    background: i == index ? accent.with-alpha(0.18) : item.has-hover ? Skin.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: o;
                            color: i == index ? accent : Skin.ink;
                            font-size: 14px * Skin.text-scale;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    item := TouchArea {
                        mouse-cursor: pointer;
                        // stores the choice and closes; the report comes from `changed picked`
                        clicked => {
                            root.picked = i;
                            popup.close();
                        }
                    }
                }
            }
            // where we are in the list, when it scrolls
            if full-h > list-h: Rectangle {
                x: parent.width - 4px;
                y: 1px + (-flick.content-y / full-h) * list-h;
                width: 3px;
                height: list-h * (list-h / full-h);
                background: accent.with-alpha(0.55);
            }
        }
    }
}

// Thumbnail of a mascot in a picker. Empty image = option without a drawing ("Automatic"),
// shown as a pixel sparkle.
component MascotThumb inherits Rectangle {
    in property <image> source;
    in property <color> ink: Skin.accent;
    if source.width > 0: Image {
        source: root.source;
        image-rendering: pixelated;
        // 16×14 for the drawn ones; for imported ones, the PNG's aspect ratio
        width: min(root.width, root.height * source.width / max(1, source.height));
        height: self.width * source.height / max(1, source.width);
    }
    if source.width == 0: Path {
        width: min(root.width, root.height) * 0.6;
        height: self.width;
        commands: "M3 0h1v2H3zM3 5h1v2H3zM0 3h2v1H0zM5 3h2v1H5zM2 2h3v3H2z";
        viewbox-width: 7;
        viewbox-height: 7;
        fill: ink;
        anti-alias: false;
    }
}

// Mascot picker: the button shows the current mascot's drawing and name; a click opens
// a scrolling grid with all of them (image and name). `images[i]` is the drawing of `options[i]`.
// The grid is aligned to the button's right and uses as many columns as fit up to the
// window's left edge.
export component MascotSelect inherits Rectangle {
    in property <[string]> options;
    in property <[image]> images;
    in property <int> index;
    in property <color> accent: Skin.accent;
    in property <string> label;
    callback chosen(int);
    width: 240px;
    height: 36px;
    border-width: 1px;
    border-color: touch.has-hover ? accent : Skin.field-edge;
    background: Skin.field;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: options[index];
    accessible-action-default => { popup.show(); }

    // keyboard: as in `Select` (the arrows go to the previous or next mascot)
    keys := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == Key.Space {
                popup.show();
                return accept;
            }
            if (e.text == Key.UpArrow || e.text == Key.LeftArrow) && index > 0 {
                root.picked = index - 1;
                return accept;
            }
            if (e.text == Key.DownArrow || e.text == Key.RightArrow) && index < options.length - 1 {
                root.picked = index + 1;
                return accept;
            }
            reject
        }
    }
    if keys.has-focus: FocusRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; ink: accent; }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            MascotThumb { width: 30px; height: 26px; source: images[index]; ink: accent; }
        }
        Text {
            text: options[index];
            color: Skin.ink;
            font-size: 14px * Skin.text-scale;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Icon { icon: Icons.chevron; ink: accent; size: 14px; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    // Same wait as in `Select`: the choice is reported only after the grid has closed.
    property <int> picked: -1;
    changed picked => {
        if picked >= 0 {
            root.chosen(picked);
            picked = -1;
        }
    }

    property <length> tile-w: 66px;
    property <length> tile-h: 66px;
    // space from the window's left side to the button's right edge: the grid fits in it
    property <length> room: self.absolute-position.x + self.width - 12px;
    property <int> cols: max(2, min(5, floor(room / tile-w)));
    property <int> rows: ceil(options.length / cols);
    property <length> full-h: rows * tile-h;
    // at most 4 rows and a bit of the fifth (hints there is more); the rest scrolls
    property <length> list-h: min(full-h, 4.4 * tile-h);
    property <length> grid-w: cols * tile-w;

    popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 2px;
        width: grid-w + 8px;
        height: list-h + 2px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            background: Skin.field;
            border-width: 1px;
            border-color: accent;
            flick := Flickable {
                x: 1px;
                y: 1px;
                width: grid-w;
                height: list-h;
                content-width: self.width;
                content-height: full-h;
                // opens with the current mascot's row in view (one above, for context)
                content-y: -max(0px, min((floor(index / cols) - 1) * tile-h, full-h - list-h));
                for o[i] in options: Rectangle {
                    x: mod(i, cols) * tile-w;
                    y: floor(i / cols) * tile-h;
                    width: tile-w;
                    height: tile-h;
                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        background: i == index ? accent.with-alpha(0.18) : item.has-hover ? Skin.hover : transparent;
                        border-width: i == index ? 1px : 0;
                        border-color: accent;
                    }
                    MascotThumb {
                        x: (parent.width - self.width) / 2;
                        y: 6px;
                        width: 44px;
                        height: 38px;
                        source: images[i];
                        ink: accent;
                    }
                    Text {
                        x: 3px;
                        y: parent.height - 19px;
                        width: parent.width - 6px;
                        text: o;
                        color: i == index ? accent : Skin.ink;
                        font-size: 11px * Skin.text-scale;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.picked = i;
                            popup.close();
                        }
                    }
                }
            }
            // where we are in the grid, when it scrolls
            if full-h > list-h: Rectangle {
                x: parent.width - 5px;
                y: 1px + (-flick.content-y / full-h) * list-h;
                width: 3px;
                height: list-h * (list-h / full-h);
                background: accent.with-alpha(0.55);
            }
        }
    }
}

// Segmented bar.
export component SegBar inherits Rectangle {
    in property <Colors> theme;
    in property <float> value;     // 0..100
    in property <color> tint: theme.visor;
    in property <color> off: theme.muted.with-alpha(0.3);
    in property <int> segments: 20;
    height: 8px;

    HorizontalLayout {
        spacing: 2px;
        for i in segments: Rectangle {
            property <float> lit: (i + 0.5) * 100 / segments;
            background: lit <= value ? tint.with-alpha(0.85)
                : off;
            animate background { duration: 300ms; }
        }
    }
}

// History line. `commands` is an SVG path in a 1000×100 frame (the Path keeps the
// aspect ratio, so the frame is already as wide as the space it shows in).
export component Sparkline inherits Rectangle {
    in property <string> commands;
    in property <color> tint;
    height: 28px;

    Path {
        width: 100%;
        height: 100%;
        commands: root.commands;
        viewbox-width: 1000;
        viewbox-height: 100;
        stroke: tint;
        stroke-width: 1.5px;
        fill: transparent;
    }
}

// Counter tile (RUN / STOP / ERR).
export component Counter inherits Rectangle {
    in property <Colors> theme;
    in property <string> label;
    in property <int> value;
    in property <color> tint;
    width: 64px;
    height: 60px;
    border-width: 1px;
    border-color: value > 0 ? tint : theme.muted.with-alpha(0.7);
    background: value > 0 ? tint.with-alpha(0.1) : transparent;

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: value;
            color: value > 0 ? tint : theme.sub;
            font-family: Skin.font-mono;
            font-size: 22px * Skin.text-scale;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: label;
            color: theme.sub;
            font-family: Skin.font-mono;
            font-size: 10px * Skin.text-scale;
            letter-spacing: 1.4px;
            horizontal-alignment: center;
        }
    }
}

// Search field with a magnifier.
export component SearchBox inherits Rectangle {
    in property <Colors> theme;
    in-out property <string> text;
    in property <string> placeholder: @tr("search…");
    callback edited(string);
    height: 36px;
    border-width: 1px;
    border-color: input.has-focus ? theme.visor : theme.muted.with-alpha(0.7);
    background: theme.bg1.mix(theme.bg0, 0.6);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { icon: Icons.search; ink: theme.sub; size: 14px; weight: 2.4; }
        }
        Rectangle {
            if text == "": Text {
                text: placeholder;
                color: theme.sub.with-alpha(0.8);
                font-family: Skin.font-mono;
                font-size: 13px * Skin.text-scale;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
                height: 100%;
            }
            input := TextInput {
                text <=> root.text;
                color: theme.text;
                font-family: Skin.font-mono;
                font-size: 13px * Skin.text-scale;
                vertical-alignment: center;
                single-line: true;
                accessible-label: placeholder;
                edited => { root.edited(self.text); }
                // the first Esc clears the filter; with the box empty, Esc goes on to the
                // window (which closes the popup)
                key-pressed(e) => {
                    if e.text == Key.Escape && self.text != "" {
                        self.text = "";
                        root.edited("");
                        return accept;
                    }
                    reject
                }
            }
        }
        if text != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                Icon { icon: Icons.close; ink: clear.has-hover ? theme.text : theme.sub; size: 12px; weight: 2.4; }
                clear := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: @tr("Clear the search");
                    accessible-action-default => {
                        root.text = "";
                        root.edited("");
                    }
                    clicked => {
                        root.text = "";
                        root.edited("");
                    }
                }
            }
        }
    }
}

// Window header button, in the skin's style: "icon" (icon with a thin border),
// "bracket" (terminal-like "[ pin ]" text) or "chunky" (light block with a hard shadow and a
// pixel icon).
export component HeaderButton inherits Rectangle {
    in property <string> text;            // name (screen readers and buttons with text)
    in property <string> short: text;     // short label for the "bracket" style
    in property <string> icon;            // 24×24 stroke
    in property <string> px-icon;         // 7×7 pixel ("chunky" style)
    in property <bool> show-text: false;  // shows the text besides the icon
    in property <bool> active: false;     // on (pin)
    in property <bool> danger: false;     // destructive action (quit)
    callback clicked;
    property <string> style: Skin.buttons;
    property <color> tone: danger ? Skin.danger : active ? Skin.accent2 : Skin.panel-sub;
    property <length> shadow: style == "chunky" ? 2px : 0;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }

    property <length> dx: style == "chunky" && touch.pressed ? shadow : 0;
    property <length> pad: style == "bracket" ? 6px : show-text ? 12px : 13px;
    height: (style == "bracket" ? 32px : 36px) + shadow;

    // hard shadow (chunky)
    if style == "chunky": Rectangle {
        x: shadow;
        y: shadow;
        width: parent.width - shadow;
        height: parent.height - shadow;
        background: Skin.edge;
    }
    Rectangle {
        x: dx;
        y: dx;
        width: parent.width - shadow;
        height: parent.height - shadow;
        border-width: style == "bracket" ? 0 : style == "chunky" ? 2px : 1px;
        border-color: style == "chunky" ? Skin.edge : danger ? Skin.danger-edge : active ? Skin.accent2 : Skin.edge;
        background: style == "chunky" ? (touch.has-hover ? Skin.hover : Skin.bg)
            : touch.pressed ? tone.with-alpha(0.22) : touch.has-hover ? tone.with-alpha(0.12) : transparent;
    }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: pad + dx;
        padding-right: pad + shadow - dx;
        padding-top: dx;
        padding-bottom: shadow - dx;
        if style == "bracket": Text {
            text: "[ " + short + " ]";
            color: touch.has-hover ? Skin.panel-ink : active ? Skin.accent : tone;
            font-family: Skin.font-mono;
            font-size: 13px * Skin.text-scale;
            vertical-alignment: center;
        }
        if style == "icon" && icon != "": VerticalLayout {
            alignment: center;
            Icon { icon: root.icon; ink: tone; size: show-text ? 14px : 18px; weight: 2; }
        }
        if style == "chunky" && px-icon != "": VerticalLayout {
            alignment: center;
            Path {
                width: 14px;
                height: 14px;
                commands: px-icon;
                viewbox-width: 7;
                viewbox-height: 7;
                fill: danger ? Skin.danger : active ? Skin.accent2 : Skin.ink;
                anti-alias: false;
            }
        }
        if style != "bracket" && show-text: Text {
            text: root.text;
            color: style == "chunky" ? (danger ? Skin.danger : Skin.ink) : tone;
            font-size: 14px * Skin.text-scale;
            vertical-alignment: center;
        }
    }

    keys := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == Key.Space {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    if keys.has-focus: FocusRing {
        width: parent.width - shadow;
        height: parent.height - shadow;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Round pixel-art arcade button that launches something in the terminal. Drawn on a
// 14 × 14 grid (one `Path` layer per color, no anti-alias), with the base 3 pixels below
// the cap forming the 3D side. On click, the cap sinks into the base in pixel steps,
// lights up and throws square sparks; with "reduce motion" it only sinks.
//
//   ....######....    # outline    + @ highlight
//   ..##+++++o##..    o cap        - bottom shade
//   .#+@@@oooooo#.    > _ icon
//   #+o>>oooooooo#
//   #ooo>>ooooooo#
//   #oooo>>oooooo#
//   #ooo>>ooooooo#
//   #-o>>ooo___o-#
//   #-oooooooooo-#
//   .#--oooooo--#.
//   ..##------##..
//   ....######....
export component LaunchButton inherits Rectangle {
    in property <color> tint: Skin.accent;   // cap color
    in property <color> edge: Skin.edge;     // outline and icon
    in property <length> px: 3px;            // size of one art pixel
    in property <string> label;              // screen readers (the button is icon-only)
    callback clicked;
    width: 14 * px;
    height: (14 + depth) * px;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.fire(); }

    property <int> depth: 3;                 // height of the side, in art pixels
    // click animation: `p` goes from 0 to 1 over `burst`; reads the clock only while animating
    property <bool> bursting;
    property <duration> started;
    property <duration> burst: 450ms;
    property <float> p: bursting ? min(1, max(0, (animation-tick() - started) / burst)) : 1;
    // how far the cap sinks (in art pixels): 2 pressed, 1 at the end of the animation
    property <int> sink: touch.pressed || (bursting && p < 0.3) ? 2 : bursting && p < 0.55 ? 1 : 0;
    property <color> face: bursting && p < 0.45 ? tint.brighter(0.55) : touch.has-hover ? tint.brighter(0.12) : tint;

    // art layers (generated from the drawing above)
    property <string> l-outline: "M4 0h6v1H4zM2 1h2v1H2zM10 1h2v1H10zM1 2h1v1H1zM12 2h1v1H12zM1 3h1v1H1zM12 3h1v1H12zM0 4h1v6H0zM13 4h1v6H13zM1 10h1v2H1zM12 10h1v2H12zM2 12h2v1H2zM10 12h2v1H10zM4 13h6v1H4z";
    property <string> l-inner: "M4 1h6v1H4zM2 2h10v2H2zM1 4h12v6H1zM2 10h10v2H2zM4 12h6v1H4z";
    property <string> l-shade: "M1 8h1v2H1zM12 8h1v2H12zM2 10h2v1H2zM10 10h2v1H10zM2 11h10v1H2zM4 12h6v1H4z";
    property <string> l-light: "M4 1h6v1H4zM2 2h1v1H2zM1 4h1v1H1zM2 3h1v1H2z";
    property <string> l-spec: "M3 2h3v1H3zM3 3h1v1H3z";

    function fire() {
        if !Anim.calm {
            started = animation-tick();
            bursting = true;
        }
        root.clicked();
    }

    Timer {
        interval: burst;
        running: bursting;
        triggered => { bursting = false; }
    }

    // base: the side, which shows below the cap
    Rectangle {
        y: depth * px;
        width: 14 * px;
        height: 14 * px;
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-inner; fill: tint.darker(0.55); }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-outline; fill: edge; }
    }

    // cap
    Rectangle {
        y: sink * px;
        width: 14 * px;
        height: 14 * px;
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-inner; fill: face; }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-shade; fill: face.darker(0.3); }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-light; fill: face.brighter(0.35); }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-spec; fill: white; }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-outline; fill: edge; }
        // ">_"; the cursor blinks while hovered
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: "M3 4h2v1H3zM4 5h2v1H4zM5 6h2v1H5zM4 7h2v1H4zM3 8h2v1H3z"; fill: edge; }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: "M8 8h3v1H8z"; fill: edge;
            opacity: touch.has-hover && !Anim.calm && mod(Anim.frame, 8) >= 4 ? 0 : 1; }
    }

    // sparks: 8 pixels that jump around and fade, snapped to the art grid
    for k in (bursting ? 8 : 0): Rectangle {
        property <angle> a: k * 45deg + 22.5deg;
        property <float> d: 7.5 + p * 6;     // distance from the center, in art pixels
        x: round(7 + cos(a) * d - 0.5) * px;
        y: round(7 + sink + sin(a) * d - 0.5) * px;
        width: px;
        height: px;
        background: mod(k, 2) == 0 ? white : tint.brighter(0.3);
        opacity: p < 0.7 ? 1 : 0.4;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.fire(); }
    }
}
