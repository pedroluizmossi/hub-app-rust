// Componentes reutilizáveis pelos mini-apps e pela moldura. Cantos retos, linhas finas
// e ícones de traço, como no design da Toca.
import { Colors, Moods, Anim, Skin, Icons } from "theme.slint";
import { Chatter } from "chatter.slint";

// Mascote em pixel art. O quadro (piscar, LED, glitch) vem desenhado do Rust;
// flutuar e pular são deslocamentos aqui, sem redesenhar a imagem. `reaction` é uma reação
// curta por cima do humor ("celebrate", "surprised"; ver src/mascot/anim.rs). Cliques na
// mascote chamam `poked` (o Rust decide se vira easter egg). `voice` é o id da mascote na
// conversa entre mascotes ("app:nome", o mesmo do Rust): falando, ela dá pulinhos; ouvindo,
// mostra "..." em cima da cabeça. Sem `voice`, fica fora da conversa.
export component Mascot inherits Rectangle {
    in property <Colors> theme;
    in property <image> frame;
    in property <string> mood: "idle";
    in property <string> reaction;
    in property <bool> moving: !Anim.calm;
    in property <bool> aura: true;
    in property <string> voice;
    callback poked;
    property <bool> talking: voice != "" && voice == Chatter.speaker;
    property <bool> listening: voice != "" && voice == Chatter.listener;
    property <int> f: Anim.frame;
    property <bool> party: reaction == "celebrate";
    property <bool> startled: reaction == "surprised";
    property <color> accent: Moods.color(theme, mood);
    // tamanho de referência (Skin.mascot-size); quem usa a mascote pode dar outra caixa
    preferred-width: Skin.mascot-size;
    preferred-height: Skin.mascot-size * 14 / 16;
    property <float> glow: mood == "alarm" && mod(f, 4) < 2 ? 1.6 : 1;

    // o quadro 16×14 ocupa o maior tamanho que cabe na caixa, sem deformar (escala automática)
    stage := Rectangle {
        width: min(root.width, root.height * 16 / 14);
        height: self.width * 14 / 16;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        // aura neon: anéis concêntricos (o renderizador por software não tem blur)
        if aura && mood != "sleep": Rectangle {
            for k in 3: Rectangle {
                property <float> s: 1.1 - k * 0.2;
                width: stage.width * s;
                height: stage.height * s;
                x: (stage.width - self.width) / 2;
                y: (stage.height - self.height) / 2 + stage.height * 0.05;
                border-radius: min(self.width, self.height) / 2;
                background: accent.with-alpha(0.07 * glow);
            }
        }

        Image {
            source: frame;
            image-rendering: pixelated;
            width: parent.width;
            height: parent.height;
            x: !moving ? 0
                : startled ? (mod(f, 2) == 0 ? -2px : 2px)
                : mood == "alarm" ? (mod(f, 2) == 0 ? -1px : 1px) : 0;
            y: !moving ? 0
                : talking ? (mod(f, 2) == 0 ? -parent.height * 0.08 : 0)
                : party ? (mod(f, 4) < 2 ? -parent.height * 0.24 : 0)
                : startled ? -parent.height * 0.12
                : mood == "busy" || mood == "happy" ? (mod(f, 4) < 2 ? -parent.height * 0.1 : 0)
                : mood == "idle" ? (mod(f, 16) < 8 ? -parent.height * 0.04 : 0)
                : 0;
            animate y { duration: 110ms; easing: ease-out; }
        }

        // "z" do sono / "!" do alarme
        if moving && mood == "sleep": Text {
            text: "z";
            x: parent.width * 0.8;
            y: parent.height * 0.05 - mod(f, 16) * 1px;
            opacity: 1 - mod(f, 16) / 16;
            color: theme.sleep;
            font-size: parent.height * 0.22;
            font-weight: 700;
        }
        if moving && mood == "alarm": Text {
            text: "!";
            x: parent.width * 0.86;
            y: 0;
            color: theme.alarm;
            font-size: parent.height * 0.3;
            font-weight: 900;
            opacity: mod(f, 4) < 2 ? 1 : 0.3;
        }

        // comemoração: faíscas quadradas que sobem e somem, em volta da cabeça
        if party: Rectangle {
            for k in 4: Rectangle {
                property <int> step: mod(f + k * 3, 8);
                property <length> s: max(2px, stage.height * 0.07);
                width: s;
                height: s;
                x: stage.width * (k == 0 ? 0.04 : k == 1 ? 0.84 : k == 2 ? 0.18 : 0.7);
                y: stage.height * (k < 2 ? 0.3 : 0.05) - step * stage.height * 0.035;
                background: mod(k, 2) == 0 ? theme.ok : theme.visor;
                opacity: 1 - step / 8;
            }
        }
        // ouvindo quem fala: "..." em pixel em cima da cabeça (os pontos acendem em sequência)
        if listening: Rectangle {
            for k in 3: Rectangle {
                property <length> s: max(2px, stage.height * 0.08);
                x: stage.width * 0.62 + k * s * 1.6;
                y: -s * 0.5;
                width: s;
                height: s;
                background: theme.visor;
                opacity: !moving || mod(f, 4) >= k ? 1 : 0.25;
            }
        }
        // susto (easter egg): "?" em cima da cabeça
        if startled: Text {
            text: "?";
            x: parent.width * 0.8;
            y: -parent.height * 0.08;
            color: theme.visor;
            font-size: parent.height * 0.32;
            font-weight: 900;
        }
    }

    TouchArea {
        clicked => { root.poked(); }
    }
}

// Ícone de traço num quadro 24×24.
export component Icon inherits Path {
    in property <string> icon;
    in property <color> ink: Skin.sub;
    in property <bool> filled: false;
    in property <length> size: 16px;
    in property <float> weight: 2.2;
    width: size;
    height: size;
    commands: icon;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: filled ? transparent : ink;
    stroke-width: size * weight / 24;
    stroke-line-cap: square;
    fill: filled ? ink : transparent;
}

// Botão quadrado só com ícone (ações dos containers, alfinete, engrenagem).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> ink: Skin.accent;
    in property <color> edge: Skin.edge;
    in property <bool> enabled: true;
    in property <length> icon-size: 16px;
    in property <string> label;   // nome para leitores de tela
    callback clicked;
    width: 44px;
    height: 44px;
    border-width: 1px;
    border-color: edge;
    background: !enabled ? transparent : touch.pressed ? ink.with-alpha(0.22) : touch.has-hover ? ink.with-alpha(0.12) : transparent;
    opacity: enabled ? 1 : 0.35;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if enabled { root.clicked(); } }

    Icon {
        icon: root.icon;
        ink: root.ink;
        size: root.icon-size;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Botão com texto (e ícone opcional) e borda fina.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <color> ink: Skin.accent;
    in property <color> edge: ink;
    in property <color> fill: transparent;   // fundo cheio (botão principal)
    in property <length> font-size: 14px;
    in property <int> font-weight: 600;
    in property <length> letter-spacing: 0;
    in property <bool> compact: false;        // só o ícone
    callback clicked;
    height: 36px;
    min-width: row.preferred-width + 24px;
    horizontal-stretch: 0;
    border-width: fill == transparent ? 1px : 0;
    border-color: edge;
    background: fill != transparent ? (touch.pressed ? fill.darker(0.2) : touch.has-hover ? fill.brighter(0.15) : fill)
        : touch.pressed ? ink.with-alpha(0.22) : touch.has-hover ? ink.with-alpha(0.12) : transparent;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }

    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if icon != "": VerticalLayout {
            alignment: center;
            Icon { icon: root.icon; ink: root.ink; size: 14px; weight: 2.4; }
        }
        if !compact: Text {
            text: root.text;
            color: root.ink;
            font-size: root.font-size;
            font-weight: root.font-weight;
            letter-spacing: root.letter-spacing;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Interruptor quadrado: trilho na cor do acento quando ligado.
export component SqSwitch inherits Rectangle {
    in property <bool> checked;
    in property <color> accent: Skin.accent;
    in property <length> knob: 14px;
    in property <string> label;
    // cores desligado e do pino (dentro de um app, vêm do tema do app)
    in property <color> off-track: Skin.field;
    in property <color> off-edge: Skin.field-edge;
    in property <color> off-knob: Skin.dim;
    in property <color> on-knob: Skin.bg;
    callback toggled;
    width: 40px;
    height: 22px;
    border-width: 1px;
    border-color: checked ? accent : off-edge;
    background: checked ? accent : off-track;
    animate background, border-color { duration: 150ms; }
    accessible-role: switch;
    accessible-checked: checked;
    accessible-label: label;
    accessible-action-default => { root.toggled(); }

    Rectangle {
        width: knob;
        height: knob;
        y: (parent.height - self.height) / 2;
        x: checked ? parent.width - self.width - (parent.height - self.height) / 2 : (parent.height - self.height) / 2;
        background: checked ? on-knob : off-knob;
        animate x { duration: 150ms; easing: ease-in-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Botão − / + de um stepper.
component StepKey inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    in property <bool> enabled: true;
    callback clicked;
    width: 34px;
    background: enabled && touch.has-hover ? Skin.hover : transparent;
    opacity: enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: text == "+" ? "Aumentar" : "Diminuir";
    accessible-action-default => { if enabled { root.clicked(); } }
    Text {
        text: root.text;
        color: root.ink;
        font-family: Skin.font-mono;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Número com − e + dos lados.
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> unit;
    in property <color> accent: Skin.accent;
    in property <color> edge: Skin.field-edge;
    in property <length> value-width: 52px;
    in property <length> font-size: 15px;
    // − e + desligados por fora (ex.: a grade não comporta)
    in property <bool> down-enabled: value > minimum;
    in property <bool> up-enabled: value < maximum;
    callback edited(int);
    height: 34px;
    border-width: 1px;
    border-color: edge;
    background: Skin.field;
    HorizontalLayout {
        padding: 1px;
        StepKey {
            text: "−";
            ink: accent;
            enabled: down-enabled;
            clicked => { root.edited(max(minimum, value - step)); }
        }
        Text {
            width: value-width;
            text: value + unit;
            color: Skin.ink;
            font-family: Skin.font-mono;
            font-size: root.font-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        StepKey {
            text: "+";
            ink: accent;
            enabled: up-enabled;
            clicked => { root.edited(min(maximum, value + step)); }
        }
    }
}

// Lista de escolha: botão com a opção atual e uma lista que abre por baixo.
export component Select inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    in property <color> accent: Skin.accent;
    in property <string> label;
    callback chosen(int);
    width: 240px;
    height: 36px;
    border-width: 1px;
    border-color: touch.has-hover ? accent : Skin.field-edge;
    background: Skin.field;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: options[index];
    accessible-action-default => { popup.show(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: options[index];
            color: Skin.ink;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Icon { icon: Icons.chevron; ink: accent; size: 14px; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    // Opção clicada, à espera de ser avisada. Não dá para chamar `chosen` direto do clique:
    // depois de `popup.close()` a lista já foi destruída e a chamada some sem erro; e
    // antes dele, o Rust pode refazer a lista de configurações e destruir este Select com
    // a lista ainda aberta. O `changed` roda depois do clique, com a lista já fechada.
    property <int> picked: -1;
    changed picked => {
        if picked >= 0 {
            root.chosen(picked);
            picked = -1;
        }
    }

    property <length> item-h: 32px;
    // A lista é desenhada dentro da janela: longa demais (32 mascotes), passaria da borda
    // e as últimas opções não seriam alcançáveis. Mostra no máximo 8 e meia (a meia avisa
    // que há mais) e o resto rola.
    property <length> full-h: options.length * item-h;
    property <length> list-h: min(full-h, 8.5 * item-h);
    // Altura explícita: sem ela o Slint calcula uma área clicável menor que a lista, e um
    // clique na parte de baixo conta como "fora" e fecha a lista sem escolher.
    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        height: list-h + 2px;
        // arrastar para rolar termina num clique dentro da lista: só fecha ao escolher ou clicar fora
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            background: Skin.field;
            border-width: 1px;
            border-color: accent;
            flick := Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: list-h;
                content-width: self.width;
                content-height: full-h;
                // abre com a opção atual à vista (algumas acima dela, para dar contexto)
                content-y: -max(0px, min((index - 3) * item-h, full-h - list-h));
                for o[i] in options: Rectangle {
                    y: i * item-h;
                    width: flick.width;
                    height: item-h;
                    background: i == index ? accent.with-alpha(0.18) : item.has-hover ? Skin.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: o;
                            color: i == index ? accent : Skin.ink;
                            font-size: 14px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    item := TouchArea {
                        mouse-cursor: pointer;
                        // guarda a escolha e fecha; o aviso sai de `changed picked`
                        clicked => {
                            root.picked = i;
                            popup.close();
                        }
                    }
                }
            }
            // onde estamos na lista, quando ela rola
            if full-h > list-h: Rectangle {
                x: parent.width - 4px;
                y: 1px + (-flick.content-y / full-h) * list-h;
                width: 3px;
                height: list-h * (list-h / full-h);
                background: accent.with-alpha(0.55);
            }
        }
    }
}

// Miniatura de uma mascote num seletor. Imagem vazia = opção sem desenho ("Automático"),
// mostrada com um brilho em pixel.
component MascotThumb inherits Rectangle {
    in property <image> source;
    in property <color> ink: Skin.accent;
    if source.width > 0: Image {
        source: root.source;
        image-rendering: pixelated;
        width: min(root.width, root.height * 16 / 14);
        height: self.width * 14 / 16;
    }
    if source.width == 0: Path {
        width: min(root.width, root.height) * 0.6;
        height: self.width;
        commands: "M3 0h1v2H3zM3 5h1v2H3zM0 3h2v1H0zM5 3h2v1H5zM2 2h3v3H2z";
        viewbox-width: 7;
        viewbox-height: 7;
        fill: ink;
        anti-alias: false;
    }
}

// Seletor de mascote: o botão mostra a mascote atual desenhada e o nome; ao clicar, abre
// uma grade com todas (imagem e nome), que rola. `images[i]` é o desenho de `options[i]`.
// A grade fica alinhada à direita do botão e usa quantas colunas couberem até a borda
// esquerda da janela.
export component MascotSelect inherits Rectangle {
    in property <[string]> options;
    in property <[image]> images;
    in property <int> index;
    in property <color> accent: Skin.accent;
    in property <string> label;
    callback chosen(int);
    width: 240px;
    height: 36px;
    border-width: 1px;
    border-color: touch.has-hover ? accent : Skin.field-edge;
    background: Skin.field;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: options[index];
    accessible-action-default => { popup.show(); }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            MascotThumb { width: 30px; height: 26px; source: images[index]; ink: accent; }
        }
        Text {
            text: options[index];
            color: Skin.ink;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Icon { icon: Icons.chevron; ink: accent; size: 14px; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    // Mesma espera do `Select`: a escolha só é avisada depois que a grade fechou.
    property <int> picked: -1;
    changed picked => {
        if picked >= 0 {
            root.chosen(picked);
            picked = -1;
        }
    }

    property <length> tile-w: 66px;
    property <length> tile-h: 66px;
    // espaço do lado esquerdo da janela até a borda direita do botão: a grade cabe nele
    property <length> room: self.absolute-position.x + self.width - 12px;
    property <int> cols: max(2, min(5, floor(room / tile-w)));
    property <int> rows: ceil(options.length / cols);
    property <length> full-h: rows * tile-h;
    // no máximo 4 linhas e um pedaço da quinta (avisa que há mais); o resto rola
    property <length> list-h: min(full-h, 4.4 * tile-h);
    property <length> grid-w: cols * tile-w;

    popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 2px;
        width: grid-w + 8px;
        height: list-h + 2px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            background: Skin.field;
            border-width: 1px;
            border-color: accent;
            flick := Flickable {
                x: 1px;
                y: 1px;
                width: grid-w;
                height: list-h;
                content-width: self.width;
                content-height: full-h;
                // abre com a linha da mascote atual à vista (uma acima, para dar contexto)
                content-y: -max(0px, min((floor(index / cols) - 1) * tile-h, full-h - list-h));
                for o[i] in options: Rectangle {
                    x: mod(i, cols) * tile-w;
                    y: floor(i / cols) * tile-h;
                    width: tile-w;
                    height: tile-h;
                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        background: i == index ? accent.with-alpha(0.18) : item.has-hover ? Skin.hover : transparent;
                        border-width: i == index ? 1px : 0;
                        border-color: accent;
                    }
                    MascotThumb {
                        x: (parent.width - self.width) / 2;
                        y: 6px;
                        width: 44px;
                        height: 38px;
                        source: images[i];
                        ink: accent;
                    }
                    Text {
                        x: 3px;
                        y: parent.height - 19px;
                        width: parent.width - 6px;
                        text: o;
                        color: i == index ? accent : Skin.ink;
                        font-size: 11px;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.picked = i;
                            popup.close();
                        }
                    }
                }
            }
            // onde estamos na grade, quando ela rola
            if full-h > list-h: Rectangle {
                x: parent.width - 5px;
                y: 1px + (-flick.content-y / full-h) * list-h;
                width: 3px;
                height: list-h * (list-h / full-h);
                background: accent.with-alpha(0.55);
            }
        }
    }
}

// Barra segmentada; `part` (ex.: o que é do Docker) aparece por cima.
export component SegBar inherits Rectangle {
    in property <Colors> theme;
    in property <float> value;     // 0..100
    in property <float> part: 0;   // 0..100
    in property <color> tint: theme.visor;
    in property <color> off: theme.muted.with-alpha(0.3);
    in property <int> segments: 20;
    height: 8px;

    HorizontalLayout {
        spacing: 2px;
        for i in segments: Rectangle {
            property <float> lit: (i + 0.5) * 100 / segments;
            background: lit <= part ? tint
                : lit <= value ? tint.with-alpha(0.85)
                : off;
            animate background { duration: 300ms; }
        }
    }
}

// Linha de histórico. `commands` é um caminho SVG num quadro 1000×100 (o Path mantém
// a proporção, então o quadro já é largo como o espaço onde ele aparece).
export component Sparkline inherits Rectangle {
    in property <string> commands;
    in property <color> tint;
    height: 28px;

    Path {
        width: 100%;
        height: 100%;
        commands: root.commands;
        viewbox-width: 1000;
        viewbox-height: 100;
        stroke: tint;
        stroke-width: 1.5px;
        fill: transparent;
    }
}

// Quadro de contador (RUN / STOP / ERR).
export component Counter inherits Rectangle {
    in property <Colors> theme;
    in property <string> label;
    in property <int> value;
    in property <color> tint;
    in property <color> idle-ink: theme.sub;
    width: 64px;
    height: 60px;
    border-width: 1px;
    border-color: value > 0 ? tint : theme.muted.with-alpha(0.7);
    background: value > 0 ? tint.with-alpha(0.1) : transparent;

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: value;
            color: value > 0 ? tint : idle-ink;
            font-family: Skin.font-mono;
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: label;
            color: theme.sub;
            font-family: Skin.font-mono;
            font-size: 10px;
            letter-spacing: 1.4px;
            horizontal-alignment: center;
        }
    }
}

// Campo de busca com lupa.
export component SearchBox inherits Rectangle {
    in property <Colors> theme;
    in-out property <string> text;
    in property <string> placeholder: "buscar…";
    callback edited(string);
    height: 36px;
    border-width: 1px;
    border-color: input.has-focus ? theme.visor : theme.muted.with-alpha(0.7);
    background: theme.bg1.mix(theme.bg0, 0.6);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { icon: Icons.search; ink: theme.sub; size: 14px; weight: 2.4; }
        }
        Rectangle {
            if text == "": Text {
                text: placeholder;
                color: theme.sub.with-alpha(0.8);
                font-family: Skin.font-mono;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
                height: 100%;
            }
            input := TextInput {
                text <=> root.text;
                color: theme.text;
                font-family: Skin.font-mono;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                accessible-label: placeholder;
                edited => { root.edited(self.text); }
            }
        }
    }
}

// Botão do cabeçalho da janela, no estilo do visual: "icon" (ícone com borda fina),
// "bracket" (texto "[ fixar ]", de terminal) ou "chunky" (bloco claro com sombra dura e
// ícone em pixel).
export component HeaderButton inherits Rectangle {
    in property <string> text;            // nome (leitores de tela e botões com texto)
    in property <string> short: text;     // rótulo curto do estilo "bracket"
    in property <string> icon;            // traço 24×24
    in property <string> px-icon;         // pixel 7×7 (estilo "chunky")
    in property <bool> show-text: false;  // mostra o texto além do ícone
    in property <bool> active: false;     // ligado (alfinete)
    in property <bool> danger: false;     // ação destrutiva (sair)
    callback clicked;
    property <string> style: Skin.buttons;
    property <color> tone: danger ? Skin.danger : active ? Skin.accent2 : Skin.panel-sub;
    property <length> shadow: style == "chunky" ? 2px : 0;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }

    property <length> dx: style == "chunky" && touch.pressed ? shadow : 0;
    property <length> pad: style == "bracket" ? 6px : show-text ? 12px : 13px;
    height: (style == "bracket" ? 32px : 36px) + shadow;

    // sombra dura (chunky)
    if style == "chunky": Rectangle {
        x: shadow;
        y: shadow;
        width: parent.width - shadow;
        height: parent.height - shadow;
        background: Skin.edge;
    }
    Rectangle {
        x: dx;
        y: dx;
        width: parent.width - shadow;
        height: parent.height - shadow;
        border-width: style == "bracket" ? 0 : style == "chunky" ? 2px : 1px;
        border-color: style == "chunky" ? Skin.edge : danger ? Skin.danger-edge : active ? Skin.accent2 : Skin.edge;
        background: style == "chunky" ? (touch.has-hover ? Skin.hover : Skin.bg)
            : touch.pressed ? tone.with-alpha(0.22) : touch.has-hover ? tone.with-alpha(0.12) : transparent;
    }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: pad + dx;
        padding-right: pad + shadow - dx;
        padding-top: dx;
        padding-bottom: shadow - dx;
        if style == "bracket": Text {
            text: "[ " + short + " ]";
            color: touch.has-hover ? Skin.panel-ink : active ? Skin.accent : tone;
            font-family: Skin.font-mono;
            font-size: 13px;
            vertical-alignment: center;
        }
        if style == "icon" && icon != "": VerticalLayout {
            alignment: center;
            Icon { icon: root.icon; ink: tone; size: show-text ? 14px : 18px; weight: 2; }
        }
        if style == "chunky" && px-icon != "": VerticalLayout {
            alignment: center;
            Path {
                width: 14px;
                height: 14px;
                commands: px-icon;
                viewbox-width: 7;
                viewbox-height: 7;
                fill: danger ? Skin.danger : active ? Skin.accent2 : Skin.ink;
                anti-alias: false;
            }
        }
        if style != "bracket" && show-text: Text {
            text: root.text;
            color: style == "chunky" ? (danger ? Skin.danger : Skin.ink) : tone;
            font-size: 14px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Botão redondo de fliperama em pixel art, que lança algo no terminal. Desenhado numa
// grade de 14 × 14 (uma camada de `Path` por cor, sem anti-alias), com a base 3 pixels
// abaixo da tampa fazendo a lateral 3D. Ao clicar, a tampa desce na base em degraus de
// pixel, acende e solta faíscas quadradas; com "reduzir movimento" só desce.
//
//   ....######....    # contorno   + @ brilho
//   ..##+++++o##..    o tampa      - sombra de baixo
//   .#+@@@oooooo#.    > _ ícone
//   #+o>>oooooooo#
//   #ooo>>ooooooo#
//   #oooo>>oooooo#
//   #ooo>>ooooooo#
//   #-o>>ooo___o-#
//   #-oooooooooo-#
//   .#--oooooo--#.
//   ..##------##..
//   ....######....
export component LaunchButton inherits Rectangle {
    in property <color> tint: Skin.accent;   // cor da tampa
    in property <color> edge: Skin.edge;     // contorno e ícone
    in property <length> px: 3px;            // tamanho de um pixel da arte
    in property <string> label;              // leitores de tela (o botão só tem ícone)
    callback clicked;
    width: 14 * px;
    height: (14 + depth) * px;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.fire(); }

    property <int> depth: 3;                 // altura da lateral, em pixels da arte
    // animação do clique: `p` vai de 0 a 1 em `burst`; só lê o relógio enquanto anima
    property <bool> bursting;
    property <duration> started;
    property <duration> burst: 450ms;
    property <float> p: bursting ? min(1, max(0, (animation-tick() - started) / burst)) : 1;
    // quanto a tampa desce (em pixels da arte): 2 apertado, 1 no fim da animação
    property <int> sink: touch.pressed || (bursting && p < 0.3) ? 2 : bursting && p < 0.55 ? 1 : 0;
    property <color> face: bursting && p < 0.45 ? tint.brighter(0.55) : touch.has-hover ? tint.brighter(0.12) : tint;

    // camadas da arte (geradas a partir do desenho acima)
    property <string> l-outline: "M4 0h6v1H4zM2 1h2v1H2zM10 1h2v1H10zM1 2h1v1H1zM12 2h1v1H12zM1 3h1v1H1zM12 3h1v1H12zM0 4h1v6H0zM13 4h1v6H13zM1 10h1v2H1zM12 10h1v2H12zM2 12h2v1H2zM10 12h2v1H10zM4 13h6v1H4z";
    property <string> l-inner: "M4 1h6v1H4zM2 2h10v2H2zM1 4h12v6H1zM2 10h10v2H2zM4 12h6v1H4z";
    property <string> l-shade: "M1 8h1v2H1zM12 8h1v2H12zM2 10h2v1H2zM10 10h2v1H10zM2 11h10v1H2zM4 12h6v1H4z";
    property <string> l-light: "M4 1h6v1H4zM2 2h1v1H2zM1 4h1v1H1zM2 3h1v1H2z";
    property <string> l-spec: "M3 2h3v1H3zM3 3h1v1H3z";

    function fire() {
        if !Anim.calm {
            started = animation-tick();
            bursting = true;
        }
        root.clicked();
    }

    Timer {
        interval: burst;
        running: bursting;
        triggered => { bursting = false; }
    }

    // base: a lateral, que aparece embaixo da tampa
    Rectangle {
        y: depth * px;
        width: 14 * px;
        height: 14 * px;
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-inner; fill: tint.darker(0.55); }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-outline; fill: edge; }
    }

    // tampa
    Rectangle {
        y: sink * px;
        width: 14 * px;
        height: 14 * px;
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-inner; fill: face; }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-shade; fill: face.darker(0.3); }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-light; fill: face.brighter(0.35); }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-spec; fill: white; }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: l-outline; fill: edge; }
        // ">_"; o cursor pisca com o mouse em cima
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: "M3 4h2v1H3zM4 5h2v1H4zM5 6h2v1H5zM4 7h2v1H4zM3 8h2v1H3z"; fill: edge; }
        Path { width: 100%; height: 100%; viewbox-width: 14; viewbox-height: 14; anti-alias: false;
            commands: "M8 8h3v1H8z"; fill: edge;
            opacity: touch.has-hover && !Anim.calm && mod(Anim.frame, 8) >= 4 ? 0 : 1; }
    }

    // faíscas: 8 pixels que pulam em volta e somem, presos à grade da arte
    for k in (bursting ? 8 : 0): Rectangle {
        property <angle> a: k * 45deg + 22.5deg;
        property <float> d: 7.5 + p * 6;     // distância do centro, em pixels da arte
        x: round(7 + cos(a) * d - 0.5) * px;
        y: round(7 + sink + sin(a) * d - 0.5) * px;
        width: px;
        height: px;
        background: mod(k, 2) == 0 ? white : tint.brighter(0.3);
        opacity: p < 0.7 ? 1 : 0.4;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.fire(); }
    }
}
