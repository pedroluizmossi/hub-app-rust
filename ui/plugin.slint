// Tela genérica dos plugins da comunidade (src/apps/plugin/mod.rs): mascote, título e a saída
// do comando que o plugin declara. Um plugin não traz tela própria: todos usam esta.
//   baixa (< 200 px): mascote menor e só a 1ª linha da saída
import { Colors, Skin, Icons } from "theme.slint";
import { Mascot, IconButton } from "widgets.slint";

export struct PluginCard {
    // id do plugin (o hub mostra o cartão na célula de mesmo id)
    id: string,
    title: string,
    // saída do comando, já cortada nas linhas que o plugin pediu
    text: string,
    // "atualizado há 12 s · a cada 30 s", ou o erro
    detail: string,
    failed: bool,
    running: bool,
    mascot: image,
    mood: string,
    reaction: string,
    // id da mascote na conversa entre mascotes ("app:nome")
    voice: string,
    // plugin com tela própria: a tela interpretada (src/apps/plugin/view.rs)
    has-view: bool,
    view: component-factory,
}

// Estado de todos os plugins, preenchido pelo Rust.
export global PluginApps {
    in property <[PluginCard]> cards;
    callback poked(string /* id */);
    callback refresh(string /* id */);
}

export component PluginView inherits Rectangle {
    in property <PluginCard> card;
    in property <Colors> theme;
    property <Colors> t: theme;
    property <bool> short: self.height < 200px;
    property <length> mascot-w: short ? Skin.mascot-size * 2 / 3 : Skin.mascot-size;

    // tela própria do plugin, encaixada aqui
    if card.has-view && !card.failed: ComponentContainer {
        component-factory: card.view;
        width: parent.width;
        height: parent.height;
    }

    if !card.has-view || card.failed: HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: mascot-w + 8px;
                height: mascot-w * 14 / 16 + 8px;
                background: card.failed ? t.alarm.with-alpha(0.18) : t.fur.with-alpha(0.1);
                Mascot {
                    theme: t;
                    frame: card.mascot;
                    mood: card.mood;
                    reaction: card.reaction;
                    voice: card.voice;
                    poked => { PluginApps.poked(card.id); }
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: card.title;
                    color: t.sub;
                    font-family: Skin.font-mono;
                    font-size: 12px * Skin.text-scale;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: Icons.refresh;
                    ink: t.sub;
                    edge: t.muted;
                    enabled: !card.running;
                    label: "Atualizar";
                    clicked => { PluginApps.refresh(card.id); }
                }
            }
            Text {
                text: card.text;
                color: card.failed ? t.alarm : t.text;
                font-size: (short ? 15px : 19px) * Skin.text-scale;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: card.detail;
                color: card.failed ? t.alarm : t.sub;
                font-family: Skin.font-mono;
                font-size: 11px * Skin.text-scale;
                wrap: word-wrap;
            }
            // o resto da célula fica livre embaixo (o texto não se espalha até o rodapé)
            Rectangle { vertical-stretch: 1; }
        }
    }
}
