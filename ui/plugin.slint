// Generic screen of community plugins (src/apps/plugin/mod.rs): mascot, title and the
// output of the command the plugin declares. A plugin without its own view uses this one.
//   short (< 200 px): smaller mascot and only the 1st line of the output
import { Colors, Skin, Icons } from "theme.slint";
import { Mascot, IconButton } from "widgets.slint";

export struct PluginCard {
    // plugin id (the hub shows the card in the cell with the same id)
    id: string,
    title: string,
    // command output, already cut to the lines the plugin asked for
    text: string,
    // "updated 12 s ago · every 30 s", or the error
    detail: string,
    failed: bool,
    running: bool,
    mascot: image,
    mood: string,
    reaction: string,
    // mascot id in the chatter between mascots ("app:name")
    voice: string,
    // plugin with its own view: the interpreted view (src/apps/plugin/view.rs)
    has-view: bool,
    view: component-factory,
}

// State of all plugins, filled by Rust.
export global PluginApps {
    in property <[PluginCard]> cards;
    callback poked(string /* id */);
    callback refresh(string /* id */);
}

export component PluginView inherits Rectangle {
    // the pointer is over the app's card (the mascot perks up)
    in property <bool> hovered;
    in property <PluginCard> card;
    in property <Colors> theme;
    property <Colors> t: theme;
    property <bool> short: self.height < 200px;
    property <length> mascot-w: short ? Skin.mascot-size * 2 / 3 : Skin.mascot-size;
    // The view's factory on its own, assigned (not bound). ComponentContainer rebuilds the
    // view whenever its binding gets dirty, even for the same factory, and a binding on
    // `card.view` gets dirty at every change of the card (mascot frame, mood, hover): the
    // view would lose its scroll position and the text being typed. Assigning an equal
    // factory (the same Rc) marks nothing dirty, so the view is only rebuilt when it changes.
    property <component-factory> view;
    init => { root.view = card.view; }
    changed card => { root.view = card.view; }

    // the plugin's own view, embedded here
    if card.has-view && !card.failed: ComponentContainer {
        component-factory: root.view;
        width: parent.width;
        height: parent.height;
    }

    if !card.has-view || card.failed: HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: mascot-w + 8px;
                height: mascot-w * 14 / 16 + 8px;
                background: card.failed ? t.alarm.with-alpha(0.18) : t.fur.with-alpha(0.1);
                Mascot {
                    noticed: root.hovered;
                    theme: t;
                    frame: card.mascot;
                    mood: card.mood;
                    reaction: card.reaction;
                    voice: card.voice;
                    poked => { PluginApps.poked(card.id); }
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: card.title;
                    color: t.sub;
                    font-family: Skin.font-mono;
                    font-size: 12px * Skin.text-scale;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: Icons.refresh;
                    ink: t.sub;
                    edge: t.muted;
                    enabled: !card.running;
                    label: @tr("Refresh");
                    clicked => { PluginApps.refresh(card.id); }
                }
            }
            Text {
                text: card.text;
                color: card.failed ? t.alarm : t.text;
                font-size: (short ? 15px : 19px) * Skin.text-scale;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: card.detail;
                color: card.failed ? t.alarm : t.sub;
                font-family: Skin.font-mono;
                font-size: 11px * Skin.text-scale;
                wrap: word-wrap;
            }
            // the rest of the cell stays free below (the text doesn't spread down to the footer)
            Rectangle { vertical-stretch: 1; }
        }
    }
}
