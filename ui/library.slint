// The Library window (src/hub/library.rs): shaders, app themes, window skins, backdrops
// and mascots, listed the same way. Outside the hub popup (it shows in the taskbar), with
// the skin's own frame like the terminal: drags by the header, resizes by the edges,
// closes with the header button or Esc.
//
// Header: the title and the actions of the whole kind (import, open its folder). Below it
// the kinds, as tabs with how many items each has. Shaders get the Terminal's chain in a
// strip of its own. Then the items of the kind, with a search and a small picture each, and
// the chosen one: preview, what it is, its actions, its adjustments (shaders; in a column
// of their own when the window is wide). The Mascots tab is its own panel
// (ui/mascots.slint, src/hub/mascots.rs) inside the same frame.
import { ScrollView } from "std-widgets.slint";
import { Colors, Skin, Icons } from "theme.slint";
import { TextButton, HeaderButton, SearchBox, IconButton } from "widgets.slint";
import { Bar, Frame, ResizeHandles } from "frame.slint";
import { MascotsPanel, MascotsManager } from "mascots.slint";

export struct LibItem {
    key: string,
    name: string,
    // "built-in" | "yours" (translated by Rust)
    origin: string,
    // why the file did not load ("" = it did)
    error: string,
    // where it is used: "2nd in the Terminal", "Docker, Terminal", "window skin"… ("" = nowhere)
    usage: string,
    // a few of its colors (themes, skins) or a small picture (backdrops), for the list
    swatches: [color],
    thumb: image,
}

// One adjustment of a shader: a number `#define`.
export struct LibParam {
    name: string,
    label: string,
    value: float,
    minimum: float,
    maximum: float,
    step: float,
    integer: bool,
    // differs from the shader's own value
    changed: bool,
}

// One shader of the Terminal's chain, in order.
export struct LibLink {
    key: string,
    name: string,
    // it did not compile (or its file is gone)
    bad: bool,
}

// The colors of a window skin, for its preview.
export struct LibSkin {
    bg: color,
    panel: color,
    edge: color,
    surface: color,
    surface-edge: color,
    field: color,
    field-edge: color,
    ink: color,
    sub: color,
    dim: color,
    accent: color,
    accent-ink: color,
    accent2: color,
}

export global LibraryUi {
    // "shader" | "theme" | "skin" | "backdrop" | "mascot"
    in-out property <string> tab: "shader";
    // how many items each kind has, in the tabs' order
    in property <[int]> counts;
    in property <[LibItem]> items;
    in property <string> selected;
    // the chosen one
    in property <string> name;
    in property <string> origin;
    // "author · license", the file's path, the description
    in property <string> credits;
    in property <string> path;
    in property <string> description;
    in property <string> error;
    // theme and skin colors; a backdrop's picture
    in property <[color]> swatches;
    in property <image> picture;
    // a theme's colors and a mascot drawn in them; a skin's colors
    in property <Colors> theme-colors;
    in property <image> theme-mascot;
    in property <LibSkin> skin-colors;
    // "Add to the Terminal", "Use as the window skin"… ("" = no such action)
    in property <string> use-label;
    in property <bool> can-duplicate;
    in property <bool> can-open;
    in property <bool> can-remove;
    in property <bool> armed-remove;
    in property <[LibParam]> params;
    in property <bool> params-changed;
    // shaders: the Terminal's chain, and whether OpenGL runs (preview and shaders need it)
    in property <[LibLink]> chain;
    in property <bool> gl;
    in property <string> status;
    in property <bool> status-bad;
    callback tab-chosen(string);
    callback select(string /* key */);
    // Up/Down: the previous (-1) or next (1) item of the list
    callback step(int);
    callback filter-edited(string);
    callback use();
    callback chain-move(int /* index */, int /* -1 earlier, 1 later */);
    callback chain-remove(int);
    callback param-edited(string /* name */, float);
    callback param-reset(string);
    callback params-reset();
    callback duplicate();
    callback open-file();
    callback open-folder();
    callback remove();
    callback import();
    // own frame: close, drag by the header, resize by the `dir` edge
    callback close();
    callback start-move();
    callback start-resize(string);
}

// Section title of the detail.
component Heading inherits Text {
    color: Skin.ink;
    font-size: 14px * Skin.text-scale;
    font-weight: 700;
}

// A kind, as a tab under the header, with how many items it has.
component KindTab inherits Rectangle {
    in property <string> key;
    in property <string> label;
    in property <int> count;
    property <bool> on: LibraryUi.tab == key;
    min-height: max(36px, row.preferred-height + 12px);
    background: touch.has-hover && !on ? Skin.hover : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: tab;
        accessible-label: label;
        clicked => { LibraryUi.tab-chosen(key); }
    }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        Text {
            text: label;
            color: on ? Skin.accent : Skin.ink;
            font-size: 14px * Skin.text-scale;
            font-weight: on ? 700 : 400;
            vertical-alignment: center;
        }
        Text {
            text: count;
            color: on ? Skin.accent : Skin.dim;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: 2px;
        background: on ? Skin.accent : transparent;
    }
}

// The small picture of an item: a few colors, a picture, or a mark for a shader.
component Thumb inherits Rectangle {
    in property <LibItem> item;
    width: 40px;
    height: 28px;
    border-width: 1px;
    border-color: item.error != "" ? Skin.bad : Skin.surface-edge;
    background: #0c0c14;
    clip: true;
    if item.swatches.length > 0: HorizontalLayout {
        padding: 1px;
        for c in item.swatches: Rectangle { background: c; }
    }
    if item.swatches.length == 0 && item.thumb.width > 0: Image {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        source: item.thumb;
        image-fit: cover;
    }
    // shaders: a little screen with scanlines
    if item.swatches.length == 0 && item.thumb.width == 0: Rectangle {
        for i in 6: Rectangle {
            y: (i * 4 + 3) * 1px;
            height: 1px;
            background: (item.error != "" ? Skin.bad : Skin.accent).with-alpha(i / 2 == floor(i / 2) ? 0.25 : 0.35);
        }
        Text {
            text: "fx";
            color: item.error != "" ? Skin.bad : Skin.accent;
            font-family: Skin.font-mono;
            font-size: 11px;
            font-weight: 700;
        }
    }
}

component ItemRow inherits Rectangle {
    in property <LibItem> item;
    in property <bool> chosen;
    // clicked: the window takes the keyboard back (Up/Down), even from the search field
    callback picked();
    height: max(44px, row.preferred-height + 8px);
    background: chosen ? Skin.accent.with-alpha(0.16) : touch.has-hover ? Skin.hover : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            LibraryUi.select(item.key);
            root.picked();
        }
    }
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Thumb { item: item; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: item.name;
                color: item.error != "" ? Skin.bad : Skin.ink;
                font-size: 13px * Skin.text-scale;
                font-weight: chosen ? 700 : 400;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 0;
                Text {
                    text: item.error != "" ? @tr("{} · does not load", item.origin) : item.origin;
                    color: item.error != "" ? Skin.bad : Skin.dim;
                    font-family: Skin.font-mono;
                    font-size: 10px * Skin.text-scale;
                }
                if item.usage != "" && item.error == "": Text {
                    text: " · " + item.usage;
                    color: Skin.accent;
                    font-family: Skin.font-mono;
                    font-size: 10px * Skin.text-scale;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
    }
}

// A number on a track: drag or click to set, snapped to `step`.
component ParamSlider inherits Rectangle {
    in property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step;
    in property <string> label;
    callback edited(float);
    property <float> frac: max(0, min(1, (value - minimum) / max(0.000001, maximum - minimum)));
    height: 24px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: value;
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        height: 4px;
        background: Skin.field-edge;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        height: 4px;
        width: parent.width * frac;
        background: Skin.accent;
    }
    Rectangle {
        x: (parent.width - self.width) * frac;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: touch.pressed ? Skin.ink : Skin.accent;
    }
    function set(x: length) {
        if maximum > minimum {
            root.edited(minimum + round(max(0, min(1, x / root.width)) * (maximum - minimum) / step) * step);
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.set(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.set(self.mouse-x);
            }
        }
    }
}

// A few lines that look like a terminal, for the shaders' preview (drawn over in Rust).
// The cursor jumps between the prompt and the top now and then, for the shaders that
// follow it.
component SampleScreen inherits Rectangle {
    background: #0c0c14;
    clip: true;
    // 0: after the prompt; 1: at the top left
    property <int> spot;
    Timer {
        interval: 1.8s;
        running: LibraryUi.tab == "shader";
        triggered => { root.spot = 1 - root.spot; }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        alignment: start;
        for line in [
            { text: "~/projects/miniutils $ cargo run", color: #3df2ff },
            { text: "   Compiling miniutils v0.5.5", color: #39ff14 },
            { text: "    Finished `dev` profile in 2.31s", color: #39ff14 },
            { text: "WARN  shader crt-copy: line 42: 'iPalette' unknown", color: #fff200 },
            { text: "ERROR the quick brown fox jumps over the lazy dog", color: #ff1744 },
            { text: "■ red  ■ green  ■ yellow  ■ blue  ■ magenta  ■ cyan", color: #ff2bd6 },
        ]: Text {
            text: line.text;
            color: line.color;
            font-family: "JetBrains Mono";
            font-size: 13px;
            overflow: clip;
        }
        // the prompt, and where the cursor sits after it
        HorizontalLayout {
            alignment: start;
            Text {
                text: "~/projects/miniutils $ ";
                color: #3df2ff;
                font-family: "JetBrains Mono";
                font-size: 13px;
            }
            home := Rectangle { width: 8px; }
        }
    }
    cursor := Rectangle {
        x: root.spot == 0 ? home.absolute-position.x - root.absolute-position.x : 10px;
        y: root.spot == 0 ? home.absolute-position.y - root.absolute-position.y : 10px;
        width: 8px;
        height: home.height;
        background: #3df2ff.with-alpha(0.7);
    }
    // relative to this screen (the shaders' area), like a terminal's cursor
    out property <length> cursor-x: cursor.x;
    out property <length> cursor-y: cursor.y;
    out property <length> cursor-w: cursor.width;
    out property <length> cursor-h: cursor.height;
}

// One shader of the Terminal's chain: its name (click: choose it), earlier, later, out.
component ChainChip inherits Rectangle {
    in property <LibLink> link;
    in property <int> index;
    in property <int> count;
    property <bool> chosen: link.key == LibraryUi.selected;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: link.bad ? Skin.bad : chosen ? Skin.accent : Skin.surface-edge;
    background: chosen ? Skin.accent.with-alpha(0.12) : Skin.surface;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 2px;
        IconButton {
            width: 22px;
            height: 22px;
            icon-size: 12px;
            icon: Icons.chevron-left;
            enabled: index > 0;
            label: @tr("Earlier in the chain");
            clicked => { LibraryUi.chain-move(index, -1); }
        }
        Rectangle {
            width: min(name.preferred-width + 8px, 180px);
            name := Text {
                width: parent.width - 8px;
                text: (index + 1) + ". " + link.name;
                color: link.bad ? Skin.bad : chosen ? Skin.accent : Skin.ink;
                font-size: 12px * Skin.text-scale;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { LibraryUi.select(link.key); }
            }
        }
        IconButton {
            width: 22px;
            height: 22px;
            icon-size: 12px;
            icon: Icons.chevron-right;
            enabled: index + 1 < count;
            label: @tr("Later in the chain");
            clicked => { LibraryUi.chain-move(index, 1); }
        }
        IconButton {
            width: 22px;
            height: 22px;
            icon-size: 12px;
            icon: Icons.close;
            ink: Skin.bad;
            label: @tr("Remove from the Terminal");
            clicked => { LibraryUi.chain-remove(index); }
        }
    }
}

// The Terminal's chain, in the order the shaders run.
component ChainStrip inherits Rectangle {
    border-width: 1px;
    border-color: Skin.surface-edge;
    background: Skin.surface;
    min-height: max(40px, row.preferred-height);
    row := HorizontalLayout {
        padding: 6px;
        padding-left: 10px;
        spacing: 6px;
        Text {
            text: @tr("Terminal:");
            color: Skin.sub;
            font-size: 12px * Skin.text-scale;
            vertical-alignment: center;
        }
        if LibraryUi.chain.length == 0: Text {
            text: @tr("no shaders yet. Choose one and click \"Add to the Terminal\".");
            color: Skin.dim;
            font-size: 12px * Skin.text-scale;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        for link[i] in LibraryUi.chain: HorizontalLayout {
            spacing: 6px;
            horizontal-stretch: 0;
            if i > 0: Text {
                text: "→";
                color: Skin.dim;
                vertical-alignment: center;
            }
            ChainChip {
                link: link;
                index: i;
                count: LibraryUi.chain.length;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if !LibraryUi.gl: Text {
            text: @tr("needs the OpenGL renderer");
            color: Skin.bad;
            font-size: 12px * Skin.text-scale;
            vertical-alignment: center;
        }
    }
}

// An app drawn in a theme's colors: how the theme looks.
component ThemeCard inherits Rectangle {
    property <Colors> t: LibraryUi.theme-colors;
    width: 340px;
    height: card.preferred-height;
    background: t.bg0.mix(t.bg1, 0.75);
    border-width: 1px;
    border-color: t.muted.mix(t.bg0, 0.55);
    card := VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Image {
                source: LibraryUi.theme-mascot;
                image-rendering: pixelated;
                width: 48px;
                height: 42px;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: @tr("Sample app");
                    color: t.text;
                    font-size: 15px * Skin.text-scale;
                    font-weight: 700;
                }
                Text {
                    text: @tr("This is how an app looks in this theme.");
                    color: t.sub;
                    font-size: 11px * Skin.text-scale;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for p in [{ label: @tr("Happy"), c: t.ok }, { label: @tr("Busy"), c: t.warn }, { label: @tr("Alarm"), c: t.alarm }, { label: @tr("Sleeping"), c: t.sleep }]: Rectangle {
                border-width: 1px;
                border-color: p.c;
                background: p.c.with-alpha(0.14);
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Text {
                        text: p.label;
                        color: p.c;
                        font-family: Skin.font-mono;
                        font-size: 10px * Skin.text-scale;
                    }
                }
            }
        }
        Rectangle {
            height: 6px;
            background: t.muted.with-alpha(0.35);
            Rectangle {
                x: 0;
                width: parent.width * 0.62;
                background: t.visor;
            }
        }
    }
}

// A small window in a skin's colors: how the skin looks.
component SkinCard inherits Rectangle {
    property <LibSkin> s: LibraryUi.skin-colors;
    width: 340px;
    height: 190px;
    background: s.bg;
    border-width: 1px;
    border-color: s.edge;
    VerticalLayout {
        padding: 1px;
        Rectangle {
            height: 30px;
            background: s.panel;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                Text {
                    text: "MiniUtils";
                    color: s.ink;
                    font-size: 13px * Skin.text-scale;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                for c in [s.accent, s.accent2]: VerticalLayout {
                    alignment: center;
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: c; }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: s.edge;
            }
        }
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Rectangle {
                height: 26px;
                background: s.field;
                border-width: 1px;
                border-color: s.field-edge;
                Text {
                    x: 8px;
                    text: @tr("Search");
                    color: s.dim;
                    font-size: 11px * Skin.text-scale;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                background: s.surface;
                border-width: 1px;
                border-color: s.surface-edge;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: @tr("Sample app");
                            color: s.ink;
                            font-size: 12px * Skin.text-scale;
                            font-weight: 700;
                        }
                        Text {
                            text: @tr("This is how an app looks in this theme.");
                            color: s.sub;
                            font-size: 10px * Skin.text-scale;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            background: s.accent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                Text {
                                    text: @tr("Close");
                                    color: s.accent-ink;
                                    font-size: 11px * Skin.text-scale;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// What the chosen item is: name, origin, error, its look, the actions and the last message.
component Info inherits VerticalLayout {
    alignment: start;
    spacing: 10px;

    if LibraryUi.selected == "": Text {
        text: @tr("Nothing here matches the search.");
        color: Skin.sub;
    }

    if LibraryUi.selected != "": VerticalLayout {
        spacing: 2px;
        Text {
            text: LibraryUi.name;
            color: Skin.ink;
            font-size: 17px * Skin.text-scale;
            font-weight: 700;
            wrap: word-wrap;
        }
        Text {
            text: LibraryUi.credits == "" ? LibraryUi.origin : LibraryUi.origin + " · " + LibraryUi.credits;
            color: Skin.dim;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            wrap: word-wrap;
        }
        if LibraryUi.path != "": Text {
            text: LibraryUi.path;
            color: Skin.dim;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            wrap: word-wrap;
        }
        if LibraryUi.description != "": Text {
            text: LibraryUi.description;
            color: Skin.sub;
            font-size: 13px * Skin.text-scale;
            wrap: word-wrap;
        }
    }

    // every action of the chosen one, in one row: the main one first
    if LibraryUi.selected != "": HorizontalLayout {
        spacing: 8px;
        alignment: start;
        if LibraryUi.use-label != "": TextButton {
            text: LibraryUi.use-label;
            fill: Skin.accent;
            ink: Skin.accent-ink;
            edge: Skin.accent;
            font-size: 12px * Skin.text-scale;
            clicked => { LibraryUi.use(); }
        }
        if LibraryUi.can-duplicate: TextButton {
            text: @tr("Copy to edit");
            icon: Icons.copy;
            font-size: 12px * Skin.text-scale;
            clicked => { LibraryUi.duplicate(); }
        }
        if LibraryUi.can-open: TextButton {
            text: @tr("Open file");
            font-size: 12px * Skin.text-scale;
            clicked => { LibraryUi.open-file(); }
        }
        if LibraryUi.can-remove: TextButton {
            text: LibraryUi.armed-remove ? @tr("Confirm removal") : @tr("Remove");
            icon: Icons.close;
            ink: Skin.bad;
            font-size: 12px * Skin.text-scale;
            clicked => { LibraryUi.remove(); }
        }
    }

    if LibraryUi.status != "": Text {
        text: LibraryUi.status;
        color: LibraryUi.status-bad ? Skin.bad : Skin.accent;
        font-family: Skin.font-mono;
        font-size: 12px * Skin.text-scale;
        wrap: word-wrap;
    }

    if LibraryUi.error != "": Rectangle {
        border-width: 1px;
        border-color: Skin.bad;
        background: Skin.bad.with-alpha(0.08);
        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            Text {
                text: LibraryUi.tab == "shader" ? @tr("Does not compile:") : @tr("Does not load:");
                color: Skin.bad;
                font-weight: 700;
                font-size: 13px * Skin.text-scale;
            }
            Text {
                text: LibraryUi.error;
                color: Skin.ink;
                font-family: Skin.font-mono;
                font-size: 11px * Skin.text-scale;
                wrap: word-wrap;
            }
        }
    }

    // how it looks: an app in the theme, a window in the skin, the backdrop's picture
    if LibraryUi.selected != "" && LibraryUi.error == "" && LibraryUi.tab == "theme": HorizontalLayout {
        alignment: start;
        ThemeCard { }
    }
    if LibraryUi.selected != "" && LibraryUi.error == "" && LibraryUi.tab == "skin": HorizontalLayout {
        alignment: start;
        SkinCard { }
    }
    if LibraryUi.swatches.length > 0: HorizontalLayout {
        spacing: 4px;
        alignment: start;
        for c in LibraryUi.swatches: Rectangle {
            width: 22px;
            height: 22px;
            background: c;
            border-width: 1px;
            border-color: Skin.surface-edge;
        }
    }
    if LibraryUi.tab == "backdrop" && LibraryUi.selected != "" && LibraryUi.error == "": Rectangle {
        height: 200px;
        border-width: 1px;
        border-color: Skin.surface-edge;
        Image {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            source: LibraryUi.picture;
            image-fit: cover;
        }
    }
}

// The shader's adjustments: its number #defines.
component Params inherits VerticalLayout {
    alignment: start;
    spacing: 4px;
    HorizontalLayout {
        min-height: 30px;
        Heading { text: @tr("Adjustments"); horizontal-stretch: 1; vertical-alignment: center; }
        if LibraryUi.params-changed: TextButton {
            text: @tr("Reset all");
            font-size: 12px * Skin.text-scale;
            clicked => { LibraryUi.params-reset(); }
        }
    }
    for p in LibraryUi.params: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: p.label;
                color: Skin.sub;
                font-size: 12px * Skin.text-scale;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            Text {
                text: p.integer ? round(p.value) : round(p.value * 1000) / 1000;
                color: p.changed ? Skin.accent : Skin.ink;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
            }
            if p.changed: IconButton {
                width: 22px;
                height: 22px;
                icon-size: 12px;
                icon: Icons.reset;
                label: @tr("Back to the shader's value");
                clicked => { LibraryUi.param-reset(p.name); }
            }
        }
        ParamSlider {
            value: p.value;
            minimum: p.minimum;
            maximum: p.maximum;
            step: p.step;
            label: p.label;
            edited(v) => { LibraryUi.param-edited(p.name, v); }
        }
    }
}

export component LibraryWindow inherits Window {
    // where the shader preview is, for `library::postfx` (logical px, window coordinates)
    out property <length> preview-x: sample.absolute-position.x;
    out property <length> preview-y: sample.absolute-position.y;
    out property <length> preview-width: sample.width;
    out property <length> preview-height: sample.height;
    out property <bool> preview-shown: LibraryUi.tab == "shader" && LibraryUi.selected != "" && LibraryUi.gl;
    out property <length> preview-cursor-x: sample.cursor-x;
    out property <length> preview-cursor-y: sample.cursor-y;
    out property <length> preview-cursor-w: sample.cursor-w;
    out property <length> preview-cursor-h: sample.cursor-h;
    out property <bool> focused: keys.has-focus;

    title: @tr("Library");
    preferred-width: 1000px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 460px;
    no-frame: true;
    background: transparent;
    default-font-family: Skin.font-ui;
    default-font-size: 13px * Skin.text-scale;

    // room for a second column (the adjustments, a mascot's editing) and the shader
    // preview's height. Set when the size changes: a binding on it would loop through the
    // layout it changes.
    property <bool> roomy;
    property <length> preview-tall: 150px;
    function fit() {
        self.roomy = self.width >= 1100px;
        self.preview-tall = max(150px, min(300px, self.height * 0.36));
    }
    init => { self.fit(); }
    changed width => { self.fit(); }
    changed height => { self.fit(); }

    // Rust calls this when the window is shown again
    public function focus-list() {
        keys.focus();
    }

  keys := FocusScope {
    init => { self.focus(); }
    key-pressed(e) => {
        if e.text == Key.Escape {
            LibraryUi.close();
            return accept;
        }
        if LibraryUi.tab != "mascot" && e.text == Key.UpArrow {
            LibraryUi.step(-1);
            return accept;
        }
        if LibraryUi.tab != "mascot" && e.text == Key.DownArrow {
            LibraryUi.step(1);
            return accept;
        }
        reject
    }

    Frame { }

    VerticalLayout {
        padding: Skin.border;

        // header: drags the window; the actions of the whole kind
        Bar {
            TouchArea {
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                        LibraryUi.start-move();
                    }
                }
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: @tr("Library");
                    color: Skin.panel-ink;
                    font-family: Skin.font-title;
                    font-size: 16px * Skin.text-scale;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if LibraryUi.tab != "mascot": VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Import…");
                        icon: Icons.plus;
                        font-size: 12px * Skin.text-scale;
                        clicked => { LibraryUi.import(); }
                    }
                }
                if LibraryUi.tab == "mascot": VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Import folder…");
                        icon: Icons.plus;
                        font-size: 12px * Skin.text-scale;
                        enabled: !MascotsManager.busy;
                        clicked => { MascotsManager.import-folder(); }
                    }
                }
                if LibraryUi.tab == "mascot": VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Import .zip…");
                        icon: Icons.plus;
                        font-size: 12px * Skin.text-scale;
                        enabled: !MascotsManager.busy;
                        clicked => { MascotsManager.import-zip(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Open folder");
                        font-size: 12px * Skin.text-scale;
                        clicked => { LibraryUi.open-folder(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HeaderButton {
                        text: @tr("Close");
                        short: @tr("close");
                        icon: Icons.close;
                        px-icon: Icons.px-close;
                        clicked => { LibraryUi.close(); }
                    }
                }
            }
        }

        // the kinds
        Rectangle {
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;
                alignment: start;
                KindTab { key: "shader"; label: @tr("Shaders"); count: LibraryUi.counts[0]; }
                KindTab { key: "theme"; label: @tr("App themes"); count: LibraryUi.counts[1]; }
                KindTab { key: "skin"; label: @tr("Window skins"); count: LibraryUi.counts[2]; }
                KindTab { key: "backdrop"; label: @tr("Backdrops"); count: LibraryUi.counts[3]; }
                KindTab { key: "mascot"; label: @tr("Mascots"); count: LibraryUi.counts[4]; }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Skin.surface-edge;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            padding: 12px;
            spacing: 10px;

            if LibraryUi.tab == "shader": ChainStrip { }

            Rectangle {
                vertical-stretch: 1;

                if LibraryUi.tab == "mascot": MascotsPanel {
                    width: parent.width;
                    height: parent.height;
                    roomy: root.roomy;
                }

                body := HorizontalLayout {
                    visible: LibraryUi.tab != "mascot";
                    width: parent.width;
                    height: parent.height;
                    spacing: 12px;
                    // the adjustments get a column of their own when there is room (from the
                    // window's width: the layout's own would loop through its columns)
                    property <bool> wide: LibraryUi.params.length > 0 && root.roomy;

                    // the items of the kind
                    VerticalLayout {
                        width: min(260px * Skin.text-scale, 340px);
                        spacing: 6px;
                        SearchBox {
                            theme: MascotsManager.theme;
                            placeholder: @tr("Search");
                            edited(text) => { LibraryUi.filter-edited(text); }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            border-width: 1px;
                            border-color: Skin.surface-edge;
                            background: Skin.surface;
                            ScrollView {
                                VerticalLayout {
                                    alignment: start;
                                    for it in LibraryUi.items: ItemRow {
                                        item: it;
                                        chosen: it.key == LibraryUi.selected;
                                        picked => { keys.focus(); }
                                    }
                                }
                            }
                        }
                    }

                    // the chosen one: preview (shaders), what it is and the adjustments, in
                    // a column of their own when there is room. Placed by hand inside a plain
                    // rectangle: as layout children their widest sizes would cap the window's.
                    Rectangle {
                      horizontal-stretch: 1;
                      property <length> side: body.wide ? 432px : 0px;
                      detail := VerticalLayout {
                        x: 0;
                        y: 0;
                        width: min(760px, parent.width - parent.side);
                        height: parent.height;
                        spacing: 10px;

                        // shaders: the preview, drawn over by the shader with its adjustments
                        // (not inside the scrolling part: the drawing would not follow it)
                        HorizontalLayout {
                            property <bool> shown: LibraryUi.tab == "shader" && LibraryUi.selected != "";
                            visible: shown;
                            height: shown ? root.preview-tall : 0px;
                            Rectangle {
                                horizontal-stretch: 1;
                                max-width: 760px;
                                border-width: 1px;
                                border-color: Skin.surface-edge;
                                sample := SampleScreen {
                                    x: 1px;
                                    y: 1px;
                                    width: parent.width - 2px;
                                    height: max(0px, parent.height - 2px);
                                }
                                if !LibraryUi.gl: Rectangle {
                                    background: Skin.bg.with-alpha(0.85);
                                    Text {
                                        width: parent.width - 32px;
                                        text: @tr("The preview and the shaders need the OpenGL renderer: Settings › System › Renderer.");
                                        color: Skin.ink;
                                        font-size: 13px * Skin.text-scale;
                                        wrap: word-wrap;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 14px;
                                padding-right: 8px;
                                Info { }
                                if !body.wide && LibraryUi.params.length > 0: Params { }
                            }
                        }
                      }

                      if body.wide: ScrollView {
                        x: detail.width + 12px;
                        y: 0;
                        width: 420px;
                        height: parent.height;
                        Params { padding-right: 8px; }
                      }
                    }
                }
            }
        }
    }

    ResizeHandles {
        start(dir) => { LibraryUi.start-resize(dir); }
    }
  }
}
