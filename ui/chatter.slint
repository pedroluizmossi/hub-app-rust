// Chatter between mascots: the current line (filled by Rust, src/hub/chatter.rs) and the
// dialog box that shows up in the speaker's app.
import { Colors, Anim, Skin } from "theme.slint";

export global Chatter {
    in property <string> app;        // id of the speaker's app ("" = nobody talking)
    in property <int> seq;           // changes with every new line
    in property <string> name;       // "CPU", "Docker", "Claude"
    in property <string> text;       // the part already "typed"
    in property <bool> done;         // finished typing
    in property <image> portrait;    // the mascot's portrait
    in property <Colors> theme;      // theme of the speaker's app
    // who speaks and who listens, as "app:name" (e.g. "cyber.vitals:CPU"): the on-screen
    // mascot with that id bounces while speaking, or shows that it is listening
    in property <string> speaker;
    in property <string> listener;
    callback skip();                 // click on the box: skips the line
}

// Pixel dialog box, RPG style: double border, the mascot's portrait in a frame, the name
// and the line being typed. When it finishes, a triangle blinks in the corner. Slides in
// from below; a click skips the line.
export component SpeechBox inherits Rectangle {
    property <Colors> t: Chatter.theme;
    property <length> line: 2px;
    property <length> face: 44px;
    height: 66px;

    // entrance: rises a few pixels and fades in
    in-out property <length> rise: 10px;
    init => { rise = 0; }
    animate rise { duration: 160ms; easing: ease-out; }
    opacity: 1 - rise / 10px;

    accessible-role: text;
    accessible-label: Chatter.name + ": " + Chatter.text;

    // hard shadow
    Rectangle {
        x: 3px;
        y: 3px + rise;
        width: parent.width - 3px;
        height: parent.height - 3px;
        background: black.with-alpha(0.45);
    }

    box := Rectangle {
        y: rise;
        width: parent.width - 3px;
        height: parent.height - 3px;
        background: t.text;           // outer border (light)
        Rectangle {
            x: line;
            y: line;
            width: parent.width - 2 * line;
            height: parent.height - 2 * line;
            background: t.bg0;
            // inner border (thin), the second line of the double border
            Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-width: 1px;
                border-color: t.muted.with-alpha(0.7);
            }

            // portrait: square frame; the mascot wobbles while "talking"
            Rectangle {
                x: 8px;
                y: (parent.height - face) / 2;
                width: face;
                height: face;
                background: t.text;
                Rectangle {
                    x: line;
                    y: line;
                    width: parent.width - 2 * line;
                    height: parent.height - 2 * line;
                    background: t.bg1;
                    Image {
                        source: Chatter.portrait;
                        image-rendering: pixelated;
                        // an imported mascot may not be 16×14: fit without distorting
                        image-fit: contain;
                        width: parent.width - 4px;
                        height: self.width * 14 / 16;
                        x: 2px;
                        y: (parent.height - self.height) / 2
                            + (!Chatter.done && !Anim.calm && mod(Anim.frame, 2) == 0 ? -1px : 0);
                    }
                }
            }

            VerticalLayout {
                x: 8px + face + 10px;
                width: parent.width - self.x - 18px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 2px;
                Text {
                    text: Chatter.name;
                    color: t.visor;
                    font-family: Skin.font-mono;
                    font-size: 12px * Skin.text-scale;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    vertical-stretch: 1;
                    text: Chatter.text;
                    color: t.text;
                    font-size: 13px * Skin.text-scale;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            // finished: pixel triangle blinking in the corner
            if Chatter.done: Path {
                x: parent.width - 16px;
                y: parent.height - 11px;
                width: 10px;
                height: 6px;
                commands: "M0 0h5v1H0zM1 1h3v1H1zM2 2h1v1H2z";
                viewbox-width: 5;
                viewbox-height: 3;
                fill: t.visor;
                anti-alias: false;
                opacity: Anim.calm || mod(Anim.frame, 4) < 2 ? 1 : 0;
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { Chatter.skip(); }
    }
}
