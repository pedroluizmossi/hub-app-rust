// Navigation between dashboard pages: an upright bar on the left or right (Rail), a bar
// at the bottom (PageBar) or tabs in the header (TopTabs). Chosen in Appearance › Pages.
import { ScrollView } from "std-widgets.slint";
import { Skin, Icons, Moods } from "theme.slint";
import { Icon } from "widgets.slint";
import { PageInfo } from "models.slint";

// An item of the page bar: the mascot (or an icon) in a tile and the name below.
// `edge` is the window side the bar sits against ("left", "right" or "bottom"): the open
// page's marker goes on that side, flush with the edge.
component RailItem inherits Rectangle {
    in property <image> icon;
    in property <string> icon-path;   // 24×24 stroke, when there is no image
    in property <string> px-icon;     // 7×7 pixel, for the "chunky" buttons
    in property <string> text;
    in property <bool> show-text: true;
    in property <bool> selected;
    in property <bool> ghost;         // "new page": only the tile outline
    in property <string> edge: "left";
    in property <color> badge: transparent;
    callback clicked;
    // doesn't stretch: the bar's leftover space goes between the pages and the settings
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selected: selected;
    accessible-action-default => { root.clicked(); }

    property <bool> hover: touch.has-hover;
    property <color> ink: selected ? Skin.panel-ink : hover ? Skin.panel-ink : Skin.panel-sub;
    property <length> tile-w: 40px;
    property <length> tile-h: 34px;
    property <length> pad: 5px;
    property <length> mark: 3px;      // thickness of the open page's marker

    VerticalLayout {
        padding-top: pad;
        padding-bottom: pad;
        padding-left: 4px;
        padding-right: 4px;
        spacing: 3px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            tile := Rectangle {
                width: tile-w;
                height: tile-h;
                background: selected ? Skin.accent.with-alpha(touch.pressed ? 0.24 : 0.16)
                    : touch.pressed ? Skin.panel-ink.with-alpha(0.14)
                    : hover ? Skin.panel-ink.with-alpha(0.08) : transparent;
                border-width: 1px;
                border-color: selected ? Skin.accent
                    : ghost ? Skin.panel-sub.with-alpha(hover ? 0.55 : 0.28) : transparent;
                animate background, border-color { duration: 120ms; }

                if icon-path == "" && px-icon == "": Image {
                    source: icon;
                    image-rendering: pixelated;
                    width: 32px;
                    height: 28px;
                }
                if icon-path != "" && (Skin.buttons != "chunky" || px-icon == ""): Icon {
                    icon: icon-path;
                    ink: root.ink;
                    size: ghost ? 18px : 20px;
                    weight: 2;
                }
                if px-icon != "" && Skin.buttons == "chunky": Path {
                    width: 14px;
                    height: 14px;
                    commands: px-icon;
                    viewbox-width: 7;
                    viewbox-height: 7;
                    fill: root.ink;
                    anti-alias: false;
                }
                // page alert: in the tile's corner, over the border
                if badge != transparent: Rectangle {
                    x: parent.width - 6px;
                    y: -2px;
                    width: 8px;
                    height: 8px;
                    background: badge;
                    border-width: 1px;
                    border-color: Skin.panel;
                }
            }
        }
        if show-text: Text {
            text: root.text;
            color: root.ink;
            font-family: Skin.buttons == "bracket" ? Skin.font-mono : Skin.font-ui;
            font-size: 10px * Skin.text-scale;
            font-weight: selected ? 700 : 400;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    // marker of the open page, flush with the window edge
    if selected && edge != "bottom": Rectangle {
        x: edge == "left" ? 0 : parent.width - mark;
        y: pad;
        width: mark;
        height: tile-h;
        background: Skin.accent;
    }
    if selected && edge == "bottom": Rectangle {
        x: (parent.width - tile-w) / 2;
        y: parent.height - mark;
        width: tile-w;
        height: mark;
        background: Skin.accent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Upright page bar, on the left (`edge: "left"`) or right of the window: the pages
// on top, scrolling if they don't fit; settings at the bottom.
export component Rail inherits Rectangle {
    in property <[PageInfo]> pages;
    in property <int> current;          // open page
    in property <bool> settings;        // the settings are open
    in property <string> edge: "left";  // "left" | "right"
    callback selected(int);
    callback add();
    callback open-settings();
    width: 68px;
    background: Skin.panel;
    // line on the content side, like the header's
    Rectangle { x: edge == "left" ? parent.width - 1px : 0; width: 1px; background: Skin.line; }

    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 4px;
        padding-left: edge == "right" ? 1px : 0;
        padding-right: edge == "left" ? 1px : 0;
        spacing: 4px;
        list := Flickable {
            vertical-stretch: 1;
            interactive: true;
            content-height: max(self.height, col.preferred-height);
            col := VerticalLayout {
                width: list.width;
                alignment: start;
                spacing: 2px;
                for p[i] in pages: RailItem {
                    edge: root.edge;
                    icon: p.icon;
                    text: p.name;
                    selected: !settings && i == current;
                    badge: p.mood == "alarm" ? Skin.bad : p.mood == "busy" ? Moods.color(p.theme, "busy") : transparent;
                    clicked => { root.selected(i); }
                }
                RailItem {
                    edge: root.edge;
                    icon-path: Icons.plus;
                    px-icon: Icons.px-plus;
                    text: @tr("New page");
                    show-text: false;
                    ghost: true;
                    clicked => { root.add(); }
                }
            }
        }
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            Rectangle { height: 1px; background: Skin.line; }
        }
        RailItem {
            edge: root.edge;
            icon-path: Icons.gear;
            px-icon: Icons.px-gear;
            text: @tr("config");
            selected: settings;
            clicked => { root.open-settings(); }
        }
    }
}

// Horizontal page bar, at the bottom of the window: the pages from left to right,
// scrolling sideways if they don't fit; settings at the right end.
export component PageBar inherits Rectangle {
    in property <[PageInfo]> pages;
    in property <int> current;
    in property <bool> settings;
    callback selected(int);
    callback add();
    callback open-settings();
    background: Skin.panel;
    Rectangle { y: 0; height: 1px; background: Skin.line; }

    HorizontalLayout {
        padding-top: 1px;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        list := Flickable {
            horizontal-stretch: 1;
            interactive: true;
            content-width: max(self.width, row.preferred-width);
            row := HorizontalLayout {
                height: list.height;
                alignment: start;
                spacing: 2px;
                for p[i] in pages: RailItem {
                    width: 64px;
                    edge: "bottom";
                    icon: p.icon;
                    text: p.name;
                    selected: !settings && i == current;
                    badge: p.mood == "alarm" ? Skin.bad : p.mood == "busy" ? Moods.color(p.theme, "busy") : transparent;
                    clicked => { root.selected(i); }
                }
                RailItem {
                    width: 52px;
                    edge: "bottom";
                    icon-path: Icons.plus;
                    px-icon: Icons.px-plus;
                    text: @tr("New page");
                    show-text: false;
                    ghost: true;
                    clicked => { root.add(); }
                }
            }
        }
        VerticalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            Rectangle { width: 1px; background: Skin.line; }
        }
        RailItem {
            width: 64px;
            edge: "bottom";
            icon-path: Icons.gear;
            px-icon: Icons.px-gear;
            text: @tr("config");
            selected: settings;
            clicked => { root.open-settings(); }
        }
    }
}

// A page tab in the header: small mascot and name; underlined when open.
component TopTab inherits Rectangle {
    in property <image> icon;
    in property <string> icon-path;
    in property <string> text;
    in property <bool> selected;
    in property <color> badge: transparent;
    callback clicked;
    height: 36px;
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selected: selected;
    accessible-action-default => { root.clicked(); }
    background: selected ? Skin.panel-ink.with-alpha(0.16) : touch.has-hover ? Skin.panel-ink.with-alpha(0.08) : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            if icon-path == "": Image { source: icon; image-rendering: pixelated; width: 24px; height: 21px; }
            if icon-path != "": Icon { icon: icon-path; ink: Skin.panel-sub; size: 16px; }
        }
        if text != "": Text {
            text: root.text;
            color: selected ? Skin.panel-ink : Skin.panel-sub;
            font-size: 13px * Skin.text-scale;
            vertical-alignment: center;
        }
    }
    if selected: Rectangle { y: parent.height - 2px; height: 2px; background: Skin.accent; }
    if badge != transparent: Rectangle {
        x: 4px;
        y: 4px;
        width: 7px;
        height: 7px;
        background: badge;
        border-width: 1px;
        border-color: Skin.panel;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Page tabs in the header ("top" navigation); scroll sideways if they don't fit.
export component TopTabs inherits Flickable {
    in property <[PageInfo]> pages;
    in property <int> current;
    callback selected(int);
    callback add();
    interactive: true;
    content-width: max(self.width, row.preferred-width);
    row := HorizontalLayout {
        height: root.height;
        spacing: 2px;
        alignment: start;
        for p[i] in pages: VerticalLayout {
            alignment: center;
            TopTab {
                icon: p.icon;
                text: p.name;
                selected: i == current;
                badge: p.mood == "alarm" ? Skin.bad : p.mood == "busy" ? Moods.color(p.theme, "busy") : transparent;
                clicked => { root.selected(i); }
            }
        }
        VerticalLayout {
            alignment: center;
            TopTab {
                icon-path: Icons.plus;
                accessible-label: @tr("New page");
                clicked => { root.add(); }
            }
        }
    }
}
