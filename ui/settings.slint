// Hub settings (`current == "apps"`): dashboard, appearance, system, pages and the
// list of apps with each one's options.
import { ScrollView } from "std-widgets.slint";
import { Skin, Icons, Anim } from "theme.slint";
import { Icon, IconButton, TextButton, SqSwitch, Stepper, Select, MascotSelect, TextField } from "widgets.slint";
import { SettingRow, AppInfo, PageInfo, DataRow, ProcUsage } from "models.slint";

// Header of a settings block that opens and closes (blocks with many options start closed).
// A click anywhere on it toggles; `summary` shows only while closed. Children (e.g. a
// button) go on the right and keep their own click.
component SectionHead inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in-out property <bool> open;
    min-height: row.preferred-height;
    TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.open ? @tr("Close {}", root.title) : @tr("Open {}", root.title);
        accessible-action-default => { root.open = !root.open; }
        clicked => { root.open = !root.open; }
    }
    row := HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                icon: root.open ? Icons.chevron : Icons.chevron-right;
                ink: root.open ? Skin.accent : Skin.dim;
                size: 16px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.title; color: Skin.ink; font-size: 17px * Skin.text-scale; font-weight: 700; }
            if !root.open && root.summary != "": Text {
                text: root.summary;
                color: Skin.dim;
                font-family: Skin.font-mono;
                font-size: 11px * Skin.text-scale;
                wrap: word-wrap;
            }
        }
        @children
    }
}

// Rows with a minimum height of 44 px: `max(44px, self.preferred-height)`, never just `44px`.
// A fixed min-height becomes the row's height, and text that wraps (or text at 125%)
// spills into the row below.
component SettingLine inherits Rectangle {
    in property <SettingRow> s;
    in property <color> accent;
    callback toggled;
    callback int-edited(int);
    callback chosen(int);
    callback text-edited(string);

    HorizontalLayout {
        spacing: 16px;
        // the minimum height goes on the label: on the Rectangle, reading its preferred height makes a
        // loop; on the inner layout, it has no effect
        Text {
            min-height: 44px;
            text: s.label;
            color: Skin.ink;
            font-size: 14px * Skin.text-scale;
            horizontal-stretch: 1;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        VerticalLayout {
            alignment: center;
            if s.kind == "bool": SqSwitch {
                checked: s.bool-value;
                accent: accent;
                label: s.label;
                toggled => { root.toggled(); }
            }
            if s.kind == "int": Stepper {
                value: s.int-value;
                minimum: s.minimum;
                maximum: s.maximum;
                step: s.step;
                unit: s.unit;
                accent: accent;
                edited(v) => { root.int-edited(v); }
            }
            if s.kind == "choice" && s.images.length == 0: Select {
                width: 220px;
                options: s.options;
                index: s.index;
                accent: accent;
                label: s.label;
                chosen(i) => { root.chosen(i); }
            }
            if s.kind == "text" || s.kind == "secret": TextField {
                width: 220px;
                value: s.text-value;
                secret: s.kind == "secret";
                accent: accent;
                label: s.label;
                committed(t) => { root.text-edited(t); }
            }
            // mascot choice: picker with each one's drawing
            if s.kind == "choice" && s.images.length > 0: MascotSelect {
                width: 220px;
                options: s.options;
                images: s.images;
                index: s.index;
                accent: accent;
                label: s.label;
                chosen(i) => { root.chosen(i); }
            }
        }
    }
}

/// A preference with a title, an explanation and a picker on the right.
component ChoiceRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> hint;
    in property <[string]> options;
    in property <[image]> images;   // with images, it becomes a mascot picker
    in property <int> index;
    callback chosen(int);
    spacing: 16px;
    min-height: max(44px, self.preferred-height);
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.title; color: Skin.ink; font-size: 14px * Skin.text-scale; }
        Text { text: root.hint; color: Skin.sub; font-size: 12px * Skin.text-scale; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        if root.images.length == 0: Select {
            width: 220px;
            options: root.options;
            index: root.index;
            accent: Skin.accent;
            label: root.title;
            chosen(i) => { root.chosen(i); }
        }
        if root.images.length > 0: MascotSelect {
            width: 220px;
            options: root.options;
            images: root.images;
            index: root.index;
            accent: Skin.accent;
            label: root.title;
            chosen(i) => { root.chosen(i); }
        }
    }
}

export component AppsView inherits ScrollView {
    in property <[AppInfo]> apps;
    in property <[string]> skins;          // window skins (labels)
    in property <int> skin-index;
    callback skin-chosen(int);
    // tray icon: mascot and theme (index 0 = automatic)
    in property <[string]> tray-icons;
    in property <[image]> tray-icon-images;
    in property <int> tray-icon-index;
    in property <[string]> tray-themes;
    in property <int> tray-theme-index;
    callback tray-icon-chosen(int);
    callback tray-theme-chosen(int);
    // where the pages go (index into `appearance::NAVS`: left, right, bottom, top)
    in property <int> nav-index;
    callback nav-chosen(int);
    // reduce motion (still mascots, no reactions)
    in property <bool> reduce-motion;
    callback reduce-motion-toggled();
    // mascots do not perk up on hover (a sub-option of reduce motion, but independent)
    in property <bool> still-on-hover;
    callback still-on-hover-toggled();
    // how much the mascots chat (0 never, 1 sometimes, 2 a lot)
    in property <int> chatter-index;
    callback chatter-chosen(int);
    in property <int> language-index;
    callback language-chosen(int);
    // system: start with the system, version and log folder
    in property <bool> autostart;
    callback autostart-toggled();
    // window: where it opens (index into `popup::Place::KEYS`) and desktop app mode
    in property <int> place-index;
    callback place-chosen(int);
    in property <bool> desktop-app;
    callback desktop-app-toggled();
    in property <bool> can-place: true;
    in property <string> version;
    in property <string> log-dir;
    // CPU and memory now: the hub, each external app and the total (src/hub/usage.rs)
    in property <[ProcUsage]> usage-rows;
    callback open-logs();
    // local apps (see the properties in hub.slint)
    in property <string> apps-dir;
    in property <string> apps-summary;
    in property <string> apps-skipped;
    callback open-apps-dir();
    callback reload-apps();
    // app data: export and delete (of an app, or left over from a removed app) and the
    // notice of the last request, shown on the row of app `data-note-app`
    in property <[DataRow]> orphan-data;
    in property <string> data-note-app;
    in property <string> data-note;
    in property <bool> data-note-bad;
    callback export-data(string);
    callback delete-data(string);
    // appearance: accent, text size, animated background and the themes/skins/backgrounds folder
    in property <[string]> accents;
    in property <int> accent-index;
    callback accent-chosen(int);
    in property <[string]> text-sizes;
    in property <int> text-size-index;
    callback text-size-chosen(int);
    in property <bool> ambient-on;
    callback ambient-toggled();
    in property <string> looks-dir;
    in property <string> looks-summary;
    in property <string> looks-skipped;
    callback open-looks-dir();
    callback reload-looks();
    // pages: list, names (for each app's picker) and available mascots
    in property <[PageInfo]> pages;
    in property <[string]> page-names;
    in property <[string]> mascots;
    in property <[image]> mascot-images;
    callback page-added();
    callback page-removed(int);
    callback page-renamed(int, string);
    callback page-icon-chosen(int, int);
    callback page-moved(int, int /* -1 up, +1 down */);
    callback app-page-chosen(string, int);
    callback edit-layout();
    callback toggle-app(string);
    // app with its options open (one at a time; kept here because Rust rebuilds the list)
    in-out property <string> open-app;
    // open blocks (they start closed; hub.slint keeps them while the hub runs)
    in-out property <bool> appearance-open;
    in-out property <bool> system-open;
    in-out property <bool> pages-open;
    callback setting-toggled(string, string);
    callback setting-int(string, string, int);
    callback setting-chosen(string, string, int);
    callback setting-text(string, string, string);

    VerticalLayout {
        alignment: start;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 16px;
        spacing: 12px;

        // how to arrange the dashboard
        Rectangle {
            background: Skin.edit-bg;
            border-width: 1px;
            border-color: Skin.edit-line;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    Icon { icon: Icons.grid; ink: Skin.accent; size: 28px; weight: 1.8; }
                }
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text { text: @tr("Dashboard"); color: Skin.ink; font-size: 17px * Skin.text-scale; font-weight: 700; }
                    Text {
                        text: @tr("The grid is arranged right on the dashboard: in Change layout, drag the apps by the top and pull the edges to resize them.");
                        color: Skin.edit-sub;
                        font-size: 13px * Skin.text-scale;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Change layout");
                        icon: Icons.grid;
                        ink: Skin.accent;
                        edge: Skin.edit-line;
                        font-size: 13px * Skin.text-scale;
                        clicked => { root.edit-layout(); }
                    }
                }
            }
        }

        // window skin
        Rectangle {
            background: Skin.surface;
            border-width: 1px;
            border-color: Skin.surface-edge;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                SectionHead {
                    title: @tr("Appearance");
                    summary: @tr("Skin, colors, text size, motion, language and tray icon");
                    open <=> root.appearance-open;
                }
                if appearance-open: VerticalLayout {
                    spacing: 10px;
                    ChoiceRow {
                        title: @tr("Window skin");
                        hint: @tr("Background, frame, fonts and colors. Apps with the “Follows the window” theme change along.");
                        options: skins;
                        index: skin-index;
                        chosen(i) => { root.skin-chosen(i); }
                    }
                    ChoiceRow {
                        title: @tr("Accent color");
                        hint: @tr("Buttons, focus and the dashboard background. Adjusted to the skin to stay readable.");
                        options: accents;
                        index: accent-index;
                        chosen(i) => { root.accent-chosen(i); }
                    }
                    ChoiceRow {
                        title: @tr("Text size");
                        hint: @tr("Text of the window and the built-in apps (plugins follow if they use theme.text-scale).");
                        options: text-sizes;
                        index: text-size-index;
                        chosen(i) => { root.text-size-chosen(i); }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        min-height: max(44px, self.preferred-height);
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: @tr("Animated background"); color: Skin.ink; font-size: 14px * Skin.text-scale; }
                            Text {
                                text: @tr("Rain, stars and a scan line behind the dashboard. Also off with Reduce motion.");
                                color: Skin.sub;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SqSwitch {
                                checked: ambient-on;
                                label: @tr("Animated background");
                                toggled => { root.ambient-toggled(); }
                            }
                        }
                    }
                    ChoiceRow {
                        title: @tr("Pages");
                        hint: @tr("Where the pages show up: in a bar on the left, on the right or at the bottom, or as tabs in the header.");
                        // same order as `appearance::NAVS`
                        options: [@tr("Bar on the left"), @tr("Bar on the right"), @tr("Bar at the bottom"), @tr("Tabs on top")];
                        index: nav-index;
                        chosen(i) => { root.nav-chosen(i); }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        min-height: max(44px, self.preferred-height);
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: @tr("Reduce motion"); color: Skin.ink; font-size: 14px * Skin.text-scale; }
                            Text {
                                text: @tr("Mascots without bounces or shakes, and without celebrations or surprises.");
                                color: Skin.sub;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SqSwitch {
                                checked: reduce-motion;
                                label: @tr("Reduce motion");
                                toggled => { root.reduce-motion-toggled(); }
                            }
                        }
                    }
                    // sub-option of Reduce motion, indented under it; it works on its own
                    // (with Reduce motion on, the mascots are still anyway)
                    HorizontalLayout {
                        padding-left: 24px;
                        spacing: 16px;
                        min-height: max(44px, self.preferred-height);
                        Rectangle { width: 2px; background: Skin.surface-edge; }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: @tr("Still mascots on hover"); color: Skin.ink; font-size: 14px * Skin.text-scale; }
                            Text {
                                text: @tr("Mascots do not hop up when the pointer is over their app. Works without Reduce motion.");
                                color: Skin.sub;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SqSwitch {
                                checked: still-on-hover;
                                label: @tr("Still mascots on hover");
                                toggled => { root.still-on-hover-toggled(); }
                            }
                        }
                    }
                    ChoiceRow {
                        title: @tr("Language");
                        hint: @tr("Language of the interface. Automatic follows the system. Some texts change only after restarting MiniUtils.");
                        options: [@tr("Automatic"), "English", "Português (Brasil)"];
                        index: language-index;
                        chosen(i) => { root.language-chosen(i); }
                    }
                    ChoiceRow {
                        title: @tr("Mascot chatter");
                        hint: @tr("The mascots comment on what happens in the apps and, when all is calm, make small talk. Click a mascot to make it speak.");
                        options: [@tr("Never"), @tr("Sometimes"), @tr("A lot")];
                        index: chatter-index;
                        chosen(i) => { root.chatter-chosen(i); }
                    }
                    ChoiceRow {
                        title: @tr("Tray icon");
                        hint: @tr("Mascot shown in the tray. On automatic, it is the one of the app in the worst state.");
                        options: tray-icons;
                        images: tray-icon-images;
                        index: tray-icon-index;
                        chosen(i) => { root.tray-icon-chosen(i); }
                    }
                    ChoiceRow {
                        title: @tr("Icon colors");
                        hint: @tr("Theme of the mascot in the tray. On automatic, it follows the theme of the app shown.");
                        options: tray-themes;
                        index: tray-theme-index;
                        chosen(i) => { root.tray-theme-chosen(i); }
                    }
                    // themes, skins and backgrounds from files (src/skin/user.rs). No min-height:
                    // a fixed value becomes the row's height, and taller text spills out
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: @tr("Your themes, skins and backgrounds"); color: Skin.ink; font-size: 14px * Skin.text-scale; }
                            Text {
                                text: @tr(".toml files in themes/, skins/, backdrops/ and sprites/, and PNG mascots in mascots/, in this folder (examples in examples/appearance). After changing them, click Reload.");
                                color: Skin.sub;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                            Text {
                                text: looks-dir;
                                color: Skin.sub;
                                font-family: Skin.font-mono;
                                font-size: 11px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                            Text {
                                text: looks-summary;
                                color: Skin.dim;
                                font-family: Skin.font-mono;
                                font-size: 11px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                            if looks-skipped != "": Text {
                                text: looks-skipped;
                                color: Skin.danger;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            TextButton {
                                text: @tr("Open folder");
                                font-size: 13px * Skin.text-scale;
                                clicked => { root.open-looks-dir(); }
                            }
                            TextButton {
                                text: @tr("Reload");
                                icon: Icons.refresh;
                                ink: Skin.accent;
                                font-size: 13px * Skin.text-scale;
                                clicked => { root.reload-looks(); }
                            }
                        }
                    }
                }
            }
        }

        // system
        Rectangle {
            background: Skin.surface;
            border-width: 1px;
            border-color: Skin.surface-edge;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                SectionHead {
                    title: @tr("System");
                    summary: @tr("Startup, version, logs, usage and local apps");
                    open <=> root.system-open;
                }
                if system-open: VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 16px;
                        min-height: max(44px, self.preferred-height);
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: @tr("Start with the system"); color: Skin.ink; font-size: 14px * Skin.text-scale; }
                            Text {
                                text: @tr("Opens only in the tray when you log in.");
                                color: Skin.sub;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SqSwitch {
                                checked: autostart;
                                label: @tr("Start with the system");
                                toggled => { root.autostart-toggled(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        min-height: max(44px, self.preferred-height);
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: @tr("Desktop app"); color: Skin.ink; font-size: 14px * Skin.text-scale; }
                            Text {
                                text: can-place
                                    ? @tr("Shows up in the taskbar and Alt+Tab like any program: it is not above the other windows and does not hide when you click outside. Closing it leaves it in the tray.")
                                    : @tr("Shows up as a normal window: does not hide when you click outside. Closing it leaves it in the tray. (On Wayland, the system decides the taskbar.)");
                                color: Skin.sub;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            SqSwitch {
                                checked: desktop-app;
                                label: @tr("Desktop app");
                                toggled => { root.desktop-app-toggled(); }
                            }
                        }
                    }
                    if can-place: ChoiceRow {
                        title: @tr("Window opens");
                        hint: @tr("Where the window shows up each time it opens. \"Where I left it\" remembers where you dragged it.");
                        // same order as `popup::Place::KEYS`
                        options: [@tr("Next to the tray icon"), @tr("Center of the screen"), @tr("Top left corner"), @tr("Top right corner"), @tr("Bottom left corner"), @tr("Bottom right corner"), @tr("Where I left it")];
                        index: place-index;
                        chosen(i) => { root.place-chosen(i); }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        min-height: max(44px, self.preferred-height);
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: @tr("Version {}", version); color: Skin.ink; font-size: 14px * Skin.text-scale; }
                            Text {
                                text: log-dir == "" ? @tr("No folder for the logs.") : @tr("Logs (warnings and errors): {}", log-dir);
                                color: Skin.sub;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            if log-dir != "": TextButton {
                                text: @tr("Open logs");
                                font-size: 13px * Skin.text-scale;
                                clicked => { root.open-logs(); }
                            }
                        }
                    }
                    // usage now: the hub and each external app (CPU colored by load) and the total
                    if usage-rows.length > 0: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: @tr("Usage now");
                                color: Skin.ink;
                                font-size: 14px * Skin.text-scale;
                                vertical-alignment: center;
                            }
                            // "live" light: blinks with the animation frame (still with "reduce motion")
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                y: (parent.height - self.height) / 2;
                                background: Skin.accent;
                                opacity: Anim.calm || mod(Anim.frame, 8) < 4 ? 1 : 0.2;
                                animate opacity { duration: 250ms; }
                            }
                            Text {
                                text: @tr("live");
                                color: Skin.dim;
                                font-size: 11px * Skin.text-scale;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        Rectangle {
                            background: Skin.field;
                            border-width: 1px;
                            border-color: Skin.field-edge;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 2px;
                                // column titles
                                HorizontalLayout {
                                    spacing: 16px;
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: @tr("CPU"); width: 90px; color: Skin.dim; font-size: 10px * Skin.text-scale; horizontal-alignment: right; }
                                    Text { text: @tr("Memory"); width: 110px; color: Skin.dim; font-size: 10px * Skin.text-scale; horizontal-alignment: right; }
                                }
                                for u in usage-rows: VerticalLayout {
                                    spacing: 2px;
                                    if u.total: Rectangle { height: 1px; background: Skin.field-edge; }
                                    HorizontalLayout {
                                        spacing: 16px;
                                        min-height: max(26px, self.preferred-height);
                                        Text {
                                            text: u.name;
                                            horizontal-stretch: 1;
                                            color: u.total ? Skin.ink : Skin.sub;
                                            font-size: 13px * Skin.text-scale;
                                            font-weight: u.total ? 700 : 400;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        // number in the load's color (calm, busy, heavy), unit apart
                                        HorizontalLayout {
                                            width: 90px;
                                            alignment: end;
                                            spacing: 2px;
                                            Text {
                                                text: u.cpu-text;
                                                color: u.cpu >= 40 ? Skin.bad : u.cpu >= 10 ? Skin.accent.mix(Skin.bad, 0.5) : Skin.accent;
                                                animate color { duration: 400ms; }
                                                font-family: Skin.font-mono;
                                                font-size: 16px * Skin.text-scale;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "%";
                                                color: Skin.dim;
                                                font-family: Skin.font-mono;
                                                font-size: 11px * Skin.text-scale;
                                                vertical-alignment: center;
                                            }
                                        }
                                        HorizontalLayout {
                                            width: 110px;
                                            alignment: end;
                                            spacing: 4px;
                                            Text {
                                                text: u.mem-text;
                                                color: Skin.ink;
                                                font-family: Skin.font-mono;
                                                font-size: 16px * Skin.text-scale;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: u.mem-unit;
                                                color: Skin.dim;
                                                font-family: Skin.font-mono;
                                                font-size: 11px * Skin.text-scale;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // local apps: whatever is in this folder joins the list below. No
                    // min-height: a fixed value becomes the row's height, and taller text spills out
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: @tr("Local apps"); color: Skin.ink; font-size: 14px * Skin.text-scale; }
                            Text {
                                text: @tr("One app per folder, named after the id in manifest.toml. After adding or changing an app, click Reload.");
                                color: Skin.sub;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                            Text {
                                text: apps-dir;
                                color: Skin.sub;
                                font-family: Skin.font-mono;
                                font-size: 11px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                            Text {
                                text: apps-summary;
                                color: Skin.dim;
                                font-family: Skin.font-mono;
                                font-size: 11px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                            if apps-skipped != "": Text {
                                text: apps-skipped;
                                color: Skin.danger;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            TextButton {
                                text: @tr("Open folder");
                                font-size: 13px * Skin.text-scale;
                                clicked => { root.open-apps-dir(); }
                            }
                            TextButton {
                                text: @tr("Reload");
                                icon: Icons.refresh;
                                ink: Skin.accent;
                                font-size: 13px * Skin.text-scale;
                                clicked => { root.reload-apps(); }
                            }
                        }
                    }
                    // data left over from removed apps (removal asks; whoever kept it deletes it here)
                    if orphan-data.length > 0: VerticalLayout {
                        spacing: 6px;
                        Text { text: @tr("Data of removed apps"); color: Skin.ink; font-size: 14px * Skin.text-scale; }
                        Text {
                            text: @tr("Kept when the app was removed. Reinstalling the same app brings them back.");
                            color: Skin.sub;
                            font-size: 12px * Skin.text-scale;
                            wrap: word-wrap;
                        }
                        for d in orphan-data: HorizontalLayout {
                            property <bool> armed;
                            spacing: 8px;
                            min-height: max(40px, self.preferred-height);
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: d.text;
                                    color: Skin.sub;
                                    font-family: Skin.font-mono;
                                    font-size: 12px * Skin.text-scale;
                                    wrap: word-wrap;
                                }
                                if data-note-app == d.id && data-note != "": Text {
                                    text: data-note;
                                    color: data-note-bad ? Skin.danger : Skin.accent;
                                    font-size: 12px * Skin.text-scale;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    text: @tr("Export");
                                    font-size: 13px * Skin.text-scale;
                                    clicked => { root.export-data(d.id); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    text: armed ? @tr("Confirm") : @tr("Delete");
                                    icon: Icons.close;
                                    ink: Skin.danger;
                                    edge: Skin.danger-edge;
                                    font-size: 13px * Skin.text-scale;
                                    accessible-label: armed ? @tr("Confirm: delete the data of {}", d.id) : @tr("Delete the data of {}", d.id);
                                    clicked => {
                                        if armed {
                                            armed = false;
                                            root.delete-data(d.id);
                                        } else {
                                            armed = true;
                                        }
                                    }
                                }
                            }
                            // the second click is valid only for a short time
                            Timer {
                                interval: 6s;
                                running: armed;
                                triggered => { armed = false; }
                            }
                        }
                    }
                }
            }
        }

        // sidebar pages
        Rectangle {
            background: Skin.surface;
            border-width: 1px;
            border-color: Skin.surface-edge;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                SectionHead {
                    title: @tr("Pages");
                    summary: @tr("Name, icon and order of the pages");
                    open <=> root.pages-open;
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: @tr("New page");
                            font-size: 13px * Skin.text-scale;
                            // opens the block too, so the new page shows up
                            clicked => { root.pages-open = true; root.page-added(); }
                        }
                    }
                }
                if pages-open: VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: @tr("Each page has its own grid and shows in the page bar. To move an app to another page, open its options below.");
                        color: Skin.sub;
                        font-size: 12px * Skin.text-scale;
                        wrap: word-wrap;
                    }
                    for p[i] in pages: HorizontalLayout {
                        spacing: 10px;
                        min-height: max(44px, self.preferred-height);
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 35px;
                                background: p.theme.bg1;
                                Image { source: p.icon; image-rendering: pixelated; width: 32px; height: 28px; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 34px;
                                border-width: 1px;
                                border-color: name.has-focus ? Skin.accent : Skin.field-edge;
                                background: Skin.field;
                                name := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    text: p.name;
                                    color: Skin.ink;
                                    font-size: 14px * Skin.text-scale;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accessible-label: @tr("Name of page {}", i + 1);
                                    accepted => { root.page-renamed(i, self.text); }
                                    changed has-focus => {
                                        if !self.has-focus && self.text != p.name { root.page-renamed(i, self.text); }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            MascotSelect {
                                width: 150px;
                                options: mascots;
                                images: mascot-images;
                                index: p.icon-index;
                                accent: Skin.accent;
                                label: @tr("Icon of page {}", p.name);
                                chosen(k) => { root.page-icon-chosen(i, k); }
                            }
                        }
                        IconButton {
                            width: 34px;
                            height: 34px;
                            icon: Icons.chevron-up;
                            enabled: i > 0;
                            label: @tr("Move {} up", p.name);
                            clicked => { root.page-moved(i, -1); }
                        }
                        IconButton {
                            width: 34px;
                            height: 34px;
                            icon: Icons.chevron;
                            enabled: i < pages.length - 1;
                            label: @tr("Move {} down", p.name);
                            clicked => { root.page-moved(i, 1); }
                        }
                        IconButton {
                            width: 34px;
                            height: 34px;
                            icon: Icons.close;
                            ink: Skin.danger;
                            enabled: pages.length > 1;
                            label: @tr("Delete {} (its apps go to the previous page)", p.name);
                            clicked => { root.page-removed(i); }
                        }
                    }
                }
            }
        }

        for app in apps: Rectangle {
            property <color> accent: app.theme.fur;
            background: accent.mix(Skin.surface, 0.06);
            border-width: 1px;
            border-color: accent.mix(Skin.surface-edge, 0.3);
            opacity: app.enabled ? 1 : 0.55;
            property <bool> open: root.open-app == app.id;

            VerticalLayout {
                padding: 16px;
                spacing: 14px;
                // app header: a click opens/closes the options (the switch has its own click)
                head := Rectangle {
                    min-height: head-row.preferred-height;
                    TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: open ? @tr("Close options of {}", app.name) : @tr("Open options of {}", app.name);
                        accessible-action-default => { root.open-app = open ? "" : app.id; }
                        clicked => { root.open-app = open ? "" : app.id; }
                    }
                    head-row := HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            icon: open ? Icons.chevron : Icons.chevron-right;
                            ink: open ? accent : Skin.dim;
                            size: 16px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 43px;
                            background: app.theme.bg1;
                            Image {
                                source: app.icon;
                                image-rendering: pixelated;
                                width: 40px;
                                height: 35px;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: app.name; color: Skin.ink; font-size: 17px * Skin.text-scale; font-weight: 700; overflow: elide; }
                            // where it came from: "loja"/"store", "unreviewed", "local" or "dev" (empty for built-ins)
                            if app.origin != "": VerticalLayout {
                                property <bool> from-store: app.origin == "loja" || app.origin == "store";
                                property <bool> unreviewed: app.origin == "unreviewed";
                                alignment: center;
                                Rectangle {
                                    border-width: 1px;
                                    border-color: from-store ? Skin.surface-edge : unreviewed ? Skin.bad : Skin.accent;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: from-store ? @tr("store") : unreviewed ? @tr("unreviewed") : app.origin;
                                            color: from-store ? Skin.dim : unreviewed ? Skin.bad : Skin.accent;
                                            font-family: Skin.font-mono;
                                            font-size: 11px * Skin.text-scale;
                                        }
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text { text: app.description; color: Skin.sub; font-size: 13px * Skin.text-scale; wrap: word-wrap; }
                        if !open: Text {
                            text: app.settings.length == 1 ? @tr("1 option · click to open") : @tr("{} options · click to open", app.settings.length);
                            color: Skin.dim;
                            font-family: Skin.font-mono;
                            font-size: 11px * Skin.text-scale;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        SqSwitch {
                            width: 48px;
                            height: 26px;
                            knob: 18px;
                            accent: accent;
                            checked: app.enabled;
                            label: @tr("Enable {}", app.name);
                            toggled => { root.toggle-app(app.id); }
                        }
                    }
                    }
                }
                if open: Rectangle { height: 1px; background: Skin.surface-edge; }
                if open: VerticalLayout {
                    if page-names.length > 1: HorizontalLayout {
                        spacing: 16px;
                        min-height: max(44px, self.preferred-height);
                        Text {
                            text: @tr("Page");
                            color: Skin.ink;
                            font-size: 14px * Skin.text-scale;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Select {
                                width: 220px;
                                options: page-names;
                                index: app.page;
                                accent: accent;
                                label: @tr("Page of {}", app.name);
                                chosen(k) => { root.app-page-chosen(app.id, k); }
                            }
                        }
                    }
                    for s in app.settings: SettingLine {
                        s: s;
                        accent: accent;
                        toggled => { root.setting-toggled(s.app, s.key); }
                        int-edited(v) => { root.setting-int(s.app, s.key, v); }
                        chosen(i) => { root.setting-chosen(s.app, s.key, i); }
                        text-edited(t) => { root.setting-text(s.app, s.key, t); }
                    }
                    // what the app stores (core/appdata.rs): export and delete with two clicks
                    if app.data != "": HorizontalLayout {
                        property <bool> armed;
                        spacing: 16px;
                        min-height: max(44px, self.preferred-height);
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: @tr("Data"); color: Skin.ink; font-size: 14px * Skin.text-scale; }
                            Text {
                                text: app.data;
                                color: Skin.sub;
                                font-family: Skin.font-mono;
                                font-size: 11px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                            if armed: Text {
                                text: @tr("Click again to delete: the app starts over from scratch.");
                                color: Skin.danger;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                            if !armed && data-note-app == app.id && data-note != "": Text {
                                text: data-note;
                                color: data-note-bad ? Skin.danger : accent;
                                font-size: 12px * Skin.text-scale;
                                wrap: word-wrap;
                            }
                        }
                        if app.has-data: VerticalLayout {
                            alignment: center;
                            TextButton {
                                text: @tr("Export");
                                ink: accent;
                                font-size: 13px * Skin.text-scale;
                                accessible-label: @tr("Export the data of {}", app.name);
                                clicked => { root.export-data(app.id); }
                            }
                        }
                        if app.has-data: VerticalLayout {
                            alignment: center;
                            TextButton {
                                text: armed ? @tr("Confirm") : @tr("Delete data");
                                icon: Icons.close;
                                ink: Skin.danger;
                                edge: Skin.danger-edge;
                                font-size: 13px * Skin.text-scale;
                                accessible-label: armed ? @tr("Confirm: delete the data of {}", app.name) : @tr("Delete the data of {}", app.name);
                                clicked => {
                                    if armed {
                                        armed = false;
                                        root.delete-data(app.id);
                                    } else {
                                        armed = true;
                                    }
                                }
                            }
                        }
                        Timer {
                            interval: 6s;
                            running: armed;
                            triggered => { armed = false; }
                        }
                    }
                }
            }
        }

        Text {
            text: @tr("Mascots and themes from CyberDock · Interface built with Slint (slint.dev)");
            color: Skin.dim;
            font-size: 11px * Skin.text-scale;
            horizontal-alignment: center;
        }
    }
}
