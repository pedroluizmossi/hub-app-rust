// Data Rust fills in for the hub window (see hub.slint).
import { Colors } from "theme.slint";

// Position of an app on the dashboard grid (in cells).
export struct GridCell {
    id: string,
    name: string,
    col: int,
    row: int,
    w: int,
    h: int,
    theme: Colors,   // the app's theme (filled by Rust)
}

// Preview of where the app will land during a drag in edit mode.
export struct Ghost {
    visible: bool,
    id: string,
    col: int,
    row: int,
    w: int,
    h: int,
    ok: bool,        // it fits (the others find a place)
}

// A setting declared in an app's manifest.
export struct SettingRow {
    app: string,
    key: string,
    label: string,
    unit: string,        // "%", "°C" or empty (taken from the end of the label)
    kind: string,        // "bool" | "int" | "choice"
    bool-value: bool,
    int-value: int,
    minimum: int,
    maximum: int,
    step: int,
    options: [string],   // labels of a choice
    index: int,          // selected option
    images: [image],     // drawing of each option, if it is a mascot choice (otherwise empty)
}

export struct AppInfo {
    id: string,
    name: string,
    description: string,
    icon: image,
    enabled: bool,
    mood: string,
    theme: Colors,
    settings: [SettingRow],
    page: int,           // page the app is on
    origin: string,      // "" (built-in), "loja" (store), "local" or "dev" (--plugin-dev)
    // what it stores and how much ("SQLite database · 1.2 MB (database up to 10 MB)"); "" = stores nothing
    data: string,
    has-data: bool,      // there is something to export or delete
}

// Stored data of an app that is no longer installed (Settings › System).
export struct DataRow {
    id: string,
    text: string,        // "io.github.x.app · 1.2 MB"
}

// A dashboard page (an item of the sidebar).
export struct PageInfo {
    name: string,
    icon: image,         // the page's mascot, in the mood of its worst app
    icon-index: int,     // chosen mascot (index in the mascot list)
    mood: string,        // worst mood of the page's enabled apps
    theme: Colors,       // theme used for the icon (the skin's)
    apps: int,           // enabled apps on the page
}

// An element of the animated background (src/skin/backdrop.rs › Ambient), in logical pixels.
export struct AmbientItem {
    kind: string,        // "fall" (descends and wraps), "blink" (shows for `on` ms every `period`) or "scan"
    x: float,
    y: float,
    w: float,
    h: float,
    color: color,
    alpha: float,
    phase: int,          // ms of delay, so they don't move in sync
    period: int,         // ms
    on: int,             // ms
    speed: float,        // px per second
    slant: float,        // px to the left per px of fall (slanted rain)
}
