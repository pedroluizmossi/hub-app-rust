// Dados que o Rust preenche para a janela do hub (ver hub.slint).
import { Colors } from "theme.slint";

// Posição de um app na grade do painel (em células).
export struct GridCell {
    id: string,
    name: string,
    col: int,
    row: int,
    w: int,
    h: int,
    theme: Colors,   // tema do app (preenchido pelo Rust)
}

// Prévia de onde o app vai parar durante um arrasto no modo de edição.
export struct Ghost {
    visible: bool,
    id: string,
    col: int,
    row: int,
    w: int,
    h: int,
    ok: bool,        // cabe (os outros acham lugar)
}

// Uma configuração declarada no manifesto de um app.
export struct SettingRow {
    app: string,
    key: string,
    label: string,
    unit: string,        // "%", "°C" ou vazio (tirado do fim do rótulo)
    kind: string,        // "bool" | "int" | "choice"
    bool-value: bool,
    int-value: int,
    minimum: int,
    maximum: int,
    step: int,
    options: [string],   // rótulos de um choice
    index: int,          // opção escolhida
    images: [image],     // desenho de cada opção, se for uma escolha de mascote (senão vazio)
}

export struct AppInfo {
    id: string,
    name: string,
    description: string,
    icon: image,
    enabled: bool,
    mood: string,
    theme: Colors,
    settings: [SettingRow],
    page: int,           // página onde o app está
    origin: string,      // "" (embutido), "loja", "local" ou "dev" (--plugin-dev)
    // o que guarda e quanto ("banco SQLite · 1,2 MB (banco até 10 MB)"); "" = não guarda nada
    data: string,
    has-data: bool,      // há algo para exportar ou apagar
}

// Dados guardados de um app que não está mais instalado (Configurações › Sistema).
export struct DataRow {
    id: string,
    text: string,        // "io.github.x.app · 1,2 MB"
}

// Uma página do painel (item da barra lateral).
export struct PageInfo {
    name: string,
    icon: image,         // mascote da página, no humor do pior app dela
    icon-index: int,     // mascote escolhida (índice na lista de mascotes)
    mood: string,        // pior humor dos apps ligados da página
    theme: Colors,       // tema usado no ícone (o do visual)
    apps: int,           // apps ligados na página
}

// Um elemento do fundo animado (src/skin/backdrop.rs › Ambient), em pixels lógicos.
export struct AmbientItem {
    kind: string,        // "fall" (desce e volta), "blink" (aparece `on` ms a cada `period`) ou "scan"
    x: float,
    y: float,
    w: float,
    h: float,
    color: color,
    alpha: float,
    phase: int,          // ms de atraso, para não andarem juntos
    period: int,         // ms
    on: int,             // ms
    speed: float,        // px por segundo
    slant: float,        // px para a esquerda por px de queda (chuva inclinada)
}
