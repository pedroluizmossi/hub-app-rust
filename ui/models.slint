// Data Rust fills in for the hub window (see hub.slint).
import { Colors } from "theme.slint";

// Position of an app on the dashboard grid (in cells).
export struct GridCell {
    id: string,
    name: string,
    col: int,
    row: int,
    w: int,
    h: int,
    theme: Colors,   // the app's theme (filled by Rust)
}

// Preview of where the app will land during a drag in edit mode.
export struct Ghost {
    visible: bool,
    id: string,
    col: int,
    row: int,
    w: int,
    h: int,
    ok: bool,        // it fits (the others find a place)
}

// A setting declared in an app's manifest (src/hub/settings.rs › settings_of; hidden ones,
// whose `when` does not hold, are left out).
export struct SettingRow {
    app: string,
    key: string,
    label: string,
    help: string,        // explanation under the label ("" = none)
    group-head: string,  // header above this row: the first of a run in the same group ("" = none)
    restart: bool,       // takes effect after restarting MiniUtils (a tag next to the label)
    modified: bool,      // the saved value is not the default (shows the reset button)
    unit: string,        // "%", "°C", " s", " min", " px" or empty (taken from the end of the label)
    kind: string,        // "bool" | "int" | "float" | "choice" | "text" | "secret" | "color" | "file" | "folder"
    bool-value: bool,
    // int: the value and its range; float: the position on the stepper (0..maximum, step 1)
    int-value: int,
    minimum: int,
    maximum: int,
    step: int,
    float-text: string,  // float: the value as written, with the unit ("0.5", "1,25 s")
    float-widest: string,// float: the maximum as written (sizes the stepper)
    options: [string],   // labels of a choice
    index: int,          // selected option
    images: [image],     // drawing of each option, if it is a mascot choice (otherwise empty)
    text-value: string,  // value of a text, secret, color ("#rrggbb"), file or folder
    color-value: color,  // color: the swatch
}

export struct AppInfo {
    id: string,
    name: string,
    description: string,
    icon: image,
    enabled: bool,
    mood: string,
    theme: Colors,
    settings: [SettingRow],
    page: int,           // page the app is on
    origin: string,      // "" (built-in), "loja" (store), "unreviewed" (--install-from), "local" or "dev" (--plugin-dev)
    // what it stores and how much ("SQLite database · 1.2 MB (database up to 10 MB)"); "" = stores nothing
    data: string,
    has-data: bool,      // there is something to export or delete
}

// Stored data of an app that is no longer installed (Settings › System).
export struct DataRow {
    id: string,
    text: string,        // "io.github.x.app · 1.2 MB"
}

// A dashboard page (an item of the sidebar).
export struct PageInfo {
    name: string,
    icon: image,         // the page's mascot, in the mood of its worst app
    icon-index: int,     // chosen mascot (index in the mascot list)
    mood: string,        // worst mood of the page's enabled apps
    theme: Colors,       // theme used for the icon (the skin's)
    apps: int,           // enabled apps on the page
}

// An element of the animated background (src/skin/backdrop.rs › Ambient), in logical pixels.
export struct AmbientItem {
    kind: string,        // "fall" (descends and wraps), "blink" (shows for `on` ms every `period`) or "scan"
    x: float,
    y: float,
    w: float,
    h: float,
    color: color,
    alpha: float,
    phase: int,          // ms of delay, so they don't move in sync
    period: int,         // ms
    on: int,             // ms
    speed: float,        // px per second
    slant: float,        // px to the left per px of fall (slanted rain)
}

// CPU and memory of one process now: the hub, an external app or the total line
// (Settings › System, src/hub/usage.rs).
export struct ProcUsage {
    name: string,
    cpu: float,          // % of the whole machine (colors the number)
    cpu-text: string,    // "1.9" (the "%" is drawn apart)
    mem-text: string,    // "87.8"
    mem-unit: string,    // "MB"
    total: bool,         // the sum line (drawn apart)
}
