// Cores de um tema. Cada mini-app tem o seu (vários aparecem juntos no painel),
// então o tema é um valor passado aos componentes, não um global.

export struct Colors {
    fur: color,
    visor: color,
    outline: color,
    ok: color,
    warn: color,
    alarm: color,
    sleep: color,
    bg0: color,
    bg1: color,
    text: color,
    sub: color,
    muted: color,
}

export global Moods {
    // cor de cada humor
    public pure function color(t: Colors, mood: string) -> color {
        if mood == "alarm" { return t.alarm; }
        if mood == "busy" { return t.warn; }
        if mood == "happy" { return t.ok; }
        if mood == "sleep" { return t.sleep; }
        return t.visor;
    }
}

// Quadro de animação (~8/s), avançado pelo Rust só com a janela visível.
export global Anim {
    in property <int> frame;
    // "reduzir movimento" (config `reduce_motion`): mascotes paradas, sem pulos nem tremores
    in property <bool> calm: false;
}

// Visual da janela (a "skin"): fundo, moldura, cabeçalho, fontes e cores da interface.
// Os valores vêm do Rust (src/skin/mod.rs); os daqui são os do visual Neon, usados só
// até o Rust preencher. O conteúdo de cada app segue o tema do app (`Colors`).
export global Skin {
    // superfícies
    in property <color> bg: #0B0912;          // fundo do conteúdo
    in property <color> panel: #0B0912;       // cabeçalho e rodapé
    in property <color> panel-top: transparent; // brilho no alto do cabeçalho
    in property <color> edge: #2E2546;        // borda da janela
    in property <color> edge-inner: transparent;
    in property <color> line: #1E1830;        // linha sob o cabeçalho
    in property <color> surface: #120A1F;     // blocos das configurações
    in property <color> surface-edge: #3A1F55;
    in property <color> field: #0D0717;       // campos, selects, steppers
    in property <color> field-edge: #3A2A55;
    in property <color> slot: #2A4A55;        // células vazias no modo de edição
    // texto
    in property <color> ink: #EDE6FF;
    in property <color> sub: #C9BEE6;
    in property <color> dim: #8E80AA;
    in property <color> panel-ink: #EDE6FF;   // título no cabeçalho
    in property <color> panel-sub: #C9BEE6;   // botões do cabeçalho
    in property <color> tag-ink: #8E80AA;     // texto ao lado do título
    // acentos
    in property <color> accent: #3DF2FF;
    in property <color> accent-ink: #04161A;  // texto sobre o acento
    in property <color> accent2: #FF3DB8;     // alfinete ligado
    in property <color> hover: #24123A;
    in property <color> danger: #FF8095;
    in property <color> danger-edge: #5A1F3A;
    in property <color> bad: #FF4D6A;
    // modo de edição (derivadas do acento)
    in property <color> edit-bg: #071A1E;
    in property <color> edit-line: #1F5A62;
    in property <color> edit-ink: #C9E9EC;
    in property <color> edit-sub: #9FD8DE;
    // forma
    in property <length> chamfer: 18px;       // corte dos cantos (0 = retos)
    in property <length> border: 1px;         // espessura da borda da janela
    in property <length> header-h: 48px;
    in property <length> header-line: 1px;
    in property <length> panel-top-h: 0px;
    in property <length> footer-h: 0px;       // rodapé (0 = sem; < 20 px = só a faixa)
    // mascotes: largura de referência (a altura segue o quadro 16×14); cada app pode dar outra caixa
    in property <length> mascot-size: 72px;
    in property <float> card-alpha: 1;        // opacidade do fundo dos apps sobre o fundo da janela
    // letras
    in property <string> font-ui: "Chakra Petch";
    in property <string> font-mono: "JetBrains Mono";
    in property <string> font-title: "Chakra Petch";
    // cabeçalho
    in property <string> title: "TOCA";
    in property <length> title-size: 18px;
    in property <int> title-weight: 700;
    in property <length> title-spacing: 3.2px;
    in property <bool> title-cursor: false;   // cursor piscando depois do título
    in property <string> title-icon;          // ícone em pixel (quadro 8×8, preenchido)
    in property <string> title-icon-cut;      // furo no ícone (porta da casinha)
    in property <string> tag: "grid";         // "grid" | "greeting" | "none"
    in property <string> buttons: "icon";     // "icon" | "bracket" | "chunky"
}

