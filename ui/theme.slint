// Colors of a theme. Each mini-app has its own (several show up together on the dashboard),
// so the theme is a value passed to components, not a global.

export struct Colors {
    fur: color,
    visor: color,
    outline: color,
    ok: color,
    warn: color,
    alarm: color,
    sleep: color,
    bg0: color,
    bg1: color,
    text: color,
    sub: color,
    muted: color,
}

export global Moods {
    // color of each mood
    public pure function color(t: Colors, mood: string) -> color {
        if mood == "alarm" { return t.alarm; }
        if mood == "busy" { return t.warn; }
        if mood == "happy" { return t.ok; }
        if mood == "sleep" { return t.sleep; }
        return t.visor;
    }
}

// Animation frame (~8/s), advanced by Rust only while the window is visible.
export global Anim {
    in property <int> frame;
    // clock in ms (wraps to zero every hour), for the animated background
    in property <int> time;
    // "reduce motion" (config `reduce_motion`): still mascots, no bounces or shakes
    in property <bool> calm: false;
}

// Window look (the "skin"): background, frame, header, fonts and interface colors.
// The values come from Rust (src/skin/mod.rs); the ones here are the Neon skin's, used only
// until Rust fills them in. Each app's content follows the app's theme (`Colors`).
export global Skin {
    // surfaces
    in property <color> bg: #0B0912;          // content background
    in property <color> panel: #0B0912;       // header and footer
    in property <color> panel-top: transparent; // highlight at the top of the header
    in property <color> edge: #2E2546;        // window border
    in property <color> edge-inner: transparent;
    in property <color> line: #1E1830;        // line under the header
    in property <color> surface: #120A1F;     // settings blocks
    in property <color> surface-edge: #3A1F55;
    in property <color> field: #0D0717;       // fields, selects, steppers
    in property <color> field-edge: #3A2A55;
    in property <color> slot: #2A4A55;        // empty cells in edit mode
    // text
    in property <color> ink: #EDE6FF;
    in property <color> sub: #C9BEE6;
    in property <color> dim: #8E80AA;
    in property <color> panel-ink: #EDE6FF;   // title in the header
    in property <color> panel-sub: #C9BEE6;   // header buttons
    in property <color> tag-ink: #8E80AA;     // text next to the title
    // accents
    in property <color> accent: #3DF2FF;
    in property <color> accent-ink: #04161A;  // text on the accent
    in property <color> accent2: #FF3DB8;     // pin on
    in property <color> hover: #24123A;
    in property <color> danger: #FF8095;
    in property <color> danger-edge: #5A1F3A;
    in property <color> bad: #FF4D6A;
    // edit mode (derived from the accent)
    in property <color> edit-bg: #071A1E;
    in property <color> edit-line: #1F5A62;
    in property <color> edit-ink: #C9E9EC;
    in property <color> edit-sub: #9FD8DE;
    // shape
    in property <length> chamfer: 18px;       // corner cut (0 = square)
    in property <length> border: 1px;         // window border thickness
    in property <length> header-h: 48px;
    in property <length> header-line: 1px;
    in property <length> panel-top-h: 0px;
    in property <length> footer-h: 0px;       // footer (0 = none; < 20 px = just the strip)
    // mascots: reference width (height follows the 16×14 frame); each app may give another box
    in property <length> mascot-size: 72px;
    in property <float> card-alpha: 1;        // opacity of the apps' background over the window background
    // text size (Settings › Appearance): every `font-size` is multiplied by it
    in property <float> text-scale: 1;
    // fonts
    in property <string> font-ui: "Chakra Petch";
    in property <string> font-mono: "JetBrains Mono";
    in property <string> font-title: "Chakra Petch";
    // header
    in property <string> title: "TOCA";
    in property <length> title-size: 18px;
    in property <int> title-weight: 700;
    in property <length> title-spacing: 3.2px;
    in property <bool> title-cursor: false;   // blinking cursor after the title
    in property <string> title-icon;          // pixel icon (8×8 frame, filled)
    in property <string> title-icon-cut;      // hole in the icon (the little house's door)
    in property <string> tag: "grid";         // "grid" | "greeting" | "none"
    in property <string> buttons: "icon";     // "icon" | "bracket" | "chunky"
}

