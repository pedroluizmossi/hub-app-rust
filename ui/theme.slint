// Cores de um tema. Cada mini-app tem o seu (vários aparecem juntos no painel),
// então o tema é um valor passado aos componentes, não um global.

export struct Colors {
    fur: color,
    visor: color,
    outline: color,
    ok: color,
    warn: color,
    alarm: color,
    sleep: color,
    bg0: color,
    bg1: color,
    text: color,
    sub: color,
    muted: color,
}

export global Moods {
    // cor de cada humor
    public pure function color(t: Colors, mood: string) -> color {
        if mood == "alarm" { return t.alarm; }
        if mood == "busy" { return t.warn; }
        if mood == "happy" { return t.ok; }
        if mood == "sleep" { return t.sleep; }
        return t.visor;
    }
}

// Quadro de animação (~8/s), avançado pelo Rust só com a janela visível.
export global Anim {
    in property <int> frame;
}

// Moldura da Toca (fixa, igual em todos os temas): fundo, linhas e acentos do design.
export global Chrome {
    out property <color> bg: #0B0912;
    out property <color> edge: #2E2546;
    out property <color> line: #1E1830;
    out property <color> ink: #EDE6FF;
    out property <color> sub: #C9BEE6;
    out property <color> dim: #8E80AA;
    out property <color> hover: #24123A;
    out property <color> cyan: #3DF2FF;
    out property <color> magenta: #FF3DB8;
    out property <color> danger: #FF8095;
    out property <color> danger-edge: #5A1F3A;
    // modo de edição
    out property <color> edit-bg: #071A1E;
    out property <color> edit-line: #1F5A62;
    out property <color> edit-ink: #C9E9EC;
    out property <color> edit-sub: #9FD8DE;
    out property <color> bad: #FF4D6A;
    // corte dos cantos (superior direito e inferior esquerdo)
    out property <length> chamfer: 18px;
}

export global Fonts {
    out property <string> ui: "Chakra Petch";
    out property <string> mono: "JetBrains Mono";
}

