import { ScrollView } from "std-widgets.slint";
import { Colors, Skin } from "../../ui/theme.slint";
import { LaunchButton, Mascot, Sparkline, TextButton } from "../../ui/widgets.slint";

export struct UsageLine {
    label: string,
    value: float,
    detail: string,
    reset: string,
    // "alarm" | "busy" | "idle": Rust decides the thresholds (a single place)
    level: string,
    // usage over the last hour (SVG path 1000×100); empty = no readings to draw
    spark: string,
}

export struct UsageCard {
    name: string,
    // id in the mascot chatter (comes from Rust)
    voice: string,
    status: string,
    plan: string,
    stale: bool,
    lines: [UsageLine],
    mascot: image,
    mood: string,
    reaction: string,
    // terminal button in the mascot colours: body and outline
    button: color,
    button-edge: color,
}

export global AiUsageApp {
    in property <Colors> theme;
    in property <[UsageCard]> cards;
    // compact mode (config): no status or reset
    in property <bool> compact;
    callback refresh();
    callback mascot-poked(int);
    // opens the program of the card (row) in a terminal
    callback launch(int);
}

// A layout (not a Rectangle) because both shapes are `if`s: in a Rectangle the height
// of conditional children does not count, and the bars overlapped.
component Meter inherits VerticalLayout {
    in property <UsageLine> entry;
    in property <Colors> t;
    in property <bool> dense;   // a single row: label · bar · value
    in property <bool> reset;   // in dense mode, the reset below the row (when it fits)
    property <bool> hot: entry.level == "alarm" || entry.level == "busy";
    property <color> tint: entry.level == "alarm" ? t.alarm : t.warn;
    property <float> fill: min(max(entry.value, 0), 100) / 100;
    if !dense: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            Text { text: entry.label; color: t.sub; font-family: Skin.font-mono; font-size: 13px * Skin.text-scale; overflow: elide; }
            Rectangle { horizontal-stretch: 1; }
            if entry.spark != "" && !AiUsageApp.compact: VerticalLayout {
                alignment: center;
                Sparkline { commands: entry.spark; tint: (hot ? tint : t.visor).with-alpha(0.7); width: 48px; height: 12px; }
            }
            Rectangle { width: 6px; }
            Text { text: entry.detail; color: hot ? tint : t.text; font-family: Skin.font-mono; font-size: 13px * Skin.text-scale; }
        }
        Rectangle {
            height: 6px;
            background: t.muted.with-alpha(0.25);
            Rectangle { x: 0; height: parent.height; width: parent.width * fill; background: hot ? tint : t.visor; }
        }
        if !AiUsageApp.compact: Text { text: entry.reset; color: t.muted; font-family: Skin.font-mono; font-size: 12px * Skin.text-scale; overflow: elide; }
    }
    if dense: VerticalLayout {
        spacing: 1px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                width: 30%;
                text: entry.label;
                color: t.sub;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                overflow: elide;
                vertical-alignment: center;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Rectangle {
                    height: 5px;
                    background: t.muted.with-alpha(0.25);
                    Rectangle { x: 0; height: parent.height; width: parent.width * fill; background: hot ? tint : t.visor; }
                }
            }
            Text { text: entry.detail; color: hot ? tint : t.text; font-family: Skin.font-mono; font-size: 12px * Skin.text-scale; vertical-alignment: center; }
        }
        if reset && !AiUsageApp.compact && entry.reset != "": Text { text: entry.reset; color: t.muted; font-family: Skin.font-mono; font-size: 11px * Skin.text-scale; overflow: elide; }
    }
}

component AccountCard inherits Rectangle {
    in property <UsageCard> account;
    in property <Colors> t;
    in property <int> index;
    // list (app one cell wide): short card, so all four fit in a 1x2
    in property <bool> dense;
    // in dense mode, shows the reset below each row (the middle ground, when it fits)
    in property <bool> reset;
    property <length> mascot-w: dense ? Skin.mascot-size * 2 / 3 : Skin.mascot-size;
    border-width: 1px;
    border-color: t.muted.with-alpha(0.35);
    background: t.bg0.mix(t.bg1, 0.6);
    HorizontalLayout {
        padding: dense ? 7px : 10px;
        spacing: dense ? 9px : 10px;
        VerticalLayout {
            alignment: center;
            spacing: dense ? 4px : 8px;
            Mascot {
                theme: root.t;
                frame: account.mascot;
                mood: account.mood;
                reaction: account.reaction;
                voice: account.voice;
                width: mascot-w;
                height: mascot-w * 14 / 16;
                poked => { AiUsageApp.mascot-poked(root.index); }
            }
            HorizontalLayout {
                alignment: center;
                LaunchButton {
                    px: dense ? 2px : 3px;
                    tint: account.button;
                    edge: account.button-edge;
                    label: @tr("Open {} in the terminal", account.name);
                    clicked => { AiUsageApp.launch(root.index); }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: dense ? 3px : 7px;
            HorizontalLayout {
                spacing: 9px;
                Text { text: account.name; color: t.text; font-size: (dense ? 15px : 17px) * Skin.text-scale; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: account.plan; color: t.visor; font-family: Skin.font-mono; font-size: 12px * Skin.text-scale; overflow: elide; vertical-alignment: center; }
            }
            // in dense mode, the status shows only when there is no reading (it explains the gap)
            if account.lines.length == 0 || (!dense && !AiUsageApp.compact): Text {
                text: account.status;
                color: account.stale ? t.warn : t.muted;
                font-size: (dense ? 12px : 13px) * Skin.text-scale;
                wrap: dense ? no-wrap : word-wrap;
                overflow: elide;
            }
            for entry in account.lines: Meter { entry: entry; t: root.t; dense: root.dense; reset: root.reset; }
        }
    }
}

export component AiUsageView inherits Rectangle {
    // app width in the grid, in cells: 1 = list; 2 or more = cards side by side,
    // one per cell, and the rest wrap to the next row
    in property <int> span: 1;
    property <Colors> t: AiUsageApp.theme;
    // invisible copy of the cards (full shape) only to measure their minimum width.
    // It sits in a Flickable because that does not pass the content minimum up: loose in
    // the Rectangle, the measurement would become the minimum of the whole view.
    Flickable {
        width: 0;
        height: 0;
        visible: false;
        probe := Rectangle {
            VerticalLayout {
                for card[i] in AiUsageApp.cards: AccountCard { account: card; index: i; t: root.t; }
            }
        }
        // height of the tallest card in each shape, at the real width (a HorizontalLayout
        // is as tall as its tallest child): this decides which shape fits without scrolling
        tall-full := HorizontalLayout {
            for card[i] in AiUsageApp.cards: AccountCard { account: card; index: i; t: root.t; width: scroll.cw; }
        }
        tall-mid := HorizontalLayout {
            for card[i] in AiUsageApp.cards: AccountCard { account: card; index: i; t: root.t; width: scroll.cw; dense: true; reset: true; }
        }
    }
    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            Text { text: @tr("AI SUBSCRIPTIONS"); color: t.text; font-family: Skin.font-mono; font-size: 14px * Skin.text-scale; font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            TextButton { text: @tr("Refresh"); ink: t.visor; height: 30px; font-size: 13px * Skin.text-scale; clicked => { AiUsageApp.refresh(); } }
        }
        scroll := ScrollView {
            vertical-stretch: 1;
            property <length> gap: 8px;
            property <length> area: self.visible-width;
            property <int> n: AiUsageApp.cards.length;
            // one card per cell, but only as many as fit the width without clipping the content
            property <int> fit: floor((area + gap) / (probe.min-width + gap));
            property <int> cols: max(1, min(n, min(root.span, fit)));
            property <length> cw: (area - (cols - 1) * gap) / cols;
            // height each row of cards would have without scrolling. Full shape if it fits; otherwise
            // dense with the reset below (2x2 with four cards); otherwise dense with just the bar
            property <int> rows: max(1, ceil(n / cols));
            property <length> row-h: (self.visible-height - (rows - 1) * gap) / rows;
            property <bool> dense: row-h < tall-full.preferred-height;
            property <bool> reset: dense && row-h >= tall-mid.preferred-height;
            VerticalLayout {
                alignment: start;
                spacing: scroll.gap;
                for r in ceil(scroll.n / scroll.cols): HorizontalLayout {
                    spacing: scroll.gap;
                    alignment: start;
                    for c in scroll.cols: Rectangle {
                        property <int> i: r * scroll.cols + c;
                        width: scroll.cw;
                        // the layout passes the card height to the row; cards in a row get the same height
                        VerticalLayout {
                            if i < scroll.n: AccountCard { account: AiUsageApp.cards[i]; index: i; t: root.t; dense: scroll.dense; reset: scroll.reset; }
                        }
                    }
                }
                if scroll.n == 0: Text {
                    text: @tr("No sources to show. Turn one on in the app settings.");
                    color: t.muted;
                    font-size: 13px * Skin.text-scale;
                    wrap: word-wrap;
                }
            }
        }
    }
}
