import { ScrollView } from "std-widgets.slint";
import { Colors, Skin } from "../../ui/theme.slint";
import { LaunchButton, Mascot, Sparkline, TextButton } from "../../ui/widgets.slint";

export struct UsageLine {
    label: string,
    value: float,
    detail: string,
    reset: string,
    // "alarm" | "busy" | "idle": quem decide os limites é o Rust (um lugar só)
    level: string,
    // uso da última hora (caminho SVG 1000×100); vazio = sem leituras para desenhar
    spark: string,
}

export struct UsageCard {
    name: string,
    status: string,
    plan: string,
    stale: bool,
    lines: [UsageLine],
    mascot: image,
    mood: string,
    reaction: string,
    // botão de terminal na cor da mascote: corpo e contorno
    button: color,
    button-edge: color,
}

export global AiUsageApp {
    in property <Colors> theme;
    in property <[UsageCard]> cards;
    // modo compacto (config): sem status nem renovação
    in property <bool> compact;
    callback refresh();
    callback mascot-poked(int);
    // abre o programa do cartão (linha) num terminal
    callback launch(int);
}

// É um layout (e não um Rectangle) porque as duas formas são `if`: num Rectangle a
// altura dos filhos condicionais não conta, e as barras se sobrepunham.
component Meter inherits VerticalLayout {
    in property <UsageLine> entry;
    in property <Colors> t;
    in property <bool> dense;   // uma linha só: rótulo · barra · valor, sem renovação
    property <bool> hot: entry.level == "alarm" || entry.level == "busy";
    property <color> tint: entry.level == "alarm" ? t.alarm : t.warn;
    property <float> fill: min(max(entry.value, 0), 100) / 100;
    if !dense: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            Text { text: entry.label; color: t.sub; font-family: Skin.font-mono; font-size: 13px; overflow: elide; }
            Rectangle { horizontal-stretch: 1; }
            if entry.spark != "" && !AiUsageApp.compact: VerticalLayout {
                alignment: center;
                Sparkline { commands: entry.spark; tint: (hot ? tint : t.visor).with-alpha(0.7); width: 48px; height: 12px; }
            }
            Rectangle { width: 6px; }
            Text { text: entry.detail; color: hot ? tint : t.text; font-family: Skin.font-mono; font-size: 13px; }
        }
        Rectangle {
            height: 6px;
            background: t.muted.with-alpha(0.25);
            Rectangle { x: 0; height: parent.height; width: parent.width * fill; background: hot ? tint : t.visor; }
        }
        if !AiUsageApp.compact: Text { text: entry.reset; color: t.muted; font-family: Skin.font-mono; font-size: 12px; overflow: elide; }
    }
    if dense: HorizontalLayout {
        spacing: 6px;
        Text {
            width: 30%;
            text: entry.label;
            color: t.sub;
            font-family: Skin.font-mono;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Rectangle {
                height: 5px;
                background: t.muted.with-alpha(0.25);
                Rectangle { x: 0; height: parent.height; width: parent.width * fill; background: hot ? tint : t.visor; }
            }
        }
        Text { text: entry.detail; color: hot ? tint : t.text; font-family: Skin.font-mono; font-size: 12px; vertical-alignment: center; }
    }
}

component AccountCard inherits Rectangle {
    in property <UsageCard> account;
    in property <Colors> t;
    in property <int> index;
    // lista (app com uma célula de largura): cartão baixo, para os quatro caberem num 1x2
    in property <bool> dense;
    property <length> mascot-w: dense ? Skin.mascot-size * 2 / 3 : Skin.mascot-size;
    border-width: 1px;
    border-color: t.muted.with-alpha(0.35);
    background: t.bg0.mix(t.bg1, 0.6);
    HorizontalLayout {
        padding: dense ? 7px : 10px;
        spacing: dense ? 9px : 10px;
        VerticalLayout {
            alignment: center;
            spacing: dense ? 4px : 8px;
            Mascot {
                theme: root.t;
                frame: account.mascot;
                mood: account.mood;
                reaction: account.reaction;
                voice: "cyber.ai_usage:" + account.name;   // id na conversa entre mascotes
                width: mascot-w;
                height: mascot-w * 14 / 16;
                poked => { AiUsageApp.mascot-poked(root.index); }
            }
            HorizontalLayout {
                alignment: center;
                LaunchButton {
                    px: dense ? 2px : 3px;
                    tint: account.button;
                    edge: account.button-edge;
                    label: "Abrir " + account.name + " no terminal";
                    clicked => { AiUsageApp.launch(root.index); }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: dense ? 3px : 7px;
            HorizontalLayout {
                spacing: 9px;
                Text { text: account.name; color: t.text; font-size: dense ? 15px : 17px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: account.plan; color: t.visor; font-family: Skin.font-mono; font-size: 12px; overflow: elide; vertical-alignment: center; }
            }
            // no denso, o status só aparece quando não há leitura (é o que explica o vazio)
            if account.lines.length == 0 || (!dense && !AiUsageApp.compact): Text {
                text: account.status;
                color: account.stale ? t.warn : t.muted;
                font-size: dense ? 12px : 13px;
                wrap: dense ? no-wrap : word-wrap;
                overflow: elide;
            }
            for entry in account.lines: Meter { entry: entry; t: root.t; dense: root.dense; }
        }
    }
}

export component AiUsageView inherits Rectangle {
    // largura do app na grade, em células: 1 = lista; 2 ou mais = cartões lado a lado,
    // um por célula, e os que sobram vão para a linha de baixo
    in property <int> span: 1;
    property <Colors> t: AiUsageApp.theme;
    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            Text { text: "ASSINATURAS DE IA"; color: t.text; font-family: Skin.font-mono; font-size: 14px; font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            TextButton { text: "Atualizar"; ink: t.visor; height: 30px; font-size: 13px; clicked => { AiUsageApp.refresh(); } }
        }
        scroll := ScrollView {
            vertical-stretch: 1;
            property <length> gap: 8px;
            property <length> area: self.visible-width;
            property <int> n: AiUsageApp.cards.length;
            property <int> cols: max(1, min(n, root.span));
            property <length> cw: (area - (cols - 1) * gap) / cols;
            // altura que cada linha de cartões teria sem rolar; abaixo de `full-h` os
            // cartões ficam densos (1x2 com os quatro em lista, 2x1 com duas linhas)
            property <int> rows: max(1, ceil(n / cols));
            property <length> row-h: (self.visible-height - (rows - 1) * gap) / rows;
            property <length> full-h: 170px;
            property <bool> dense: row-h < full-h;
            VerticalLayout {
                alignment: start;
                spacing: scroll.gap;
                for r in ceil(scroll.n / scroll.cols): HorizontalLayout {
                    spacing: scroll.gap;
                    alignment: start;
                    for c in scroll.cols: Rectangle {
                        property <int> i: r * scroll.cols + c;
                        width: scroll.cw;
                        // o layout passa a altura do cartão para a linha; cartões da linha ficam iguais
                        VerticalLayout {
                            if i < scroll.n: AccountCard { account: AiUsageApp.cards[i]; index: i; t: root.t; dense: scroll.dense; }
                        }
                    }
                }
                if scroll.n == 0: Text {
                    text: "Nenhuma fonte para mostrar. Ligue alguma nas configurações do app.";
                    color: t.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
