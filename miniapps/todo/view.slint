// View of the Quick to-do mini-app. Responsive: adapts to the panel cell it is in.
//   narrow (< 420 px): no task age
//   short (< 260 px): smaller mascot and no long speech
import { ListView } from "std-widgets.slint";
import { Colors, Skin, Icons } from "../../ui/theme.slint";
import { Mascot, Icon, IconButton, TextButton } from "../../ui/widgets.slint";

export struct TodoRow {
    id: int,
    text: string,
    done: bool,
    // "5 min ago"
    age-text: string,
}

// Mini-app state, filled in by Rust (src/apps/todo.rs).
export global TodoApp {
    in property <Colors> theme;
    in property <[TodoRow]> rows;
    in property <int> pending;
    in property <int> done;
    in property <image> mascot;
    in property <string> mood: "sleep";
    in property <string> reaction;
    in property <string> speech;
    // failure saving the file
    in property <string> error-text;
    // what is being typed (Rust clears it after adding)
    in-out property <string> draft;

    callback add(string);
    callback toggle(int /* id */);
    callback remove(int /* id */);
    callback clear-done();
    callback mascot-poked();
}

// Field to write the new task: Enter adds it.
component NewTask inherits Rectangle {
    in property <Colors> theme;
    height: 38px;
    border-width: 1px;
    border-color: input.has-focus ? theme.visor : theme.muted.with-alpha(0.7);
    background: theme.bg1.mix(theme.bg0, 0.6);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { icon: Icons.plus; ink: theme.sub; size: 14px; weight: 2.4; }
        }
        Rectangle {
            if TodoApp.draft == "": Text {
                text: @tr("new task… (Enter)");
                color: theme.sub.with-alpha(0.8);
                font-family: Skin.font-mono;
                font-size: 13px * Skin.text-scale;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
                height: 100%;
            }
            input := TextInput {
                text <=> TodoApp.draft;
                color: theme.text;
                font-family: Skin.font-mono;
                font-size: 13px * Skin.text-scale;
                vertical-alignment: center;
                single-line: true;
                accessible-label: @tr("New task");
                accepted => { TodoApp.add(self.text); }
            }
        }
    }
}

component Row inherits Rectangle {
    in property <TodoRow> r;
    in property <bool> narrow;
    property <Colors> t: TodoApp.theme;
    height: 44px;
    background: hover.has-hover ? t.visor.with-alpha(0.05) : transparent;

    hover := TouchArea { }

    Rectangle { y: parent.height - 1px; height: 1px; background: t.muted.with-alpha(0.35); }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;

        // checkbox: the click area is the whole row except the delete button
        Rectangle {
            width: 36px;
            Rectangle {
                width: 18px;
                height: 18px;
                border-width: 2px;
                border-color: r.done ? t.ok : check.has-hover ? t.visor : t.muted;
                background: r.done ? t.ok.with-alpha(0.25) : transparent;
                if r.done: Icon { icon: "M6 12l4 4l8-9"; ink: t.ok; size: 14px; weight: 3; }
            }
        }
        Text {
            text: r.text;
            color: r.done ? t.sub : t.text;
            font-size: 14px * Skin.text-scale;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if !narrow: Text {
            text: r.age-text;
            color: t.muted.mix(t.sub, 0.4);
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            IconButton {
                width: 32px;
                height: 32px;
                icon: Icons.close;
                icon-size: 14px;
                ink: t.sub;
                edge: transparent;
                label: @tr("Delete task");
                clicked => { TodoApp.remove(r.id); }
            }
        }
    }

    check := TouchArea {
        x: 0;
        width: parent.width - 44px;
        mouse-cursor: pointer;
        accessible-role: checkbox;
        accessible-checked: r.done;
        accessible-label: r.text;
        clicked => { TodoApp.toggle(r.id); }
    }
}

export component TodoView inherits Rectangle {
    property <Colors> t: TodoApp.theme;
    property <bool> narrow: self.width < 420px;
    property <bool> short: self.height < 260px;
    property <length> mascot-w: short ? Skin.mascot-size * 2 / 3 : Skin.mascot-size;
    property <length> mascot-h: mascot-w * 14 / 16;

  VerticalLayout {
    spacing: 12px;

    // mascot + speech
    HorizontalLayout {
        spacing: 16px;
        Rectangle {
            width: mascot-w + 8px;
            height: mascot-h + 8px;
            background: TodoApp.pending == 0 && TodoApp.done > 0 ? t.ok.with-alpha(0.14) : t.fur.with-alpha(0.1);
            Mascot {
                theme: t;
                frame: TodoApp.mascot;
                mood: TodoApp.mood;
                reaction: TodoApp.reaction;
                poked => { TodoApp.mascot-poked(); }
                width: parent.width - 8px;
                height: parent.height - 8px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: TodoApp.speech;
                color: t.text;
                font-size: (short ? 15px : 19px) * Skin.text-scale;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: TodoApp.error-text != "" ? TodoApp.error-text : @tr("Pending: {} · done: {}", TodoApp.pending, TodoApp.done);
                color: TodoApp.error-text != "" ? t.alarm : t.sub;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                wrap: word-wrap;
            }
        }
        if TodoApp.done > 0: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            TextButton {
                text: @tr("clear done");
                icon: Icons.close;
                ink: t.sub;
                compact: narrow;
                width: narrow ? 40px : self.min-width;
                clicked => { TodoApp.clear-done(); }
            }
        }
    }

    NewTask { theme: t; }

    // list
    Rectangle {
        vertical-stretch: 1;
        min-height: 44px;
        border-width: 1px;
        border-color: t.muted.with-alpha(0.45);
        background: t.bg1.mix(t.bg0, 0.6);

        if TodoApp.rows.length == 0: Text {
            text: TodoApp.done > 0 ? @tr("All done (done tasks are hidden).") : @tr("No tasks. Write one above.");
            color: t.sub;
            font-family: Skin.font-mono;
            font-size: 13px * Skin.text-scale;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        ListView {
            for r in TodoApp.rows: Row { r: r; narrow: narrow; }
        }
    }
  }
}
