// Tela do mini-app Sinais vitais: um cartão por recurso (CPU, RAM, GPU, disco, rede),
// cada um com sua mascote. Responsiva: os cartões ficam numa linha, em 2 colunas ou em
// 1 coluna conforme o formato da célula (o último ocupa o que sobrar da linha), e ficam
// compactos (sem histórico) quando baixos.
import { Colors, Moods, Skin } from "../../ui/theme.slint";
import { Mascot, SegBar, Sparkline } from "../../ui/widgets.slint";

export struct VitalCard {
    title: string,
    mascot: image,
    mood: string,
    reaction: string,    // reação curta por cima do humor (src/mascot/anim.rs)
    available: bool,
    value: float,        // 0..100
    value-text: string,  // "37%"
    detail: string,      // "5.1G / 15.5G"
    temp-text: string,   // "61 °C" ou ""
    hot: bool,
    spark: string,       // caminho SVG 1000×100
}

// Estado do mini-app, preenchido pelo Rust (src/apps/vitals.rs).
export global VitalsApp {
    in property <Colors> theme;
    in property <[VitalCard]> cards;
    // clicaram na mascote do cartão (easter egg)
    callback mascot-poked(int);
}

component Card inherits Rectangle {
    in property <VitalCard> v;
    in property <int> index;      // posição do cartão (para o clique na mascote)
    property <Colors> t: VitalsApp.theme;
    property <bool> compact: self.height < 150px;
    property <bool> slim: self.width < 220px;
    property <color> tint: !v.available ? t.muted : Moods.color(t, v.mood == "sleep" ? "idle" : v.mood);
    border-width: 1px;
    border-color: v.mood == "alarm" ? t.alarm : v.mood == "busy" ? t.warn.with-alpha(0.5) : tint.with-alpha(0.3);
    background: t.bg0.mix(t.bg1, 0.6);
    animate border-color { duration: 300ms; }

    HorizontalLayout {
        padding-left: compact ? 10px : 14px;
        padding-right: compact ? 10px : 14px;
        padding-top: compact ? 6px : 10px;
        padding-bottom: compact ? 6px : 10px;
        spacing: compact ? 10px : 14px;

        VerticalLayout {
            alignment: center;
            Mascot {
                theme: t;
                frame: v.mascot;
                mood: v.mood;
                reaction: v.reaction;
                poked => { VitalsApp.mascot-poked(index); }
                // compacto (cartão baixo ou estreito): 2/3 da referência
                width: compact || slim ? Skin.mascot-size * 2 / 3 : Skin.mascot-size;
                height: compact || slim ? Skin.mascot-size * 2 / 3 * 14 / 16 : Skin.mascot-size * 14 / 16;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: compact ? 4px : 6px;
            horizontal-stretch: 1;
            HorizontalLayout {
                Text {
                    text: v.title;
                    color: t.sub;
                    font-family: Skin.font-mono;
                    font-size: 11px;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if v.temp-text != "": Text {
                    text: (v.hot ? "♨ " : "") + v.temp-text;
                    color: v.hot ? t.alarm : t.sub;
                    font-family: Skin.font-mono;
                    font-size: 11px;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                }
            }
            Text {
                text: v.available ? v.value-text : "—";
                color: tint;
                font-family: Skin.font-mono;
                font-size: compact ? 18px : 22px;
                font-weight: 700;
            }
            SegBar { theme: t; value: v.value; tint: tint; off: t.muted.with-alpha(0.35); segments: slim ? 10 : 20; }
            if !compact: Sparkline { commands: v.spark; tint: tint.with-alpha(0.7); height: 22px; }
            // o detalhe (GHz, swap, partições, IP…) aparece sempre que couber; só o gráfico some
            if root.height >= 88px: Text {
                text: v.available ? v.detail : "não encontrado";
                color: t.sub;
                font-family: Skin.font-mono;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

export component VitalsView inherits Rectangle {
    property <Colors> t: VitalsApp.theme;
    property <int> n: VitalsApp.cards.length;
    property <length> gap: 10px;
    // todos numa linha se for bem largo, 2 colunas se couber, senão 1
    property <int> cols: self.width >= n * 170px + (n - 1) * gap && self.width / self.height > 2.4 ? n
        : self.width >= 2 * 190px + gap ? 2 : 1;
    property <int> rows: ceil(n / cols);
    property <length> cw: (self.width - (cols - 1) * gap) / cols;
    property <length> ch: max(64px, (self.height - (rows - 1) * gap) / rows);

    for v[i] in VitalsApp.cards: Card {
        property <int> c: mod(i, cols);
        // o último cartão se estica pelo resto da linha
        property <int> span: i == n - 1 ? cols - c : 1;
        v: v;
        index: i;
        x: c * (cw + gap);
        y: floor(i / cols) * (ch + gap);
        width: span * cw + (span - 1) * gap;
        height: ch;
    }
}
