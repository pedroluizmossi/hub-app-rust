// View of the Mascots mini-app (src/apps/mascots.rs): the person's mascots at a glance, and
// the two ways in (a folder or a .zip). Everything else (rename, animations, colors, use in
// an app) is in the manager window (manager.slint), opened by "Manage".
// Responsive: a small cell drops the gallery and keeps the buttons.
import { Colors, Skin, Icons } from "../../ui/theme.slint";
import { Mascot, TextButton } from "../../ui/widgets.slint";

// Mini-app state, filled in by Rust (src/apps/mascots.rs).
export global MascotsApp {
    in property <Colors> theme;
    in property <image> mascot;
    in property <string> mood: "idle";
    in property <string> reaction;
    // "12 mascots · 3 walk"
    in property <string> counts;
    // "5 in code · 2 PNG sprites"
    in property <string> kinds;
    // the person's own mascots (newest first), animated by Rust
    in property <[image]> gallery;
    // result of the last import ("" = nothing yet)
    in property <string> status;
    in property <bool> status-bad;
    // a dialog or an import is under way
    in property <bool> busy;

    callback import-folder();
    callback import-zip();
    callback manage();
    callback mascot-poked();
}

export component MascotsView inherits Rectangle {
    // the pointer is over the app's card (the mascot perks up)
    in property <bool> hovered;
    property <Colors> t: MascotsApp.theme;
    property <bool> short: self.height < 230px;
    property <bool> narrow: self.width < 400px;
    property <length> mascot-w: short ? Skin.mascot-size * 2 / 3 : Skin.mascot-size;

    VerticalLayout {
        spacing: short ? 8px : 12px;

        // mascot + counts
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                width: mascot-w + 8px;
                height: mascot-w * 14 / 16 + 8px;
                background: t.fur.with-alpha(0.1);
                Mascot {
                    noticed: root.hovered;
                    theme: t;
                    frame: MascotsApp.mascot;
                    mood: MascotsApp.mood;
                    reaction: MascotsApp.reaction;
                    poked => { MascotsApp.mascot-poked(); }
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 3px;
                Text {
                    text: MascotsApp.counts;
                    color: t.text;
                    font-size: (short ? 15px : 18px) * Skin.text-scale;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: MascotsApp.kinds;
                    color: t.sub;
                    font-family: Skin.font-mono;
                    font-size: 12px * Skin.text-scale;
                    overflow: elide;
                }
            }
        }

        // the person's mascots, side by side (as many as fit)
        if !short: Rectangle {
            vertical-stretch: 1;
            min-height: 40px;
            border-width: 1px;
            border-color: t.muted.with-alpha(0.45);
            background: t.bg1.mix(t.bg0, 0.6);
            if MascotsApp.gallery.length == 0: Text {
                text: @tr("No mascots of your own yet. Import a folder or a .zip.");
                color: t.sub;
                font-size: 13px * Skin.text-scale;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width - 20px;
            }
            HorizontalLayout {
                padding: 8px;
                spacing: 10px;
                alignment: start;
                for img in MascotsApp.gallery: VerticalLayout {
                    alignment: center;
                    Image {
                        source: img;
                        image-rendering: pixelated;
                        // the same height for all: a 16×14 drawing triples, a bigger sprite fits
                        height: 42px;
                        width: self.height * img.width / max(1, img.height);
                    }
                }
            }
        }

        if MascotsApp.status != "": Text {
            text: MascotsApp.status;
            color: MascotsApp.status-bad ? t.alarm : t.sub;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            wrap: word-wrap;
            max-height: 48px;
        }

        HorizontalLayout {
            spacing: 8px;
            TextButton {
                text: narrow ? @tr("Folder…") : @tr("Import folder…");
                icon: Icons.plus;
                ink: t.visor;
                enabled: !MascotsApp.busy;
                font-size: 12px * Skin.text-scale;
                clicked => { MascotsApp.import-folder(); }
            }
            TextButton {
                text: narrow ? @tr(".zip…") : @tr("Import .zip…");
                icon: Icons.plus;
                ink: t.visor;
                enabled: !MascotsApp.busy;
                font-size: 12px * Skin.text-scale;
                clicked => { MascotsApp.import-zip(); }
            }
            Rectangle { horizontal-stretch: 1; }
            TextButton {
                text: @tr("Manage");
                ink: t.bg0;
                fill: t.visor;
                font-size: 12px * Skin.text-scale;
                clicked => { MascotsApp.manage(); }
            }
        }
    }
}
