// View of the Docker mini-app. Responsive: adapts to the panel cell it is in.
//   narrow (< 560 px): no big counters and no usage column; smaller buttons
//   very narrow (< 420 px): only the start/stop/resume and logs actions
//   short (< 260 px): smaller mascot
import { ListView } from "std-widgets.slint";
import { Colors, Moods, Skin, Icons } from "../../ui/theme.slint";
import { Mascot, Icon, IconButton, TextButton, Counter, SearchBox, SqSwitch } from "../../ui/widgets.slint";

export struct ContainerRow {
    name: string,
    image: string,
    status: string,
    project: string,
    running: bool,
    // paused (docker pause): "start" does not apply, only "resume"
    paused: bool,
    problem: bool,
    // state text: "running", "stopped (1)", "unhealthy"…
    state-text: string,
    // CPU above the limit set in "busy_cpu" (Rust decides)
    busy: bool,
    usage-text: string,
    port-text: string,
    url: string,
    // how long it has been in the current state: "3 d ago" ("" if unknown)
    age-text: string,
    // restarts done by the restart policy ("2 restarts"; "" if 0)
    restarts: int,
    restarts-text: string,
    // group header (Compose stack): name = title, project = stack ("" = standalone),
    // state-text = count, running/problem = of the stack
    header: bool,
    collapsed: bool,
    // header: some container of the stack running, paused or restarting (enables "stop stack")
    active: bool,
}

// Mini-app state, filled in by Rust (src/apps/docker.rs).
export global DockerApp {
    in property <Colors> theme;
    in property <[ContainerRow]> rows;
    in property <int> running;
    in property <int> stopped;
    in property <int> errors;
    in property <bool> ok: true;
    // the `docker` command does not exist on this machine: not a failure, just nothing to show
    in property <bool> missing;
    in property <string> error-text;
    in property <image> mascot;
    in property <string> mood: "sleep";
    in property <string> reaction;          // short reaction on top of the mood
    // what the mascot is saying (last event)
    in property <string> speech;
    // mascot id in the mascot chatter (comes from Rust)
    in property <string> voice;
    in property <string> usage-text;
    in property <bool> hide-stopped;
    in property <string> sort: "estado";
    // list grouped by stack (there is at least one Compose project)
    in property <bool> grouped;
    in-out property <string> search;

    callback action(string /* verb */, string /* container */);
    // start|stop|restart of the whole stack (docker compose -p)
    callback stack-action(string /* verb */, string /* project */);
    callback toggle-group(string /* project */);
    // the mascot was clicked (easter egg)
    callback mascot-poked();
    callback search-edited(string);
    callback toggle-hide-stopped();
    callback cycle-sort();
    callback open-url(string);
    callback refresh();
}

component Row inherits Rectangle {
    in property <ContainerRow> c;
    in property <bool> narrow;
    in property <bool> tiny;
    property <Colors> t: DockerApp.theme;
    property <color> state-color: c.problem ? t.alarm : c.running ? t.ok : c.paused ? t.warn : t.muted;
    property <length> btn: narrow ? 34px : 40px;
    property <color> act-edge: t.visor.with-alpha(0.4);
    height: narrow ? 56px : 62px;
    background: c.problem ? t.alarm.with-alpha(0.08) : hover.has-hover ? t.visor.with-alpha(0.05) : transparent;

    hover := TouchArea { }

    // divider
    Rectangle { y: parent.height - 1px; height: 1px; background: t.muted.with-alpha(0.35); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        // state: square with a glow
        Rectangle {
            width: 18px;
            if c.running || c.paused || c.problem: Rectangle {
                width: 18px;
                height: 18px;
                background: state-color.with-alpha(0.18);
            }
            Rectangle {
                width: 10px;
                height: 10px;
                background: state-color;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: c.name;
                    color: t.text;
                    font-size: 15px * Skin.text-scale;
                    font-weight: 700;
                    overflow: elide;
                }
                if c.project != "" && !narrow && !DockerApp.grouped: Rectangle {
                    border-width: 1px;
                    border-color: t.fur.with-alpha(0.5);
                    background: t.fur.with-alpha(0.14);
                    width: proj.preferred-width + 12px;
                    proj := Text {
                        text: c.project;
                        color: t.fur.mix(t.text, 0.7);
                        font-family: Skin.font-mono;
                        font-size: 11px * Skin.text-scale;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // "running 3 d ago · 2 restarts · image" (very narrow: no restarts)
            HorizontalLayout {
                Text {
                    text: c.age-text != "" ? c.state-text + " " + c.age-text : c.state-text;
                    color: c.problem ? t.alarm.mix(t.text, 0.6) : t.sub;
                    font-family: Skin.font-mono;
                    font-size: 12px * Skin.text-scale;
                    overflow: elide;
                    horizontal-stretch: narrow ? 1 : 0;
                }
                if c.restarts > 0 && !tiny: Text {
                    text: " · " + c.restarts-text;
                    color: t.warn;
                    font-family: Skin.font-mono;
                    font-size: 12px * Skin.text-scale;
                    horizontal-stretch: 0;
                }
                Text {
                    text: narrow ? "" : " · " + c.image;
                    color: c.problem ? t.alarm.mix(t.text, 0.6) : t.sub;
                    font-family: Skin.font-mono;
                    font-size: 12px * Skin.text-scale;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        // usage and port
        if !narrow: VerticalLayout {
            alignment: center;
            spacing: 4px;
            width: 104px;
            Text {
                text: c.usage-text;
                color: c.busy ? t.warn : t.sub;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                horizontal-alignment: right;
            }
            if c.url != "": Text {
                text: c.port-text;
                color: link.has-hover ? t.text : t.visor;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                horizontal-alignment: right;
                link := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { DockerApp.open-url(c.url); }
                }
            }
        }

        // actions: pushed to the right, so the button columns line up across rows
        HorizontalLayout {
            alignment: end;
            horizontal-stretch: 0;
            spacing: 6px;
            padding-top: (root.height - btn) / 2;
            padding-bottom: (root.height - btn) / 2;
            // paused: resume (docker start does not unpause)
            IconButton {
                width: btn;
                height: btn;
                icon: c.running ? Icons.stop : Icons.play;
                ink: c.running ? t.fur : t.ok;
                edge: c.running ? t.fur : t.ok;
                label: c.paused ? @tr("Resume") : c.running ? @tr("Stop") : @tr("Start");
                clicked => { DockerApp.action(c.paused ? "unpause" : c.running ? "stop" : "start", c.name); }
            }
            // running: pause; paused: stop (disabled otherwise, to keep the columns aligned)
            if !tiny: IconButton {
                width: btn;
                height: btn;
                icon: c.paused ? Icons.stop : Icons.pause;
                ink: c.paused ? t.fur : t.warn;
                edge: c.paused ? t.fur : act-edge;
                enabled: c.running || c.paused;
                label: c.paused ? @tr("Stop") : @tr("Pause");
                clicked => { DockerApp.action(c.paused ? "stop" : "pause", c.name); }
            }
            if !tiny: IconButton {
                width: btn;
                height: btn;
                icon: Icons.refresh;
                ink: t.visor;
                edge: act-edge;
                label: @tr("Restart");
                clicked => { DockerApp.action("restart", c.name); }
            }
            IconButton {
                width: btn;
                height: btn;
                icon: Icons.logs;
                ink: t.visor;
                edge: act-edge;
                label: @tr("Logs");
                clicked => { DockerApp.action("logs", c.name); }
            }
            if !tiny: IconButton {
                width: btn;
                height: btn;
                icon: Icons.terminal;
                ink: t.visor;
                edge: act-edge;
                enabled: c.running;
                label: @tr("Terminal");
                clicked => { DockerApp.action("shell", c.name); }
            }
        }
    }
}

// Group header: Compose stack with its count and whole-stack actions.
component GroupHeader inherits Rectangle {
    in property <ContainerRow> g;
    in property <bool> narrow;
    in property <bool> tiny;
    property <Colors> t: DockerApp.theme;
    property <length> btn: narrow ? 28px : 30px;
    property <color> act-edge: t.visor.with-alpha(0.4);
    height: 40px;
    background: g.problem ? t.alarm.with-alpha(0.1) : toggle.has-hover ? t.fur.with-alpha(0.12) : t.fur.with-alpha(0.07);

    // clicking the header collapses/expands the group
    // it does not cover the stack buttons: a click on a disabled button must not collapse the group
    toggle := TouchArea {
        x: 0;
        width: g.project == "" ? parent.width : parent.width - (tiny ? 2 : 3) * btn - (tiny ? 6px : 12px) - 22px;
        mouse-cursor: pointer;
        clicked => { DockerApp.toggle-group(g.project); }
    }

    Rectangle { y: parent.height - 1px; height: 1px; background: t.muted.with-alpha(0.5); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                icon: g.collapsed ? "M9 6l6 6l-6 6" : Icons.chevron;
                ink: t.sub;
                size: 14px;
            }
        }
        Text {
            text: g.name;
            color: g.project == "" ? t.sub : t.text;
            font-family: Skin.font-mono;
            font-size: 13px * Skin.text-scale;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
        }
        Text {
            text: g.state-text;
            color: g.problem ? t.alarm.mix(t.text, 0.6) : g.running ? t.ok.mix(t.sub, 0.5) : t.muted;
            font-family: Skin.font-mono;
            font-size: 12px * Skin.text-scale;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // stack actions (standalone containers have none)
        // pushed to the right, aligned with the row buttons
        if g.project != "": HorizontalLayout {
            alignment: end;
            horizontal-stretch: 0;
            spacing: 6px;
            padding-top: (root.height - btn) / 2;
            padding-bottom: (root.height - btn) / 2;
            IconButton {
                width: btn;
                height: btn;
                icon-size: 14px;
                icon: Icons.play;
                ink: t.ok;
                edge: act-edge;
                label: @tr("Start stack {}", g.project);
                clicked => { DockerApp.stack-action("start", g.project); }
            }
            IconButton {
                width: btn;
                height: btn;
                icon-size: 14px;
                icon: Icons.stop;
                ink: t.fur;
                edge: act-edge;
                enabled: g.active;
                label: @tr("Stop stack {}", g.project);
                clicked => { DockerApp.stack-action("stop", g.project); }
            }
            if !tiny: IconButton {
                width: btn;
                height: btn;
                icon-size: 14px;
                icon: Icons.refresh;
                ink: t.visor;
                edge: act-edge;
                label: @tr("Restart stack {}", g.project);
                clicked => { DockerApp.stack-action("restart", g.project); }
            }
        }
    }
}

export component DockerView inherits Rectangle {
    property <Colors> t: DockerApp.theme;
    property <bool> narrow: self.width < 560px;
    property <bool> tiny: self.width < 420px;
    property <bool> short: self.height < 260px;
    property <bool> bad: (!DockerApp.ok && !DockerApp.missing) || DockerApp.errors > 0;
    // mascot: reference size (Skin.mascot-size); in the short version, 2/3 of it
    property <length> mascot-w: short ? Skin.mascot-size * 2 / 3 : Skin.mascot-size;
    property <length> mascot-h: mascot-w * 14 / 16;

  VerticalLayout {
    spacing: 12px;

    // mascot + speech + counters
    HorizontalLayout {
        spacing: 16px;
        Rectangle {
            // frame: the mascot with 4px of breathing room on each side
            width: mascot-w + 8px;
            height: mascot-h + 8px;
            background: bad ? t.alarm.with-alpha(0.18) : t.fur.with-alpha(0.1);
            Mascot {
                theme: t;
                frame: DockerApp.mascot;
                mood: DockerApp.mood;
                reaction: DockerApp.reaction;
                voice: DockerApp.voice;
                poked => { DockerApp.mascot-poked(); }
                width: parent.width - 8px;
                height: parent.height - 8px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: DockerApp.missing ? @tr("Docker not installed") : !DockerApp.ok ? @tr("Docker is down") : DockerApp.speech;
                color: bad ? t.alarm.mix(t.text, 0.75) : t.text;
                font-size: (short ? 15px : 19px) * Skin.text-scale;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: !DockerApp.ok ? DockerApp.error-text
                    : narrow ? @tr("{} running · {} stopped · {} with errors", DockerApp.running, DockerApp.stopped, DockerApp.errors)
                    : DockerApp.usage-text;
                color: DockerApp.errors > 0 && narrow ? t.alarm : t.sub;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                wrap: word-wrap;
            }
        }
        if !narrow: HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Counter { theme: t; label: "RUN"; value: DockerApp.running; tint: t.ok; }
            Counter { theme: t; label: "STOP"; value: DockerApp.stopped; tint: t.sub; }
            Counter { theme: t; label: "ERR"; value: DockerApp.errors; tint: t.alarm; }
        }
    }

    // search and filters
    HorizontalLayout {
        spacing: 12px;
        SearchBox {
            theme: t;
            text <=> DockerApp.search;
            placeholder: narrow ? @tr("search…") : @tr("search by name, image or stack");
            horizontal-stretch: 1;
            edited(text) => { DockerApp.search-edited(text); }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            alignment: center;
            SqSwitch {
                width: 34px;
                height: 18px;
                knob: 12px;
                accent: t.fur;
                label: @tr("Active only");
                off-track: t.bg1;
                off-edge: t.muted;
                off-knob: t.sub;
                on-knob: t.bg0;
                checked: DockerApp.hide-stopped;
                toggled => { DockerApp.toggle-hide-stopped(); }
            }
            if !tiny: Text { text: @tr("active only"); color: t.sub; font-size: 14px * Skin.text-scale; vertical-alignment: center; }
        }
        TextButton {
            // the sort option values are config keys (pt); show them translated
            text: @tr("sort: {}", DockerApp.sort == "estado" ? @tr("state") : DockerApp.sort == "nome" ? @tr("name") : DockerApp.sort);
            icon: Icons.logs;
            ink: t.sub;
            compact: narrow;
            horizontal-stretch: 0;
            width: narrow ? 40px : self.min-width;
            clicked => { DockerApp.cycle-sort(); }
        }
        TextButton {
            text: @tr("refresh");
            icon: Icons.refresh;
            ink: t.visor;
            compact: narrow;
            horizontal-stretch: 0;
            width: narrow ? 40px : self.min-width;
            clicked => { DockerApp.refresh(); }
        }
    }

    // list
    Rectangle {
        vertical-stretch: 1;
        min-height: 56px;
        border-width: 1px;
        border-color: t.muted.with-alpha(0.45);
        background: t.bg1.mix(t.bg0, 0.6);

        if DockerApp.rows.length == 0: Text {
            text: DockerApp.missing ? @tr("Install Docker to see the containers here.") : !DockerApp.ok ? @tr("No connection to Docker.") : DockerApp.search != "" ? @tr("No container matches this filter.") : @tr("No containers.");
            color: t.sub;
            font-family: Skin.font-mono;
            font-size: 13px * Skin.text-scale;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        ListView {
            // flat model: stack headers and containers in the same list
            for c in DockerApp.rows: Rectangle {
                height: c.header ? 40px : narrow ? 56px : 62px;
                if c.header: GroupHeader { width: parent.width; g: c; narrow: narrow; tiny: tiny; }
                if !c.header: Row { width: parent.width; c: c; narrow: narrow; tiny: tiny; }
            }
        }
    }
  }
}
