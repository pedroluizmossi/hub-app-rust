// Tela do mini-app Docker. Responsiva: se adapta à célula do painel em que está.
//   estreita (< 560 px): sem contadores grandes e sem coluna de uso; botões menores
//   muito estreita (< 420 px): só as ações iniciar/parar e logs
//   baixa (< 260 px): mascote menor
import { ListView } from "std-widgets.slint";
import { Colors, Moods, Chrome, Fonts, Icons } from "../../ui/theme.slint";
import { Mascot, IconButton, TextButton, Counter, SearchBox, SqSwitch } from "../../ui/widgets.slint";

export struct ContainerRow {
    name: string,
    image: string,
    status: string,
    project: string,
    running: bool,
    problem: bool,
    // texto do estado: "rodando", "parado (1)", "unhealthy"…
    state-text: string,
    cpu: float,
    usage-text: string,
    port-text: string,
    url: string,
}

// Estado do mini-app, preenchido pelo Rust (src/apps/docker.rs).
export global DockerApp {
    in property <Colors> theme;
    in property <[ContainerRow]> rows;
    in property <int> running;
    in property <int> stopped;
    in property <int> errors;
    in property <bool> ok: true;
    in property <string> error-text;
    in property <image> mascot;
    in property <string> mood: "sleep";
    // o que a mascote está dizendo (último evento)
    in property <string> speech;
    in property <string> usage-text;
    in property <bool> hide-stopped;
    in-out property <string> search;

    callback action(string /* verbo */, string /* container */);
    callback search-edited(string);
    callback toggle-hide-stopped();
    callback open-url(string);
    callback refresh();
}

component Row inherits Rectangle {
    in property <ContainerRow> c;
    in property <bool> narrow;
    in property <bool> tiny;
    property <Colors> t: DockerApp.theme;
    property <color> state-color: c.problem ? t.alarm : c.running ? t.ok : t.muted;
    property <length> btn: narrow ? 34px : 40px;
    property <color> act-edge: t.visor.with-alpha(0.4);
    height: narrow ? 56px : 62px;
    background: c.problem ? t.alarm.with-alpha(0.08) : hover.has-hover ? t.visor.with-alpha(0.05) : transparent;

    hover := TouchArea { }

    // divisória
    Rectangle { y: parent.height - 1px; height: 1px; background: t.muted.with-alpha(0.35); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        // estado: quadrado com brilho
        Rectangle {
            width: 18px;
            if c.running || c.problem: Rectangle {
                width: 18px;
                height: 18px;
                background: state-color.with-alpha(0.18);
            }
            Rectangle {
                width: 10px;
                height: 10px;
                background: state-color;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: c.name;
                    color: Chrome.ink;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                if c.project != "" && !narrow: Rectangle {
                    border-width: 1px;
                    border-color: t.fur.with-alpha(0.5);
                    background: t.fur.with-alpha(0.14);
                    width: proj.preferred-width + 12px;
                    proj := Text {
                        text: c.project;
                        color: t.fur.mix(#ffffff, 0.55);
                        font-family: Fonts.mono;
                        font-size: 11px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: narrow ? c.state-text : c.state-text + " · " + c.image;
                color: c.problem ? t.alarm.mix(#ffffff, 0.6) : #A99BC4;
                font-family: Fonts.mono;
                font-size: 12px;
                overflow: elide;
            }
        }

        // uso e porta
        if !narrow: VerticalLayout {
            alignment: center;
            spacing: 4px;
            width: 104px;
            Text {
                text: c.usage-text;
                color: c.cpu >= 60 ? t.warn : #A99BC4;
                font-family: Fonts.mono;
                font-size: 12px;
                horizontal-alignment: right;
            }
            if c.url != "": Text {
                text: c.port-text;
                color: link.has-hover ? #ffffff : t.visor;
                font-family: Fonts.mono;
                font-size: 12px;
                horizontal-alignment: right;
                link := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { DockerApp.open-url(c.url); }
                }
            }
        }

        // ações
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            padding-top: (root.height - btn) / 2;
            padding-bottom: (root.height - btn) / 2;
            IconButton {
                width: btn;
                height: btn;
                icon: c.running ? Icons.stop : Icons.play;
                ink: c.running ? t.fur : t.ok;
                edge: c.running ? t.fur : t.ok;
                label: c.running ? "Parar" : "Iniciar";
                clicked => { DockerApp.action(c.running ? "stop" : "start", c.name); }
            }
            if !tiny: IconButton {
                width: btn;
                height: btn;
                icon: Icons.refresh;
                ink: t.visor;
                edge: act-edge;
                label: "Reiniciar";
                clicked => { DockerApp.action("restart", c.name); }
            }
            IconButton {
                width: btn;
                height: btn;
                icon: Icons.logs;
                ink: t.visor;
                edge: act-edge;
                label: "Logs";
                clicked => { DockerApp.action("logs", c.name); }
            }
            if !tiny: IconButton {
                width: btn;
                height: btn;
                icon: Icons.terminal;
                ink: t.visor;
                edge: act-edge;
                enabled: c.running;
                label: "Terminal";
                clicked => { DockerApp.action("shell", c.name); }
            }
        }
    }
}

export component DockerView inherits Rectangle {
    property <Colors> t: DockerApp.theme;
    property <bool> narrow: self.width < 560px;
    property <bool> tiny: self.width < 420px;
    property <bool> short: self.height < 260px;
    property <bool> bad: !DockerApp.ok || DockerApp.errors > 0;

  VerticalLayout {
    spacing: 12px;

    // mascote + fala + contadores
    HorizontalLayout {
        spacing: 16px;
        Rectangle {
            width: short ? 56px : 72px;
            height: short ? 50px : 64px;
            background: bad ? t.alarm.with-alpha(0.18) : t.fur.with-alpha(0.1);
            Mascot {
                theme: t;
                frame: DockerApp.mascot;
                mood: DockerApp.mood;
                width: parent.width - 8px;
                height: parent.height - 8px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: !DockerApp.ok ? "Docker fora do ar" : DockerApp.speech;
                color: bad ? t.alarm.mix(#ffffff, 0.75) : Chrome.ink;
                font-size: short ? 15px : 19px;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: !DockerApp.ok ? DockerApp.error-text
                    : narrow ? DockerApp.running + " rodando · " + DockerApp.stopped + " parados · " + DockerApp.errors + " com erro"
                    : DockerApp.usage-text;
                color: DockerApp.errors > 0 && narrow ? t.alarm : #A99BC4;
                font-family: Fonts.mono;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        if !narrow: HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Counter { theme: t; label: "RUN"; value: DockerApp.running; tint: t.ok; }
            Counter { theme: t; label: "STOP"; value: DockerApp.stopped; tint: Chrome.sub; }
            Counter { theme: t; label: "ERR"; value: DockerApp.errors; tint: t.alarm; }
        }
    }

    // busca e filtros
    HorizontalLayout {
        spacing: 12px;
        SearchBox {
            theme: t;
            text <=> DockerApp.search;
            placeholder: narrow ? "buscar…" : "buscar por nome, imagem ou stack";
            horizontal-stretch: 1;
            edited(text) => { DockerApp.search-edited(text); }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            alignment: center;
            SqSwitch {
                width: 34px;
                height: 18px;
                knob: 12px;
                accent: t.fur;
                label: "Só ativos";
                checked: DockerApp.hide-stopped;
                toggled => { DockerApp.toggle-hide-stopped(); }
            }
            if !tiny: Text { text: "só ativos"; color: Chrome.sub; font-size: 14px; vertical-alignment: center; }
        }
        TextButton {
            text: "atualizar";
            icon: Icons.refresh;
            ink: t.visor;
            compact: narrow;
            horizontal-stretch: 0;
            width: narrow ? 40px : self.min-width;
            clicked => { DockerApp.refresh(); }
        }
    }

    // lista
    Rectangle {
        vertical-stretch: 1;
        min-height: 56px;
        border-width: 1px;
        border-color: t.muted.with-alpha(0.45);
        background: t.bg1.mix(#0D0717, 0.4);

        if DockerApp.rows.length == 0: Text {
            text: !DockerApp.ok ? "Sem conexão com o Docker." : DockerApp.search != "" ? "Nenhum container bate com esse filtro." : "Nenhum container.";
            color: #A99BC4;
            font-family: Fonts.mono;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        ListView {
            for c in DockerApp.rows: Row { c: c; narrow: narrow; tiny: tiny; }
        }
    }
  }
}
