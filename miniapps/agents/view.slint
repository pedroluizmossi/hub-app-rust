// View of the AI agents mini-app. Responsive: adapts to the panel cell it is in.
//   narrow (< 520 px): no big counters, smaller state, details without indent
//   short (< 260 px): smaller mascot and cards with the header only (no details)
// Each session is a card: header (mascot, title, state) and, below it, whatever the tool
// reports (model/effort/branch chips, tokens, last turn, last prompt, subagents). Whatever
// comes empty goes away, so the card of a tool that reports less is just shorter. Clicking
// the card opens the action buttons; another click closes them.
// "Details" opens the session in its own window (detail.slint).
// A session with working subagents gets a strip where they walk back and forth.
import { ListView } from "std-widgets.slint";
import { Colors, Skin, Icons, Anim } from "../../ui/theme.slint";
import { Mascot, Counter, TextButton, Icon } from "../../ui/widgets.slint";

// A subagent on the card of the session that spawned it.
export struct AgentSub {
    key: string,
    depth: int,
    // type ("Explore", "web-fetch"…; "" = unknown)
    kind: string,
    title: string,
    // "working" | "idle"
    state: string,
    state-text: string,
}

// A phase of a workflow run.
export struct AgentPhase {
    title: string,
    // "done" | "current" (running now) | "stopped" (some agents didn't return) | "todo"
    state: string,
    // "4/5": agents returned of those started
    count: string,
    // part done, 0..1
    fill: float,
    // its agents are the ones listed below the phases
    selected: bool,
}

// An agent of a workflow run, in the expanded run.
export struct AgentRunAgent {
    title: string,
    // "working" | "done" | "stopped"
    state: string,
    // working: the tool it is calling (or for how long); done: model and tokens
    text: string,
}

// A workflow run on the card of the session that started it. Collapsed: name, state and a
// bar with one segment per phase. Expanded: the phases and the agents of one of them.
export struct AgentRun {
    // identifies the run in clicks
    key: string,
    title: string,
    // "working" | "idle"
    state: string,
    state-text: string,
    // "phase 3 of 4 · Review · 4/5"
    caption: string,
    open: bool,
    phases: [AgentPhase],
    agents: [AgentRunAgent],
    // agents of the selected phase beyond the listed ones
    more-agents: int,
    // lines before this run and lines it takes (Rust counts them: the card's height)
    top: int,
    lines: int,
}

// A subagent walking as an imported mascot (PNG; see mascot/stroll.rs).
export struct AgentWalker {
    // the current frame (Rust changes it every frame: walks, stops, attacks, runs, jumps)
    frame: image,
    // position on the strip: 0 = left end, 1 = right end
    x: float,
}

export struct AgentRow {
    // identifies the session in clicks (the position changes when the list reorders)
    key: string,
    title: string,
    // "Claude · 2 active subagents · Edit: bus.rs" (idle: the folder instead of the action)
    info: string,
    // "working" | "waiting" | "idle"
    state: string,
    // "working for 3 min", "waiting for you: permission", "idle for 12 min"
    state-text: string,
    // subagent whose parent session is not in the list
    sub: bool,
    // the tool mascot, already in the mood of the state
    mascot: image,
    // idle session with terminal resume support
    can-resume: bool,
    // clicked card: shows the buttons
    open: bool,
    // subagents working now (at most 6 are shown walking)
    walkers: int,
    // mascot of a working subagent
    walker: image,
    // those walking as an imported mascot, plus those that finished and are jumping out
    // (empty = all with `walker`)
    heroes: [AgentWalker],
    // details: "" (or false) = the tool does not report it, and that part leaves the card
    model: string,
    effort: string,
    branch: string,
    has-tokens: bool,
    tok-in: string,
    tok-out: string,
    tok-cache: string,
    // duration of the last turn
    turn: string,
    // "316 messages · full answer"
    turn-note: string,
    // last user prompt
    prompt: string,
    subs: [AgentSub],
    // subagents beyond the listed ones
    more-subs: int,
    // workflow runs the session started, and the lines they take in all
    runs: [AgentRun],
    run-lines: int,
}

// Mini-app state, filled in by Rust (src/apps/agents.rs).
export global AgentsApp {
    in property <Colors> theme;
    in property <[AgentRow]> rows;
    in property <int> working;
    in property <int> waiting;
    in property <int> idle;
    // none of the tools is installed
    in property <bool> missing;
    // sources that could not be read ("" = all fine)
    in property <string> error-text;
    in property <image> mascot;
    in property <string> mood: "sleep";
    in property <string> reaction;
    in property <string> speech;

    callback mascot-poked();
    // these get the session `key`
    callback toggle(string);          // opens or closes the options
    callback open-dir(string);        // folder in the file manager
    callback open-terminal(string);   // terminal in the folder
    callback resume(string);          // resumes the session in a terminal
    callback resume-checked(string, bool);
    callback details(string);         // opens the session detail window
    callback toggle-run(string);      // expands or collapses a workflow run (gets its `key`)
    callback run-phase(string, int);  // lists the agents of phase `index` of run `key`
}

// Small chip: model, effort, branch.
component Chip inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <color> ink;
    property <Colors> t: AgentsApp.theme;
    height: 20px * Skin.text-scale;
    width: row.preferred-width + 14px;
    horizontal-stretch: 0;
    border-width: 1px;
    border-color: ink.with-alpha(0.45);
    background: ink.with-alpha(0.12);
    row := HorizontalLayout {
        alignment: center;
        spacing: 5px;
        if label != "": Text {
            text: root.label;
            color: t.sub;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: ink.mix(t.text, 0.55);
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// A number with its caption beside it: "45 k output".
component Stat inherits HorizontalLayout {
    in property <string> value;
    in property <string> label;
    in property <color> ink;
    property <Colors> t: AgentsApp.theme;
    spacing: 4px;
    horizontal-stretch: 0;
    Text {
        text: root.value;
        color: ink;
        font-family: Skin.font-mono;
        font-size: 13px * Skin.text-scale;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        text: root.label;
        color: t.sub;
        font-family: Skin.font-mono;
        font-size: 11px * Skin.text-scale;
        vertical-alignment: center;
    }
}

// Small square that says how a phase or an agent is: filled (done), pulsing (running),
// hollow (not started), in the warning color (stopped).
component StateMark inherits Rectangle {
    in property <string> state;
    property <Colors> t: AgentsApp.theme;
    property <bool> live: state == "working" || state == "current";
    width: 7px;
    height: 7px;
    border-width: state == "todo" ? 1px : 0;
    border-color: t.muted;
    background: state == "done" ? t.ok.with-alpha(0.75) : live ? t.ok : state == "stopped" ? t.warn : transparent;
    opacity: live && !Anim.calm && mod(Anim.frame, 4) >= 2 ? 0.3 : 1;
    animate opacity { duration: 250ms; easing: ease-in-out; }
}

// A workflow run: header and phase bar; clicking expands the phases and the agents.
component RunBlock inherits Rectangle {
    in property <AgentRun> r;
    // height of each line (the text size scales it)
    in property <length> line-h;
    property <Colors> t: AgentsApp.theme;
    property <bool> live: r.state == "working";
    property <color> ink: live ? t.ok : t.sub;
    property <length> pad: 4px;
    clip: true;
    border-width: 1px;
    border-color: (live ? t.ok : t.muted).with-alpha(r.open ? 0.6 : 0.35);
    background: t.visor.with-alpha(r.open ? 0.08 : head.has-hover ? 0.06 : 0.03);
    animate height { duration: 180ms; easing: ease-out; }

    // header and bar: a click expands or collapses
    head := TouchArea {
        y: 0;
        height: pad + 2 * line-h;
        mouse-cursor: pointer;
        clicked => { AgentsApp.toggle-run(root.r.key); }
    }

    HorizontalLayout {
        x: 6px;
        y: pad;
        width: parent.width - 12px;
        height: line-h;
        spacing: 6px;
        Icon {
            y: (parent.height - self.height) / 2;
            icon: r.open ? Icons.chevron : Icons.chevron-right;
            ink: ink;
            size: 12px * Skin.text-scale;
        }
        Text {
            horizontal-stretch: 0;
            text: "workflow";
            color: t.fur.mix(t.text, 0.6);
            font-family: Skin.font-mono;
            font-size: 12px * Skin.text-scale;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: r.title;
            color: live ? t.text : t.sub;
            font-size: 12px * Skin.text-scale;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 0;
            text: r.state-text;
            color: ink;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            vertical-alignment: center;
        }
    }

    // one segment per phase, filled as its agents return; the running one shimmers
    HorizontalLayout {
        x: 6px;
        y: pad + line-h;
        width: parent.width - 12px;
        height: line-h;
        spacing: 8px;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            for p in r.phases: VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Rectangle {
                    height: 6px;
                    clip: true;
                    background: p.state == "todo" ? t.muted.with-alpha(0.25) : t.muted.with-alpha(0.45);
                    Rectangle {
                        x: 0;
                        width: parent.width * p.fill;
                        background: p.state == "stopped" ? t.warn : p.state == "current" ? t.visor : t.ok;
                        animate width { duration: 400ms; easing: ease-out; }
                    }
                    if p.state == "current" && !Anim.calm: Rectangle {
                        property <float> sweep: mod(Anim.time, 1600) / 1600;
                        width: max(10px, parent.width * 0.3);
                        x: -self.width + sweep * (parent.width + self.width);
                        background: @linear-gradient(90deg, transparent 0%, t.text.with-alpha(0.45) 50%, transparent 100%);
                    }
                }
            }
        }
        Text {
            horizontal-stretch: 0;
            max-width: root.width * 0.6;
            text: r.caption;
            color: t.sub;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // expanded: the phases (a click lists that phase's agents)...
    if r.open: Rectangle {
        x: 6px;
        y: pad + 2 * line-h;
        width: parent.width - 12px;
        height: 1px;
        background: t.muted.with-alpha(0.3);
    }
    for p[i] in (r.open ? r.phases : []): Rectangle {
        x: 6px;
        y: pad + (2 + i) * line-h;
        width: parent.width - 12px;
        height: line-h;
        background: p.selected ? t.visor.with-alpha(0.12) : pick.has-hover ? t.visor.with-alpha(0.06) : transparent;
        pick := TouchArea {
            mouse-cursor: pointer;
            clicked => { AgentsApp.run-phase(root.r.key, i); }
        }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                StateMark { state: p.state; }
            }
            Text {
                horizontal-stretch: 0;
                text: i + 1;
                color: t.sub;
                font-family: Skin.font-mono;
                font-size: 11px * Skin.text-scale;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: p.title;
                color: p.state == "current" ? t.text : p.state == "todo" ? t.sub : t.text.mix(t.sub, 0.5);
                font-size: 12px * Skin.text-scale;
                font-weight: p.selected ? 700 : 400;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 0;
                text: p.count;
                color: p.state == "current" ? t.ok : t.sub;
                font-family: Skin.font-mono;
                font-size: 11px * Skin.text-scale;
                vertical-alignment: center;
            }
        }
    }
    // ...and the agents of the selected phase
    for g[i] in (r.open ? r.agents : []): HorizontalLayout {
        x: 18px;
        y: pad + (2 + r.phases.length + i) * line-h;
        width: parent.width - 24px;
        height: line-h;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            StateMark { state: g.state; }
        }
        Text {
            horizontal-stretch: 1;
            text: g.title;
            color: g.state == "working" ? t.text : t.sub;
            font-size: 12px * Skin.text-scale;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 0;
            max-width: root.width * 0.55;
            text: g.text;
            color: g.state == "working" ? t.ok : g.state == "stopped" ? t.warn : t.sub;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if r.open && r.more-agents > 0: Text {
        x: 18px;
        y: pad + (2 + r.phases.length + r.agents.length) * line-h;
        height: line-h;
        text: @tr("more agents: {}", r.more-agents);
        color: t.sub;
        font-family: Skin.font-mono;
        font-size: 11px * Skin.text-scale;
        vertical-alignment: center;
    }
}

component Row inherits Rectangle {
    in property <AgentRow> a;
    in property <int> index;
    in property <bool> narrow;
    // short cell: header only
    in property <bool> compact;
    property <Colors> t: AgentsApp.theme;
    property <color> ink: a.state == "waiting" ? t.warn : a.state == "working" ? t.ok : t.sub;
    property <bool> dim: a.state == "idle";
    // part heights follow the text size (never below the size at 100 %: the mascot fits)
    property <length> base: max(1, Skin.text-scale) * (narrow ? 50px : 56px);
    property <length> inset: a.sub ? 28px : 12px;
    property <length> face-w: narrow ? 32px : 40px;
    // the details start aligned with the title (in a narrow cell, with the mascot)
    property <length> text-x: narrow ? inset : inset + face-w + 12px;

    // heights of each part of the card (0 = the part is not shown)
    property <bool> has-chips: !compact && (a.model != "" || a.effort != "" || a.branch != "");
    property <bool> has-stats: !compact && (a.has-tokens || a.turn != "");
    property <bool> has-prompt: !compact && a.prompt != "";
    property <int> sub-lines: compact ? 0 : a.subs.length + (a.more-subs > 0 ? 1 : 0);
    property <length> chips-h: has-chips ? 26px * Skin.text-scale : 0;
    property <length> stats-h: has-stats ? 22px * Skin.text-scale : 0;
    property <length> prompt-h: has-prompt ? 20px * Skin.text-scale : 0;
    property <length> sub-h: 19px * Skin.text-scale;
    property <length> subs-h: sub-lines * sub-h + (sub-lines > 0 ? 4px : 0);
    // workflow runs: their lines, plus padding and a gap per run
    property <length> run-gap: 14px;
    property <length> runs-h: compact || a.runs.length == 0 ? 0 : a.run-lines * sub-h + a.runs.length * run-gap;
    property <length> details-h: chips-h + stats-h + prompt-h + subs-h + runs-h
        + (has-chips || has-stats || has-prompt || sub-lines > 0 || runs-h > 0 ? 8px : 0);
    // strip of working subagents (taller with the imported mascots, up to 32 px)
    property <length> walk-h: a.heroes.length > 0 ? 42px : a.walkers > 0 ? 30px : 0;
    property <length> options-h: a.open ? max(1, Skin.text-scale) * 46px : 0;

    height: base + details-h + walk-h + options-h;
    background: a.state == "waiting" ? t.warn.with-alpha(0.1) : a.open ? t.visor.with-alpha(0.08) : hover.has-hover ? t.visor.with-alpha(0.05) : transparent;

    // click on the card: opens or closes the options
    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { AgentsApp.toggle(root.a.key); }
    }

    Rectangle { y: parent.height - 1px; height: 1px; background: t.muted.with-alpha(0.35); }
    // state stripe on the left edge
    Rectangle { x: 0; width: 3px; background: a.state == "idle" ? transparent : ink; }

    // header: mascot, title, state
    HorizontalLayout {
        y: 0;
        height: base;
        padding-left: inset;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Image {
                source: a.mascot;
                image-rendering: pixelated;
                width: face-w;
                height: self.width * 14 / 16;
                opacity: dim ? 0.6 : 1;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            Text {
                text: a.title;
                color: dim ? t.sub.mix(t.text, 0.5) : t.text;
                font-size: 14px * Skin.text-scale;
                font-weight: dim ? 400 : 700;
                overflow: elide;
            }
            Text {
                text: a.info;
                color: t.sub;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                overflow: elide;
            }
        }

        Text {
            horizontal-stretch: 0;
            max-width: narrow ? 130px : 240px;
            text: a.state-text;
            color: ink;
            font-family: Skin.font-mono;
            font-size: 12px * Skin.text-scale;
            font-weight: dim ? 400 : 700;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // details: each part has a fixed height and goes away when the tool does not report it
    if details-h > 0: Rectangle {
        x: text-x;
        y: base - 2px;
        width: root.width - text-x - 12px;
        height: details-h;
        clip: true;
        opacity: dim ? 0.8 : 1;

        // chips: model, effort, branch
        if has-chips: HorizontalLayout {
            x: 0;
            y: 0;
            height: chips-h;
            alignment: start;
            spacing: 6px;
            padding-bottom: 6px;
            if a.model != "": Chip { text: a.model; ink: t.visor; }
            if a.effort != "": Chip { label: @tr("effort"); text: a.effort; ink: t.fur; }
            if a.branch != "": Chip { label: "branch"; text: a.branch; ink: t.ok; }
        }

        // numbers: session tokens and the last turn
        if has-stats: HorizontalLayout {
            x: 0;
            y: chips-h;
            height: stats-h;
            alignment: start;
            spacing: narrow ? 10px : 16px;
            if a.has-tokens: Stat { value: a.tok-in; label: narrow ? @tr("in") : @tr("input"); ink: t.text; }
            if a.has-tokens: Stat { value: a.tok-out; label: @tr("output"); ink: t.text; }
            if a.has-tokens: Stat { value: a.tok-cache; label: "cache"; ink: t.text; }
            if a.turn != "": Stat {
                value: a.turn;
                label: narrow || a.turn-note == "" ? @tr("last turn") : @tr("last turn · {}", a.turn-note);
                ink: t.visor;
            }
        }

        // last user prompt
        if has-prompt: HorizontalLayout {
            x: 0;
            y: chips-h + stats-h;
            width: parent.width;
            height: prompt-h;
            spacing: 6px;
            Rectangle {
                width: 2px;
                background: t.fur.with-alpha(0.6);
            }
            Text {
                horizontal-stretch: 1;
                text: a.prompt;
                color: t.sub.mix(t.text, 0.45);
                font-size: 12px * Skin.text-scale;
                font-italic: true;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // subagents: state dot, type, what it does and for how long
        for s[i] in a.subs: Rectangle {
          x: 0;
          y: chips-h + stats-h + prompt-h + 4px + i * sub-h;
          height: sub-h;
          width: parent.width;
          HorizontalLayout {
            property <color> dot: s.state == "working" ? t.ok : t.muted;
            padding-left: s.depth * 12px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle { width: 6px; height: 6px; background: dot; }
            }
            if s.kind != "": Text {
                horizontal-stretch: 0;
                text: s.kind;
                color: t.fur.mix(t.text, 0.6);
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: s.title;
                color: s.state == "working" ? t.text : t.sub;
                font-size: 12px * Skin.text-scale;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 0;
                text: s.state-text;
                color: s.state == "working" ? t.ok : t.sub;
                font-family: Skin.font-mono;
                font-size: 11px * Skin.text-scale;
                vertical-alignment: center;
            }
          }
          if s.key != "": Rectangle {
            accessible-role: button;
            accessible-label: s.title;
            accessible-action-default => { AgentsApp.details(s.key); }
            TouchArea {
              mouse-cursor: pointer;
              clicked => { AgentsApp.details(s.key); }
            }
          }
        }
        if !compact && a.more-subs > 0: Text {
            x: 12px;
            y: chips-h + stats-h + prompt-h + 4px + a.subs.length * sub-h;
            height: sub-h;
            text: @tr("more subagents: {}", a.more-subs);
            color: t.sub;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            vertical-alignment: center;
        }

        // workflow runs
        for r[i] in (compact ? [] : a.runs): RunBlock {
            r: r;
            line-h: sub-h;
            x: 0;
            y: chips-h + stats-h + prompt-h + subs-h + 4px + r.top * sub-h + i * run-gap;
            width: parent.width;
            height: r.lines * sub-h + 8px;
        }
    }

    // working subagents: each one walks back and forth, out of step.
    // With "reduce motion", they stand still, spread over the strip.
    if a.walkers > 0 || a.heroes.length > 0: Rectangle {
        x: inset;
        y: base + details-h - 2px;
        width: root.width - inset - 12px;
        height: walk-h;
        // the ground
        Rectangle { y: parent.height - 7px; height: 1px; background: t.ok.with-alpha(0.35); }
        // mascots that walk (PNG sprites and code mascots with `walk`): Rust picks the frame
        // and the place (src/mascot/stroll.rs, src/mascot/walkers.rs)
        for h in a.heroes: Image {
            source: h.frame;
            image-rendering: pixelated;
            // at the drawing size (crisp), up to 32 px tall; a small drawing (a 16×14 code
            // mascot) doubles, so it isn't a speck next to the others
            property <length> hero-h: h.frame.height <= 16 ? h.frame.height * 2px : min(32px, h.frame.height * 1px);
            height: hero-h;
            width: hero-h * h.frame.width / max(1, h.frame.height);
            x: h.x * (parent.width - self.width);
            y: parent.height - 8px - self.height;
            animate x { duration: 250ms; easing: linear; }
        }
        // tool mascot: steps from one end to the other; each one starts at a different point
        for k in (a.heroes.length > 0 ? 0 : a.walkers): Image {
            property <int> span: 14 + k * 3;
            property <int> step: mod(Anim.frame + k * 7, span * 2);
            property <float> pos: Anim.calm ? (k + 0.5) / a.walkers : (step < span ? step : span * 2 - step) / span;
            source: a.walker;
            image-rendering: pixelated;
            height: 22px * 14 / 16;
            width: 22px;
            x: pos * (parent.width - self.width);
            // little step: up and down every frame
            y: parent.height - 8px - self.height - (!Anim.calm && mod(Anim.frame + k, 2) == 0 ? 2px : 0);
            animate x { duration: 220ms; easing: linear; }
            animate y { duration: 110ms; easing: ease-out; }
        }
    }

    // options of the clicked card
    if a.open: HorizontalLayout {
        y: base + details-h + walk-h;
        height: options-h;
        padding-left: inset;
        padding-right: 12px;
        padding-bottom: 10px;
        spacing: 8px;
        alignment: start;
        TextButton {
            text: @tr("Details");
            icon: Icons.logs;
            ink: t.visor;
            font-size: 13px * Skin.text-scale;
            clicked => { AgentsApp.details(root.a.key); }
        }
        TextButton {
            text: narrow ? @tr("Folder") : @tr("Open folder");
            icon: Icons.grid;
            ink: t.visor;
            font-size: 13px * Skin.text-scale;
            clicked => { AgentsApp.open-dir(root.a.key); }
        }
        TextButton {
            text: narrow ? @tr("Terminal") : @tr("Terminal in folder");
            icon: Icons.terminal;
            ink: t.visor;
            font-size: 13px * Skin.text-scale;
            clicked => { AgentsApp.open-terminal(root.a.key); }
        }
        if a.can-resume: TextButton {
            text: narrow ? @tr("Resume") : @tr("Resume session");
            icon: Icons.play;
            ink: t.ok;
            font-size: 13px * Skin.text-scale;
            clicked => { AgentsApp.resume(root.a.key); }
        }
    }
}

export component AgentsView inherits Rectangle {
    // the pointer is over the app's card (the mascot perks up)
    in property <bool> hovered;
    property <Colors> t: AgentsApp.theme;
    property <bool> narrow: self.width < 520px;
    property <bool> short: self.height < 260px;
    property <length> mascot-w: short ? Skin.mascot-size * 2 / 3 : Skin.mascot-size;
    property <length> mascot-h: mascot-w * 14 / 16;

  VerticalLayout {
    spacing: 12px;

    // mascot + speech + counters
    HorizontalLayout {
        spacing: 16px;
        Rectangle {
            width: mascot-w + 8px;
            height: mascot-h + 8px;
            background: AgentsApp.waiting > 0 ? t.warn.with-alpha(0.16) : t.fur.with-alpha(0.1);
            Mascot {
                noticed: root.hovered;
                theme: t;
                frame: AgentsApp.mascot;
                mood: AgentsApp.mood;
                reaction: AgentsApp.reaction;
                poked => { AgentsApp.mascot-poked(); }
                width: parent.width - 8px;
                height: parent.height - 8px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: AgentsApp.speech;
                color: t.text;
                font-size: (short ? 15px : 19px) * Skin.text-scale;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: @tr("{} working · {} waiting for you · {} idle", AgentsApp.working, AgentsApp.waiting, AgentsApp.idle);
                color: t.sub;
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                wrap: word-wrap;
            }
            // a source that couldn't be read: below the counts, which stay
            if AgentsApp.error-text != "": Text {
                text: AgentsApp.error-text;
                color: t.warn.mix(t.text, 0.6);
                font-family: Skin.font-mono;
                font-size: 12px * Skin.text-scale;
                overflow: elide;
            }
        }
        if !narrow: HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Counter { theme: t; label: @tr("ACTIVE"); value: AgentsApp.working; tint: t.ok; }
            Counter { theme: t; label: @tr("WAITING"); value: AgentsApp.waiting; tint: t.warn; }
            Counter { theme: t; label: @tr("IDLE"); value: AgentsApp.idle; tint: t.visor; }
        }
    }

    // list
    Rectangle {
        vertical-stretch: 1;
        min-height: 50px;
        border-width: 1px;
        border-color: t.muted.with-alpha(0.45);
        background: t.bg1.mix(t.bg0, 0.6);

        if AgentsApp.rows.length == 0: Text {
            text: AgentsApp.missing ? @tr("Could not find Claude Code, Codex, OpenCode or OMP on this machine.") : @tr("No open or recent sessions.");
            color: t.sub;
            font-family: Skin.font-mono;
            font-size: 13px * Skin.text-scale;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        ListView {
            for a[i] in AgentsApp.rows: Row { a: a; index: i; narrow: narrow; compact: short; }
        }
    }
  }
}
