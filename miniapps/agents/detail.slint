// Detail window of an agent session: what it is doing, step by step (newest on top).
// Opened by the "Details" button of the card (src/apps/agents.rs), in a window outside
// the hub popup (it shows in the taskbar). Like the hub, it has no system frame: it draws
// the skin's one (`Frame`), drags by the header, resizes by the edges and closes with the
// header button or Esc. Globals belong to the window: Rust applies the skin (`Skin`) to it
// too. The header follows the skin; the content, the app theme (`AgentDetail.theme`), in a
// card like the panel ones.
import { ScrollView } from "std-widgets.slint";
import { Colors, Skin, Icons } from "../../ui/theme.slint";
import { TextButton, Icon, HeaderButton } from "../../ui/widgets.slint";
import { Bar, Frame, ResizeHandles } from "../../ui/frame.slint";

// One step of the conversation.
export struct AgentStep {
    // "14:32", or "11/17 23:50" for another day ("" = unknown)
    time: string,
    // "user" | "reply" | "tool" | "error"
    kind: string,
    text: string,
}

// Window state, filled in by Rust (src/apps/agents.rs).
export global AgentDetail {
    in property <Colors> theme;
    in property <string> title;
    // "Claude · ~/Projetos/x"
    in property <string> info;
    // "working" | "waiting" | "idle"
    in property <string> state;
    in property <string> state-text;
    in property <image> mascot;
    // "" = the tool does not report it (the chip goes away)
    in property <string> model;
    in property <string> effort;
    in property <string> branch;
    // "input 950 · output 45.3k · cache 1.2M"
    in property <string> tokens;
    in property <string> turn;
    // newest to oldest
    in property <[AgentStep]> steps;
    // some step is from another day: its time has the date, and the column is wider
    in property <bool> dated-steps;
    // the conversation has not been read yet
    in property <bool> loading;
    // the session left the list (closed or got too old)
    in property <bool> gone;
    in property <bool> can-resume;
    // Section 0: conversation; 1: saved result; 2: patch preview.
    in-out property <int> section;
    in property <string> result-text;
    in property <string> patch-text;
    in property <bool> result-truncated;
    in property <bool> patch-truncated;

    callback open-dir();
    callback open-terminal();
    callback resume();
    // own frame: close, drag by the header, resize by the `dir` edge
    callback close();
    callback start-move();
    callback start-resize(string);
}

// Chip: model, effort, branch.
component DetailChip inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <color> ink;
    property <Colors> t: AgentDetail.theme;
    height: 22px;
    width: row.preferred-width + 14px;
    horizontal-stretch: 0;
    border-width: 1px;
    border-color: ink.with-alpha(0.45);
    background: ink.with-alpha(0.12);
    row := HorizontalLayout {
        alignment: center;
        spacing: 5px;
        Text {
            text: root.label;
            color: t.sub;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: ink.mix(t.text, 0.55);
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// One timeline row: time, type mark and the text (which wraps).
component StepLine inherits Rectangle {
    in property <AgentStep> step;
    property <Colors> t: AgentDetail.theme;
    property <color> ink: step.kind == "user" ? t.visor : step.kind == "tool" ? t.sub : step.kind == "error" ? t.alarm : t.text;
    property <bool> mono: step.kind == "tool";
    accessible-role: text;
    accessible-label: step.time + " " + step.text;

    HorizontalLayout {
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 10px;
        Text {
            width: (AgentDetail.dated-steps ? 84px : 44px) * Skin.text-scale;
            text: step.time;
            color: t.sub;
            font-family: Skin.font-mono;
            font-size: 11px * Skin.text-scale;
            vertical-alignment: top;
        }
        // type mark: ">" prompt, terminal icon for a tool, "!" error, square for a reply
        Rectangle {
            width: 14px;
            if step.kind == "user": Text {
                y: 0;
                text: ">";
                color: t.visor;
                font-family: Skin.font-mono;
                font-size: 13px * Skin.text-scale;
                font-weight: 700;
            }
            if step.kind == "tool": Icon {
                y: 2px;
                icon: Icons.terminal;
                ink: t.sub;
                size: 13px;
            }
            if step.kind == "error": Text {
                y: 0;
                text: "!";
                color: t.alarm;
                font-family: Skin.font-mono;
                font-size: 13px * Skin.text-scale;
                font-weight: 700;
            }
            if step.kind == "reply": Rectangle {
                y: 5px;
                width: 6px;
                height: 6px;
                background: t.text;
            }
        }
        Text {
            text: step.text;
            color: ink;
            font-family: mono ? Skin.font-mono : Skin.font-ui;
            font-size: (mono ? 12px : 13px) * Skin.text-scale;
            font-weight: step.kind == "user" ? 600 : 400;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: t.muted.with-alpha(0.3);
    }
}

export component AgentDetailWindow inherits Window {
    property <Colors> t: AgentDetail.theme;
    property <color> state-ink: AgentDetail.gone ? t.sub
        : AgentDetail.state == "waiting" ? t.warn
        : AgentDetail.state == "working" ? t.ok : t.sub;
    title: AgentDetail.title == "" ? @tr("Agent") : AgentDetail.title;
    preferred-width: 560px;
    preferred-height: 680px;
    // the three buttons fit side by side (without switching the text by width: that would
    // feed back into the layout minimum width)
    min-width: 460px;
    min-height: 320px;
    no-frame: true;
    // transparent: the cut corners (chamfer) show what is behind
    background: transparent;
    default-font-family: Skin.font-ui;
    default-font-size: 13px * Skin.text-scale;

  FocusScope {
    init => { self.focus(); }
    key-pressed(e) => {
        if e.text == Key.Escape {
            AgentDetail.close();
            return accept;
        }
        reject
    }

    Frame { }

    VerticalLayout {
        padding: Skin.border;

        // header: tool mascot, title and where it is from; drags the window
        Bar {
            TouchArea {
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                        AgentDetail.start-move();
                    }
                }
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: AgentDetail.mascot;
                        image-rendering: pixelated;
                        width: 36px;
                        height: 36px * 14 / 16;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: AgentDetail.title;
                        color: Skin.panel-ink;
                        font-family: Skin.font-title;
                        font-size: 16px * Skin.text-scale;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: AgentDetail.info;
                        color: Skin.panel-sub;
                        font-size: 12px * Skin.text-scale;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    HeaderButton {
                        text: @tr("Close");
                        short: @tr("close");
                        icon: Icons.close;
                        px-icon: Icons.px-close;
                        clicked => { AgentDetail.close(); }
                    }
                }
            }
        }

        // content in the app theme, in a card away from the edge (does not cross the cut corner)
        Rectangle {
            vertical-stretch: 1;
          Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            background: t.bg0.mix(t.bg1, 0.75).with-alpha(Skin.card-alpha);
            border-width: 1px;
            border-color: t.muted.mix(t.bg0, 0.55);
            VerticalLayout {
                padding: 16px;
                padding-bottom: 12px;
                spacing: 10px;

                // state
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 10px; height: 10px; background: state-ink; }
                    }
                    Text {
                        text: AgentDetail.gone ? @tr("The session closed or got too old for the list.") : AgentDetail.state-text;
                        color: state-ink;
                        font-size: 14px * Skin.text-scale;
                        font-weight: 700;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }

                // chips and tokens (whatever the tool reports)
                if AgentDetail.model != "" || AgentDetail.effort != "" || AgentDetail.branch != "" || AgentDetail.turn != "": HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    if AgentDetail.model != "": DetailChip { label: @tr("model"); text: AgentDetail.model; ink: t.visor; }
                    if AgentDetail.effort != "": DetailChip { label: @tr("effort"); text: AgentDetail.effort; ink: t.fur; }
                    if AgentDetail.branch != "": DetailChip { label: "branch"; text: AgentDetail.branch; ink: t.sub; }
                    if AgentDetail.turn != "": DetailChip { label: @tr("last turn"); text: AgentDetail.turn; ink: t.sub; }
                }
                if AgentDetail.tokens != "": Text {
                    text: AgentDetail.tokens;
                    color: t.sub;
                    font-family: Skin.font-mono;
                    font-size: 12px * Skin.text-scale;
                    overflow: elide;
                }

                Rectangle { height: 1px; background: t.muted.with-alpha(0.5); }
                if AgentDetail.result-text != "" || AgentDetail.patch-text != "": HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    TextButton {
                        text: @tr("Conversation");
                        ink: AgentDetail.section == 0 ? t.visor : t.sub;
                        font-size: 13px * Skin.text-scale;
                        clicked => { AgentDetail.section = 0; }
                    }
                    if AgentDetail.result-text != "": TextButton {
                        text: @tr("Saved result");
                        ink: AgentDetail.section == 1 ? t.visor : t.sub;
                        font-size: 13px * Skin.text-scale;
                        clicked => { AgentDetail.section = 1; }
                    }
                    if AgentDetail.patch-text != "": TextButton {
                        text: @tr("Patch");
                        ink: AgentDetail.section == 2 ? t.visor : t.sub;
                        font-size: 13px * Skin.text-scale;
                        clicked => { AgentDetail.section = 2; }
                    }
                }
                if AgentDetail.section == 0: Text {
                    text: @tr("WHAT IT IS DOING");
                    color: t.sub;
                    font-family: Skin.font-mono;
                    font-size: 11px * Skin.text-scale;
                    letter-spacing: 1.5px;
                }

                // steps, newest on top
                if AgentDetail.section == 0: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding-right: 8px;
                        for s in AgentDetail.steps: StepLine { step: s; }
                        if AgentDetail.steps.length == 0: Text {
                            text: AgentDetail.loading ? @tr("Reading the conversation…") : @tr("Nothing to show for this session.");
                            color: t.sub;
                            font-size: 13px * Skin.text-scale;
                            wrap: word-wrap;
                        }
                    }
                }

                if AgentDetail.section != 0: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding-right: 8px;
                        spacing: 8px;
                        if AgentDetail.section == 1 ? AgentDetail.result-truncated : AgentDetail.patch-truncated: Text {
                            text: @tr("Preview limited to the first 64 KiB.");
                            color: t.warn;
                            font-size: 12px * Skin.text-scale;
                            wrap: word-wrap;
                        }
                        Text {
                            text: AgentDetail.section == 1 ? AgentDetail.result-text : AgentDetail.patch-text;
                            color: t.text;
                            font-family: Skin.font-mono;
                            font-size: 12px * Skin.text-scale;
                            wrap: char-wrap;
                        }
                    }
                }

                // actions (the same as on the card); a session that is gone has none
                if !AgentDetail.gone: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    TextButton {
                        text: @tr("Open folder");
                        icon: Icons.grid;
                        ink: t.visor;
                        font-size: 13px * Skin.text-scale;
                        clicked => { AgentDetail.open-dir(); }
                    }
                    TextButton {
                        text: @tr("Terminal in folder");
                        icon: Icons.terminal;
                        ink: t.visor;
                        font-size: 13px * Skin.text-scale;
                        clicked => { AgentDetail.open-terminal(); }
                    }
                    if AgentDetail.can-resume: TextButton {
                        text: @tr("Resume session");
                        icon: Icons.play;
                        ink: t.ok;
                        font-size: 13px * Skin.text-scale;
                        clicked => { AgentDetail.resume(); }
                    }
                }
            }
          }
        }
    }

    ResizeHandles {
        start(dir) => { AgentDetail.start-resize(dir); }
    }
  }
}
