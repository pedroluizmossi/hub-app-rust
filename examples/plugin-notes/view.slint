// View of the "Notes" plugin. The host fills theme, mascot and mood; the script (main.rhai)
// fills the rest with ui("property", value). Texts use @tr("…"): the hub translates them from
// i18n/<language>.po when it loads the view.
import { Theme } from "miniutils.slint";

export struct Note {
    id: string,
    text: string,
    done: bool,
    // seconds since the note was created
    age: int,
}

component Button inherits Rectangle {
    in property <Theme> theme;
    in property <string> label;
    callback clicked;
    width: max(28px, txt.preferred-width + 14px);
    height: 24px;
    background: touch.has-hover ? theme.fur.with-alpha(0.2) : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? theme.fur : theme.muted;
    txt := Text { text: label; color: theme.text; font-size: 11px * theme.text-scale; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component Main inherits Rectangle {
    in property <Theme> theme;
    in property <image> mascot;
    in property <string> mood;
    // counts from the script; total stays -1 until the first reading
    in property <int> total: -1;
    in property <int> todo;
    in property <int> done;
    in property <[Note]> rows;
    callback action(string, string);

    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Image { source: mascot; width: 48px; height: 42px; image-rendering: pixelated; image-fit: contain; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: @tr("Notes"); color: theme.text; font-family: theme.font-title; font-size: 16px * theme.text-scale; font-weight: 700; }
                Text {
                    text: total < 0 ? @tr("opening…") : total == 0 ? @tr("no notes") : @tr("{} to do · {} done", todo, done);
                    color: theme.sub;
                    font-size: 12px * theme.text-scale;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Button { theme: theme; label: @tr("Clear done"); clicked => { root.action("clean", ""); } }
            }
        }

        // field for a new note: Enter saves it
        Rectangle {
            height: 30px;
            background: theme.bg0;
            border-width: 1px;
            border-color: input.has-focus ? theme.fur : theme.muted;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Rectangle {
                    if input.text == "": Text {
                        text: @tr("new note… (Enter saves)");
                        color: theme.muted;
                        font-size: 12px * theme.text-scale;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    input := TextInput {
                        color: theme.text;
                        font-size: 12px * theme.text-scale;
                        vertical-alignment: center;
                        single-line: true;
                        accessible-label: @tr("New note");
                        accepted => {
                            root.action("add", self.text);
                            self.text = "";
                        }
                    }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: max(self.height, list.preferred-height);
            list := VerticalLayout {
                alignment: start;
                spacing: 2px;
                for n in rows: Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        spacing: 8px;
                        // check box: done or not
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-width: 1px;
                                border-color: n.done ? theme.ok : theme.muted;
                                background: n.done ? theme.ok.with-alpha(0.5) : transparent;
                                TouchArea { clicked => { root.action("toggle", n.id); } }
                            }
                        }
                        Text {
                            text: n.text;
                            color: n.done ? theme.muted : theme.text;
                            font-size: 13px * theme.text-scale;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // "now", "5 min ago", "3 h ago", "2 d ago"
                        Text {
                            text: n.age < 60 ? @tr("now")
                                : n.age < 3600 ? @tr("{} min ago", floor(n.age / 60))
                                : n.age < 86400 ? @tr("{} h ago", floor(n.age / 3600))
                                : @tr("{} d ago", floor(n.age / 86400));
                            color: theme.muted;
                            font-size: 11px * theme.text-scale;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Button { theme: theme; label: "×"; clicked => { root.action("del", n.id); } }
                        }
                    }
                }
            }
        }
    }
}
