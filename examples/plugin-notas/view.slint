// Tela do plugin "Notas". O host preenche theme, mascot e mood; o script (main.rhai)
// preenche o resto com ui("propriedade", valor).
import { Theme } from "miniutils.slint";

export struct Nota {
    id: string,
    texto: string,
    feita: bool,
    quando: string,
}

component Button inherits Rectangle {
    in property <Theme> theme;
    in property <string> label;
    callback clicked;
    width: max(28px, txt.preferred-width + 14px);
    height: 24px;
    background: touch.has-hover ? theme.fur.with-alpha(0.2) : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? theme.fur : theme.muted;
    txt := Text { text: label; color: theme.text; font-size: 11px * theme.text-scale; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component Main inherits Rectangle {
    in property <Theme> theme;
    in property <image> mascot;
    in property <string> mood;
    in property <string> subtitle: "abrindo…";
    in property <[Nota]> rows;
    callback action(string, string);

    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Image { source: mascot; width: 48px; height: 42px; image-rendering: pixelated; image-fit: contain; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: "Notas"; color: theme.text; font-family: theme.font-title; font-size: 16px * theme.text-scale; font-weight: 700; }
                Text { text: subtitle; color: theme.sub; font-size: 12px * theme.text-scale; overflow: elide; }
            }
            VerticalLayout {
                alignment: center;
                Button { theme: theme; label: "Limpar feitas"; clicked => { root.action("clean", ""); } }
            }
        }

        // campo da nota nova: Enter guarda
        Rectangle {
            height: 30px;
            background: theme.bg0;
            border-width: 1px;
            border-color: input.has-focus ? theme.fur : theme.muted;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Rectangle {
                    if input.text == "": Text {
                        text: "nova nota… (Enter guarda)";
                        color: theme.muted;
                        font-size: 12px * theme.text-scale;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    input := TextInput {
                        color: theme.text;
                        font-size: 12px * theme.text-scale;
                        vertical-alignment: center;
                        single-line: true;
                        accessible-label: "Nova nota";
                        accepted => {
                            root.action("add", self.text);
                            self.text = "";
                        }
                    }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: max(self.height, list.preferred-height);
            list := VerticalLayout {
                alignment: start;
                spacing: 2px;
                for n in rows: Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        spacing: 8px;
                        // quadradinho: feita ou não
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-width: 1px;
                                border-color: n.feita ? theme.ok : theme.muted;
                                background: n.feita ? theme.ok.with-alpha(0.5) : transparent;
                                TouchArea { clicked => { root.action("toggle", n.id); } }
                            }
                        }
                        Text {
                            text: n.texto;
                            color: n.feita ? theme.muted : theme.text;
                            font-size: 13px * theme.text-scale;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text { text: n.quando; color: theme.muted; font-size: 11px * theme.text-scale; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Button { theme: theme; label: "×"; clicked => { root.action("del", n.id); } }
                        }
                    }
                }
            }
        }
    }
}
