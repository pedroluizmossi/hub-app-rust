msgstr "{} importados · {} ignorados"

msgid "{}: no sheet named like Name_Animation_N.png (at least two animations)"
msgstr "{}: nenhuma folha no formato Nome_Animação_N.png (pelo menos duas animações)"

# Sprites from files (src/mascot/file.rs)
msgid "grid: {} rows, expected 14"
msgstr "grid: {} linhas, esperava 14"

msgid "grid: row {} has {} characters, expected 16"
msgstr "grid: a linha {} tem {} caracteres, esperava 16"

msgid "grid: row {}: '{}' is not a color role (. K P S H M C E W B T F D A)"
msgstr "grid: linha {}: '{}' não é um papel de cor (. K P S H M C E W B T F D A)"

msgid "grid: row {}: the letter '{}' has no color in [palette]"
