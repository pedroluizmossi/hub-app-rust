msgid "grid: no eye ({} in this mascot)"
msgstr "grid: sem olho ({} nesta mascote)"

msgid "eye_bg: one color of this mascot (a role, or a letter of [palette])"
msgstr "eye_bg: uma cor desta mascote (um papel, ou uma letra de [palette])"

msgid "fur and ear only apply to a mascot by color roles (without [palette])"
msgstr "fur e ear só valem para mascote por papéis de cor (sem [palette])"

msgid "[palette]: \"{}\" is not a lowercase letter (e is the eye)"
msgstr "[palette]: \"{}\" não é uma letra minúscula (e é o olho)"

