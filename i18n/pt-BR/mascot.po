# ---- imported mascots (src/mascot/pack.rs) ----

msgid "the folder name becomes the mascot's key: use only lowercase letters, digits and hyphens (up to 32)"
msgstr "o nome da pasta vira a chave da mascote: use só minúsculas, números e hífen (até 32)"

msgid "\"{}\" is already a built-in mascot; rename the folder"
msgstr "\"{}\" já é uma mascote embutida; renomeie a pasta"

msgid "no animations (no sprite.toml, and no PNG named like Name_Animation_N.png)"
msgstr "nenhuma animação (nem sprite.toml, nem PNG no formato Nome_Animação_N.png)"

msgid "too many animations ({}; up to {})"
msgstr "animações demais ({}; até {})"

msgid "facing = \"{}\": use \"right\" or \"left\""
msgstr "facing = \"{}\": use \"right\" ou \"left\""

msgid "{} = \"{}\": there is no such animation"
msgstr "{} = \"{}\": não há essa animação"

msgid "[moods] unknown mood: {}"
msgstr "[moods] humor desconhecido: {}"

msgid "[reactions] unknown reaction: {}"
msgstr "[reactions] reação desconhecida: {}"

msgid "[anim] {}: \"{}\" must be a file in this folder"
msgstr "[anim] {}: \"{}\" tem de ser um arquivo desta pasta"

msgid "{}: {}×{} doesn't split into {} equal frames (up to {})"
msgstr "{}: {}×{} não se divide em {} quadros iguais (até {})"

msgid "{}: {}×{} frame; the maximum is {}×{}"
msgstr "{}: quadro de {}×{}; o máximo é {}×{}"

msgid "{}: {}×{} frame, but the other animations are {}×{}"
msgstr "{}: quadro de {}×{}, mas as outras animações são {}×{}"

msgid "[anim] {}: fps {} (use 1 to 30)"
msgstr "[anim] {}: fps {} (use de 1 a 30)"

msgid "the frames are all transparent"
msgstr "os quadros são todos transparentes"

msgid "{}: {} KiB; the maximum is {} KiB"
msgstr "{}: {} KiB; o máximo é {} KiB"

msgid "{}: {}×{} is too large"
msgstr "{}: {}×{} é grande demais"

msgid "{}: too large"
msgstr "{}: grande demais"

msgid "{}: indexed PNG not converted"
msgstr "{}: PNG indexado não convertido"

msgid "{}: already exists in {} (delete the folder to import it again)"
msgstr "{}: já existe em {} (apague a pasta para importar de novo)"

msgid "{}: {} ({} animations, {}×{} frame after trimming)"
msgstr "{}: {} ({} animações, quadro {}×{} depois de aparar)"

