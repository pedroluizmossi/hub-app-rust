# Command line: --help, --dirs, --import-mascot, --plugin-dev (src/main.rs)
msgid "usage:"
msgstr "uso:"

msgid "miniutils [--hidden] [--toggle] [--tab <name>] [--plugin-dev <folder>]"
msgstr "miniutils [--hidden] [--toggle] [--tab <nome>] [--plugin-dev <pasta>]"

msgid "miniutils --import-mascot <folder>"
msgstr "miniutils --import-mascot <pasta>"

msgid "starts in the tray only (for autostart)"
msgstr "inicia só na bandeja (para o autostart)"

msgid "hides the window if it is open, shows it otherwise (for a\nkeyboard shortcut); with --tab, shows it on that page"
msgstr "esconde a janela se estiver aberta, senão mostra (para um\natalho de teclado); com --tab, mostra naquela página"

msgid "--tab <name>"
msgstr "--tab <nome>"

msgid "opens on a panel page (by its name or the name of an app on it,\ne.g. General, docker), on apps (settings) or on store"
msgstr "abre numa página do painel (pelo nome dela ou de um app nela,\nex.: Geral, docker), em apps (configurações) ou em store (loja)"

msgid "--plugin-dev <folder>"
msgstr "--plugin-dev <pasta>"

msgid "loads the plugin in the folder (enabled, on the 1st page) and reloads it\non save; view and script errors go to the terminal. Repeat it to load\nseveral folders"
msgstr "carrega o plugin da pasta (ligado, na 1ª página) e recarrega ao\nsalvar; erros da tela e do script saem no terminal. Repita para carregar\nvárias pastas"

msgid "copies the PNG sheets (Name_Animation_N.png) in the folder and its\nsubfolders to the mascots folder, one mascot per character"
msgstr "copia as folhas PNG (Nome_Animação_N.png) da pasta e das\nsubpastas para a pasta de mascotes, uma mascote por personagem"

msgid "where the local apps, the themes/skins/backdrops/mascots,\nthe configuration and the logs are"
msgstr "onde ficam os apps locais, os themes/skins/backdrops/mascots,\na configuração e os registros"

msgid "shows the version (also in Settings › System)"
msgstr "mostra a versão (também em Configurações › Sistema)"

msgid "(no folder)"
msgstr "(sem pasta)"

msgid "local apps:"
msgstr "apps locais:"

msgid "(one app per folder, named after the id in manifest.toml)"
msgstr "(um app por pasta, com o nome do id do manifest.toml)"

msgid "app data:"
msgstr "dados dos apps:"

msgid "(one folder per app: what it stores; see [data] in APPS.md)"
msgstr "(uma pasta por app: o que ele guarda; ver [data] no APPS.md)"

msgid "appearance:"
msgstr "aparência:"

msgid "({}/, {}/ and {}/, one .toml each, examples in the repository;\n{}/, one folder of PNG sheets per mascot: --import-mascot)"
msgstr "({}/, {}/ e {}/, um .toml cada, exemplos no repositório;\n{}/, uma pasta de folhas PNG por mascote: --import-mascot)"

msgid "configuration:"
msgstr "configuração:"

msgid "logs:"
msgstr "registros:"

msgid "--import-mascot <folder>: missing the folder with the PNG sheets"
msgstr "--import-mascot <pasta>: falta a pasta com as folhas PNG"

msgid "in {}"
msgstr "em {}"

msgid "MiniUtils reloaded the mascots"
msgstr "O MiniUtils aberto recarregou as mascotes"

msgid "--tab <name>: missing the page name"
msgstr "--tab <nome>: falta o nome da página"

msgid "unknown option: {} (see miniutils --help)"
msgstr "opção desconhecida: {} (veja miniutils --help)"

msgid "only one of --dirs, --quit, --import-mascot and --check-mascot at a time"
msgstr "use só um de --dirs, --quit, --import-mascot e --check-mascot por vez"

msgid "MiniUtils is not open"
msgstr "O MiniUtils não está aberto"

msgid "closes the running MiniUtils as Quit in the tray menu does (the window\nand the configuration are saved); used by the installers"
msgstr "fecha o MiniUtils aberto como o Sair do menu da bandeja (a janela e a\nconfiguração são salvas); usado pelos instaladores"

msgid "--plugin-dev <folder>: missing the plugin folder"
msgstr "--plugin-dev <pasta>: falta a pasta do plugin"

msgid "--plugin-dev: close the MiniUtils that is already open (the plugin under development runs in an instance of its own)"
msgstr "--plugin-dev: feche o MiniUtils que já está aberto (o plugin em desenvolvimento roda numa instância só dele)"

# Config file notices (src/core/config.rs)
msgid "config.toml is from a newer MiniUtils: changes made here won't be saved."
msgstr "O config.toml é de um MiniUtils mais novo: as mudanças feitas aqui não serão salvas."

msgid "config.toml could not be read, so the defaults are in use. It is set aside as config.toml.broken on the next save."
msgstr "Não deu para ler o config.toml, então o padrão está em uso. Ele é guardado como config.toml.broken no próximo salvamento."

